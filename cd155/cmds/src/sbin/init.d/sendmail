PATH=/sbin:/usr/sbin:/usr/bin
export PATH

case "$1" in
'start')
        set `who -r`
        if [ $9 = "S" ]; then
                [ -f /usr/sbin/sendmail ] && {
                	(cd /usr/spool/mqueue; rm -f lf*)
	                /usr/sbin/sendmail -bd -q15m -om &
                        echo "SMTP Mail Service started"
                }
        fi
        ;;
'stop')
	pid=`/bin/ps -e | grep sendmail | grep -v grep | sed -e 's/^  *//' -e 's/ .*//' | head -1`
	if [ "X$pid" != "X" ]
	then
		/bin/kill $pid
	fi
	;;
*)
        echo "usage: $0 {start|stop}"
        ;;
esac
