# Start Arpa services
#

PATH=/sbin:/usr/sbin:/usr/bin
export PATH
ARGTWO="$2"

case "$1" in
'start')
        set `who -r`
        if [ "$ARGTWO" = "force" -o $9 = "S" ]; then
                if /usr/sbin/inetd; then
	                echo "Internet services provided."
                else
                        echo "Unable to provide Internet services"
                fi
        fi
        ;;
'stop')
	pid=`/bin/ps -e | grep /usr/sbin/inetd | grep -v grep | sed -e 's/^  *//' -e 's/ .*//' | head -1`
	if [ "X$pid" != "X" ]
	then
		/bin/kill $pid
	fi
	;;
*)
        echo "usage: $0 {start|stop}"
        ;;
esac

