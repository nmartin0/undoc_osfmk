PATH=/sbin:/usr/sbin:/usr/bin
export PATH

case "$1" in
'start')
	rm -f /tmp/t1
	/usr/bin/strings /mach_servers/startup | grep 'OSF/1 Release' >/tmp/t1
        if [ -s /tmp/t1 ]; then
		sed -e '1s;^OSF/1 Release ;&;' -e tx -e b -e :x -e d /etc/motd >>/tmp/t1
        	cp /tmp/t1 /etc/motd
        fi
        rm -f /tmp/t1
        ;;
'stop')
        ;;
esac
