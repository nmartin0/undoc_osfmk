#
# Control login access
#

PATH=/sbin:/usr/sbin:/usr/bin
export PATH

case "$1" in
'start')
        set `who -r`
        if [ $9 = "S" ]; then
                /sbin/rm -f /etc/nologin
                echo "Logins enabled"
        fi
        ;;
'stop')
        >/etc/nologin
        echo "Logins disabled"
        ;;
*)
        echo "usage: $0 {start|stop}"
        ;;
esac

