trap "" 2 3

export LOGNAME TERM

. /etc/TIMEZONE

PATH=/usr/bin:/bin:/usr/sbin:/sbin

# Login and -su shell get /etc/profile services.
# -rsh is given its environment in its .profile.
case "$0" in
-su )
        export PATH
        ;;
-sh )
        export PATH
        ;;
-ksh )
        export PATH
        ;;
esac

umask 022
trap 2 3

