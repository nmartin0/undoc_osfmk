#
# DISPLAYTYPE={none,mono,color} type of monitor
# HOSTNAME={unknown}  the Internet name of your system
# HOSTID={130.105.255.255}  Internet address in dot format of your system
# NETMASK={network netmask} - default: 255.255.255.0
# NETDEV={em0} - mmax=em0
# PAGEFILE={/paging/space, other}  the name of the paging file
# PARTITION={rz[0-6]b} the paging partition if PAGEFILE=/paging/space
# PARTITIONTYPE={scsi,raid5,...} disk type containing the paging partition
# PAGEMINSZ={16M,32M}  low-water point for paging file - default: 16M
# PAGEMAXSZ={32M,34M}  high-water point for paging file - default: 44M
# TZ={PST8PDT}  locale timezone info - default: PST8PDT
#
DISPLAYTYPE=none
HOSTNAME=newsys
HOSTID=137.46.0.0
NETMASK=255.255.255.0
NETDEV=em0
GATEWAY=137.46.201.118
PAGEFILE=/paging/space
PAGEFILE=/home/vnode_paging_file
PARTITION=rz0b
PARTITIONTYPE=scsi
PAGEMINSZ=16M
PAGEMAXSZ=34M
PAGEMINSZ2=2M
PAGEMAXSZ2=200M
TZ=PST8PDT
export DISPLAYTYPE HOSTNAME HOSTID NETMASK NETDEV TZ
export PAGEFILE PARTITION PARTITIONTYPE PAGEMINSZ PAGEMAXSZ PAGEMINSZ2 PAGEMAXSZ2
