MIG3_DEFS		= machid.defs machid_debug.defs \
			  netmemory.defs netname.defs service.defs

INCDIRS			=  ${INC3DIRS}
INCFLAGS		= -I..
DATAFILES		= machid_types.defs machid_types.h netname_defs.h \
			  ${MIG3_DEFS}

INCLUDES		= ${DATAFILES}
MIGINCLUDES		= ${_MIG3_HDRS_}

ILIST			= ${INCLUDES} ${MIGINCLUDES}
IDIR			= /usr/mach3/include/servers/
IMODE			= 644

include ${MAKEFILEPATH}/standard.mk
include ${MAKEFILEPATH}/datafiles.mk
include ${MAKEFILEPATH}/objects.mk

# Temporary hack to allow the compilation of mach_servers against a
# vanilla CMU micro-kernel source tree (not complying to the ODE architecture).
# Our user headers aren't compatible with CMU kernels, so just don't build
# them...
.INIT:
	@if [ "${ODE_CMU_COMPAT}" ]; then \
		echo "***** CMU compatibility mode: ${MAKEDIR} not built"; \
		for target in ${ILIST}; do \
			if [ ! -f $${target} ]; then \
				echo "touch $${target}"; \
				touch $${target}; \
			fi; \
		done; \
	fi;
