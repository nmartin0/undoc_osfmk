$set MS_TRPT

$quote "

TRPT_USAGE	"usage: trpt [-afjst] [-p hex-address] [system [core]]\n"
TRPT_NONAME	"trpt: %s: no namelist\n"
TRPT_STR_X	"%x"
TRPT_SRC	"(src=%s,%u, "
TRPT_DST	"dst=%s,%u)"
TRPT_WIN	"(win=%x)"
TRPT_ARROW	">"
TRPT_NEWLINE	"\n"
TRPT_SFLAG1	"\trcv_nxt %lx rcv_wnd %x snd_una %lx snd_nxt %lx snd_max %lx\n"
TRPT_SFLAG2	"\tsnd_wl1 %lx snd_wl2 %lx snd_wnd %x\n"
TRPT_RXTSHFT	" (t_rxtshft=%d)"
TRPT_FMT1	"\n%x:\n"
TRPT_FMT2	"%03ld %s:%s "
TRPT_FMT3	"[%lx..%lx)"
TRPT_FMT4	"%lx"
TRPT_FMT5	"%s%s"
TRPT_FMT6	"%s"
TRPT_FMT7	"<%s>"
TRPT_FMT8	"%s%s=%d"
TRPT_FMT9	"@%lx"
TRPT_FMT10	" -> %s"
