clean:
	${AT}path=`which ${FC}` ;	\
	if [ -x $$path ] ;		\
	then				\
	  remove=TRUE ;			\
	else				\
	  remove=FALSE ;		\
	fi ;				\
	for file in ${SRCS} ;		\
	do				\
	  if [ ! -r $$file ] ;		\
	  then				\
	    remove=FALSE ;		\
	  fi ;				\
	done ;				\
	if [ $$remove = TRUE ] ;	\
	then				\
	  rm -f ${OBJS} ${EXEC} ;	\
	fi
