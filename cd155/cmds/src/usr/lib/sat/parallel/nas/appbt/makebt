	${AT}${FCVECT} jacy2.f 

jacz2.o:	jacz2.f
	${AT}${FCVECT} jacz2.f 

l2norm.o:	l2norm.f
	${AT}${FCVECT} l2norm.f 

pintgr.o:	pintgr.f
	${AT}${FCVECT} pintgr.f 

rhs.o:		rhs.f
	${AT}${FCVECT} rhs.f 

