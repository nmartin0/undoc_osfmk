#SUBDIRS			= setup

PROGRAMS		= macd ports db app app_misc job smd_req job_misc \
			  upd log

ILIST			= macd ports db app app_misc job smd_req \
                	  job_misc upd log

IDIR			= /usr/lib/macs/
IOWNER			= root

macd_IMODE		=  555

INCFLAGS		= -I../../include -I../../include/macs 
MACSCFLAGS		= $(DBG) -DSMD_IP -DIPSC -DINTELv1r1
CFLAGS			= ${MACSCFLAGS} ${${TARGET_MACHINE}CFLAGS}
#LIBS			= -lnx -lmach
MACS_LIBS		= ../../ccs/lib/libmacs/libmac.a \
			  ../../ccs/lib/libmacs/librin.a


macd_OFILES		= macd.o ports.o db.o app.o app_misc.o job.o smd_req.o \
                	  job_misc.o upd.o log.o $(MACS_LIBS)


include ${MAKEFILEPATH}/standard.mk
include ${MAKEFILEPATH}/programs.mk
include ${MAKEFILEPATH}/objects.mk
include ${MAKEFILEPATH}/subdirs.mk
