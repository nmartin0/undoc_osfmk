$set MS_WHOIS

$quote "

HOST	 	"whois: %s: "
SOCKET	 	"whois: socket"
BIND	 	"whois: bind"
UNKSERVICE	 "whois: whois/tcp: unknown service\n"
CONNECT	 	"whois: connect"
FDOPEN	 	"fdopen"
USAGE	 	"usage: whois [-h host] name\n"
