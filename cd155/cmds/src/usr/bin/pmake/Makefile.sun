###########################################################################

# Name under which to install pmake (only for install target).
instname = 	pmake

# Directory to install pmake in (only for install target).
bindir = 	$(INSTBINDIR)

# Install make setgid to this group so it can read /dev/kmem.
group = kmem

###########################################################################

AR =		ar rv
CC =		cc
LD =		ld
STRIP =		strip
RM =		rm -f
CHGRP = 	chgrp
CHMOD = 	chmod
CHOWN = 	chown
DEPEND =	makedepend
RANLIB =	ranlib

DEFINES = 	-D_MACHINE_=\"SUN4\" -D_machine_=\"sun4\"     \
          	-D_CPUTYPE_=\"SPARC\" -D_cputype_=\"sparc\"   \
          	-DPMAKE -DV8REGEXP

INCLUDES = 	-I/usr/include

CPPFLAGS =
CFLAGS = 	$(DEFINES) $(INCLUDES)
LDFLAGS = 	
#LINK.c = 	$(CC) $(CFLAGS) $(CPPFLAGS) $(LDFLAGS)

GLOBLIB =	glob/libglob.a
LOADLIBS = 	

objs = commands.o default.o dir.o expand.o file.o function.o implicit.o \
       job.o load.o misc.o main.o makeconf.o nx.o read.o regexp.o regsub.o \
       remake.o remote.o rule.o variable.o vpath.o version.o \
       arscan.o ar.o
srcs = commands.c job.c dir.c file.c load.c misc.c main.c makeconf.c nx.c \
       read.c remake.c remote.c rule.c implicit.c default.c variable.c \
       expand.c function.c vpath.c version.c regexp.c regsub.c \
       arscan.c ar.c  

VPATH =

.SUFFIXES:
.SUFFIXES: 	.o .c .s .h .ps .dvi .texinfo

all: 		compile  

compile: 	pmakesun

pmakesun: 	$(objs) $(GLOBLIB)
		$(CC) $(LDFLAGS) $(objs) $(GLOBLIB) $(LOADLIBS) -o pmakesun

$(GLOBLIB): 	force
		cd glob; \
		$(MAKE) CC='$(CC)' CFLAGS='$(CFLAGS) -I..' AR='$(AR)' \
		RANLIB='$(RANLIB)' -f Makefile.sun libglob.a
force:

tags: 		$(srcs)
		ctags -tw $(srcs)

install: 	pmakesun $(bindir)/$(instname)

exports:

$(bindir)/$(instname): pmakesun
		$(RM) $(bindir)/$(instname)
		$(CP) pmakesun $(bindir)/$(instname)
		$(STRIP) $(bindir)/$(instname)
		$(CHMOD) 755 $(bindir)/$(instname)
		@echo $(CHGRP) $(group) $(bindir)/$(instname)
		@echo $(CHOWN) bin $(bindir)/$(instname)

clean: 		glob-clean
		-rm -f pmakesun *.o core

glob-clean:
		cd glob; $(MAKE) -f Makefile.sun $@

depend:
		$(DEPEND) $(INCLUDES) $(srcs)
# DO NOT DELETE THIS LINE -- make depend depends on it.
