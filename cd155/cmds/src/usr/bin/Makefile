SEC_SUBDIRS		= at binmail chgrp chown cpio date ex finger \
			  from hostname ipcs kill mesg mt \
			  nice ps tar w
NX_SUBDIRS		= mkpart lspart showpart rmpart pspart chpart sat
PFS_SUBDIRS		= lsize showfs
NQS_SUBDIRS		= nmapmgr qcmplx qdel qdev qlimit qmgr qpr qstart \
			  qstat qsub
MACS_SUBDIRS		= acctrep jrec macalloc maclist arep
PARACORE_SUBDIRS	= coreinfo

SUBDIRS			= ${SEC_SUBDIRS} ${NX_SUBDIRS} ${PFS_SUBDIRS} \
			  ${NQS_SUBDIRS} ${MACS_SUBDIRS} ${PARACORE_SUBDIRS} \
			  Mail apply awk banner basename bc bdiff \
			  bfs biff cal calendar cat checkeq checknr \
			  chmod clear cmp col colcrt colrm comm compress \
			  cp csh csplit ctab cut \
			  dc dd deroff df diction diff diff3 diffmk \
			  dircmp dirname du echo ed env eqn expand \
			  explain expr false file find fold fsplit ftp getopt \
			  grep groups head help iconv id install \
			  iostat ipcrm join ksh \
			  last lastcomm learn leave libloc \
			  line ln logger logname look ls machine \
			  man mkdep mkdir more msg msgs mv nawk neqn news \
			  nfsstat nl nohup nroff nslookup ntp od pack pagesize \
			  paste pcat pg pmake pr ptx pwd rcp rdist rev rlogin \
			  rm rmail rsh ruptime rwho sccs script sdiff \
			  sed sh showmount sleep soelim sort spell \
			  spellin split stty style sum tabs tail \
			  talk tcopy tee telnet test tftp tic time \
			  tip touch top tput tr trbsd troff true tset tty \
			  ul uname unexpand unifdef uniq units unpack \
			  users uudecode uuencode vacation vgrind \
			  vmstat vm_stat wc whereis which who whoami whois \
			  window write xargs xmkcatdefs xsend yes mksysfile
# notyet - graph xgencat vmstat

include ${MAKEFILEPATH}/standard.mk
include ${MAKEFILEPATH}/subdirs.mk
