$quote "
$		GLOBAL COMMENT FOR TRANSLATORS
$ Do not translate uniq -- this is the command name.
$ Do not translate %s.
$set MS_UNIQ
$
ILLOPT "uniq: The -%s flag is not correct.\n\
\tUsage: uniq [-c] [-d] [-u] [-Number] [+Number] [InFile [OutFile]].\n"
$
OPERR "uniq: Cannot open %s.\n"
$
CRERR "uniq: Cannot create %s.\n"
