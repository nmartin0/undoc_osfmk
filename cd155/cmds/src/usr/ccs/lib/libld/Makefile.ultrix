INC_DIRS= /usr/include
INC_FILE= stdio.h assert.h
HDRS	= host-includes
CC	= gcc
MACHINE	= PMAX
BUILD	= latest
MACHINE2= pmax
PREFIX	= /project/osc/build/${BUILD}/export/${MACHINE2}
INCLUDE	= -I${PREFIX}/usr/include
DEFINES	= -DSYSTEM_FIVE -D_BLD
DEB_OPT	= -g -O2
XCFLAGS	=
CFLAGS2	= -traditional
CFLAGS	= $(INCLUDE) $(DEFINES) $(DEB_OPT) $(CFLAGS2) $(XCFLAGS)
LDFLAGS	= $(DEB_OPT)
OBJECTS	= ARfuncs.o libld.o mach_o_hdr.o symutil.o
AR	= ar

VPATH	= ${MACHINE}

libld.a: $(OBJECTS)
	rm -f libld.a
	$(AR) qc libld.a $(OBJECTS)
	$(AR) ts libld.a

ARfuncs.o: ARfuncs.c $(HDRS) Makefile.ultrix
	$(CC) $(CFLAGS) -c ARfuncs.c

libld.o: libld.c $(HDRS) Makefile.ultrix
	$(CC) $(CFLAGS) -c libld.c

symutil.o: symutil.c $(HDRS) Makefile.ultrix
	$(CC) $(CFLAGS) -c symutil.c

mach_o_hdr.o: $(MACHINE)/mach_o_hdr.c $(HDRS)
	$(CC) $(CFLAGS) -c $(MACHINE)/mach_o_hdr.c

host-includes: Makefile.ultrix
	rm -rf host-includes
	mkdir host-includes
	for x in $(INC_FILE); do \
		dir=""; \
		for y in $(INC_DIRS); do \
			if [ -f "$${y}/$${x}" ]; then \
				dir="$${y}"; \
				break; \
			fi; \
		done; \
		if [ "$${dir}" = "" ]; then \
			echo "Could not find $${x} in directories: $(INC_DIRS)"; \
			exit 1; \
		fi; \
		ln -s $${dir}/$${x} host-includes; \
	done

clean:
	rm -rf *.[sao] core *.out host-includes
