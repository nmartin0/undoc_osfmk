#if defined(SYSLIBC_SCCS) && !defined(lint)
	.ascii "@(#)ptrace.s	5.5 (Berkeley) 6/27/88"
#endif /* SYSLIBC_SCCS and not lint */

#include "SYS.h"

	.globl	_errno
	.globl	_cerror

ENTRY(ptrace)
	mov	r0,r16
	mov	_errno,r30
	st.l	r0,0(r30)
	or	SYS_ptrace,r0,r31
	trap	r31,r31,r0
	bc	_cerror
	RET
