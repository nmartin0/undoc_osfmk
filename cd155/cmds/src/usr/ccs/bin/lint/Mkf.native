# OSF/1 Release 1.0

#
# Make file for creating lint libraries after OSF/1 is booted
#
#
DATAFILES		= ${ANSI_LIST} ${LLIB_LIST}

LIB_IDIR		= /usr/ccs/lib/

CFLAGS	= \
	-DNEWCALL	\
	-DHOSTIEEE	\
	-DSDBDEBUG	\
	-DTWOPASS	\
	-DSINGLE_PRECISION	\
	-D_COMPILER	\
	-DLINT

ANSI_LIST = llib-lansi.ln
LLIB_LIST =	\
	llib-lc.ln	\
	llib-port.ln	\
	llib-lm.ln	\
	llib-lcrses.ln

NLINT1	= /usr/ccs/lib/lint1

#
#	This builds the lint libraries for OSF/1.  N.B, that this
#	needs to be done RUNNING on an OSF/1 system.

all: ${DATAFILES}
	cp ${DATAFILES} ${LIB_IDIR}

$(ANSI_LIST): $$(@:.ln=.c)
	$(CC) -E -C $* | $(NLINT1) -wAP -MA -L$@


$(LLIB_LIST): $$(@:.ln=.c)
	$(CC) ${_CCFLAGS_} -E -C $(@:.ln=.c) | $(NLINT1) -Nn2500 -Nd3000 -L$@

