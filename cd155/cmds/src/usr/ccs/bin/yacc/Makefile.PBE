BIN	= yacc
SRC	= y1.c y2.c y3.c y4.c
ASM	=
OBJ	= $(SRC:.c=.o) $(ASM:.s=.o)
DEFS	=   -D_BLD
CC	= gcc
INCS	=
OPTIM	= -O
#OPTIM	=
#SYMS	= -g
#SYMS	= -Mnodebug
#PROF	= -pg
PROF	=
LIB	= -L../../lib -lcs
CFLAGS	= ${DEFS} ${INCS} ${OPTIM} ${SYMS} ${PROF}
BINDIR	= ../../bin
LIBDIR	= ../../lib/${BIN}
FORMS	= yaccpar

#
#	Don't let installed microkernel build kit hacks
#	cause trouble with re-building the tools
#
#PATH	= .:/sbin:/usr/sbin:/usr/bin
CPATH	= /usr/local/include:/usr/include
LPATH	= /usr/local/lib:/lib:/usr/lib

all:	${BIN}

.c.o:
	${CC} -c ${CFLAGS} $*.c

${BIN}:	${OBJ}
	mkidinfo
	${CC} -c _cvs_id.c
	${CC} ${PROF} -o ${BIN} _cvs_id.o ${OBJ} ${LIB}
	rm -f _cvs_id.c

depend:
	cp Makefile :Makefile
	sed -n '1,/^#@depend/p' < :Makefile > Makefile
	echo "# DO NOT PLACE ANYTHING BELOW THIS LINE" >> Makefile
	${CC} -M ${DEFS} ${INCS} ${SRC} >> Makefile

clean:
	rm -f ${OBJ} ${BIN}

${LIBDIR}:
	mkdir ${LIBDIR}

install:	${BIN} ${LIBDIR}
	cp -p ${BIN} ${BINDIR}
	cp ${FORMS} ${LIBDIR}

#@depend
# DO NOT PLACE ANYTHING BELOW THIS LINE
