C=${CPP-/usr/ccs/bin/cpp}
M=${MIGCOM-/usr/ccs/lib/migcom}

cppflags=
migflags=
files=

until [ $# -eq 0 ]
do
    case $1 in
	-[qQvVtTrRsSi] ) migflags="$migflags $1"; shift;;
	-user   ) migflags="$migflags $1 $2"; shift; shift;;
	-server ) migflags="$migflags $1 $2"; shift; shift;;
	-header ) migflags="$migflags $1 $2"; shift; shift;;
	-cpp ) C=$2; shift; shift;;
	-migcom ) M=$2; shift; shift;;
        -nostdinc ) shift;;
	-* ) cppflags="$cppflags $1"; shift;;
	* ) files="$files $1"; shift;;
    esac
done

for file in $files
do
    $C $cppflags "$file" | $M $migflags || exit
done

exit 0
