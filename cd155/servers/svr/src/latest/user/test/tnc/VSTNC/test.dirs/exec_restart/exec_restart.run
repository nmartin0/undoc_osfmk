#  Testing: Locus VSTNC, individual checkpoint restart by hand
#  Module(s):
#
#Revision 2.2  93/11/10  12:15:51  slk
#Check into main tree for checkpoint restart merge.
#
#Revision 2.1.1.1  93/08/27  14:13:05  hao
#
#	 Run the rforkmulti() call test.
#
for testcase in  1 2 3
do
	echo testcase is $testcase
	rm *.data
	rm -rf /chkpnt/*
	./simp &
	pid=$!
	mkdir /chkpnt/proc.$pid
	sleep 1
	/etc/chkpnt $pid
	sleep 1
	kill -9 -$pid
	sleep 2
	sync
	exec_restart $testcase $pid
	sync
	echo " "
done
rm -rf *std*
