#  Module(s):
#
#Revision 2.1.1.1  93/08/27  13:42:43  hao
#	Initial check-in.
#

for testcase in 1 2 3 4 5 6 7 8 
do
	echo testcase is $testcase
	rm -rf /chkpnt/*
	sync
	chkpnt.cmd $testcase
	sync
	echo " "
done
rm -rf *std*
