# Checkpoint Restart Code Drop
#  Reviewer: Chris Peak, chrisp@locus.com
#  Risk: Low
#  Benefit or PTS #: Enhancement
#  Testing: Locus VSTNC, individual checkpoint restart by hand
#  Module(s):
#
#Revision 2.2  93/11/10  12:18:05  slk
#Check into main tree for checkpoint restart merge.
#
#Revision 2.1.1.1  93/08/27  14:28:34  hao
#
#	 Run the on_restart() call test.
#
	echo testcase is $testcase
	rm -rf /chkpnt/*
	./simp1 &
	pid=$!
	rm parent.data
	mkdir /chkpnt/proc.$pid
	sleep 1
	/etc/chkpnt -k $pid
	sleep 2
	/etc/restart /chkpnt/proc.$pid
	sleep 2
	on_restart 1 $pid
	sync
	echo " "
rm -rf *std*
