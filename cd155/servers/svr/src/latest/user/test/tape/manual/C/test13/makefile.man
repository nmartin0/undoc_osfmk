#
#	Makefile for C esize test used for compiling without
#	t90. This is for 860 (RX) architecture only.
#

CC=  icc
MODULES=/usr/eval/t90/Manual/lib

all:    node_a.rx node_b.rx

node_a.rx:  node_a.c 
	  $(CC) -o node_a.rx node_a.c $(MODULES)/errexit.c -node -l 3480

node_b.rx:  node_b.c 
	  $(CC) -o node_b.rx node_b.c $(MODULES)/errexit.c -node -l 3480

clean:
	  rm -f *.S* scratch*.*

allclean:
	  rm -f *.o node*.rx *.S* scratch*.*
