#
#	Makefile for C esize test used for compiling without
#	t90. This is for 860 (RX) architecture only.
#

CC=  icc
MODULES=/usr/eval/t90/Manual/lib

all2:    node_a2.rx node_b2.rx node_c2.rx

all6:    node_a6.rx node_b6.rx node_c6.rx

node_a2.rx:  node_a2.c 
	  $(CC) -o node_a.rx node_a2.c $(MODULES)/errexit.c -node -l 3480

node_b2.rx:  node_b2.c 
	  $(CC) -o node_b.rx node_b2.c $(MODULES)/errexit.c -node -l 3480

node_c2.rx:  node_c2.c 
	  $(CC) -o node_c.rx node_c2.c $(MODULES)/errexit.c -node -l 3480

node_a6.rx:  node_a6.c 
	  $(CC) -o node_a.rx node_a6.c $(MODULES)/errexit.c -node -l 3480

node_b6.rx:  node_b6.c 
	  $(CC) -o node_b.rx node_b6.c $(MODULES)/errexit.c -node -l 3480

node_c6.rx:  node_c6.c 
	  $(CC) -o node_c.rx node_c6.c $(MODULES)/errexit.c -node -l 3480

clean:
	  rm -f *.S* scratch*.*
	
allclean:
	  rm -f *.o node*.rx  *.S* scratch*.*
