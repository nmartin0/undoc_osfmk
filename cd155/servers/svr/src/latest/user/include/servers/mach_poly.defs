/*
 * Matchmaker definitions file for polymorphic vm_set_default_memory_manager
 * - This file may look very strange and indeed it is. The whole idea is to 
 *   just allow the user side stub of vm_set_default_memory_manager pass an 
 *   extra argument indicating whether you want the 'default_manager' port 
 *   passed as MACH_MSG_TYPE_COPY_SEND or MACH_MSG_TYPE_MAKE_SEND
 *   NOTE : This one starts with id of 2041, so that we can avoid a whole 
 *          bunch of skips
 */

subsystem
#if	KERNEL_USER
	  KernelUser
#endif	KERNEL_USER
#if	KERNEL_SERVER
	  KernelServer
#endif	KERNEL_SERVER
		       mach 2041;

#ifdef	KERNEL_USER
userprefix r_;
#endif	KERNEL_USER

#include <mach/std_types.defs>
#include <mach/mach_types.defs>

/*
 *	Sets the default memory manager, the port to which
 *	newly-created temporary memory objects are delivered.
 *	[See (memory_object_default)memory_object_create.]
 *	The old memory manager port is returned. If default_manager =
 *      MACH_PORT_NULL on its way in, this call just returns the
 */
routine vm_set_default_memory_manager_poly(
		host_priv	: host_priv_t;
	inout	default_manager	: mach_port_send_t);




