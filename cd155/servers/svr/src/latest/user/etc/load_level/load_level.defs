subsystem load_level	987654;

UserPrefix tx_;
ServerPrefix rx_;

#include <mach/mach_types.defs>

type	dbl		= struct[2] of int;
type	node_array_t	= array[*:100] of int;
type	load_array_t	= array[*:100] of dbl;

import "osf1_dep_types.h";

simpleroutine load_message(
		local_node_port	: mach_port_t;
	in	nodes		: node_array_t;
	in	loads		: load_array_t); 
