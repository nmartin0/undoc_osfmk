#
#  This must be here before any rules are possibly defined by the
#  machine dependent makefile fragment so that a plain "make" command
#  always works.  The config program will emit an appropriate rule to
#  cause "all" to depend on every kernel configuration it generates.
#

default: all

#
#  In order to move the link commands out of config and back into the
#  template makefile, config has been changed to emit a dendency rule
#  of the form *vmunix.sys: *vmunix.swap for each configuration so that
#  the common commands for building each configuration can be placed
#  directly in the template in the default rule for the .sys.swap
#  dependency.
#
.SUFFIXES: .swap .sys

#
#  Make sure we don't remove this by accident if interrupted at the wrong
#  time.
#
.PRECIOUS: Makefile

#
#  Path to server sources:
#
SERVER=	$(SOURCE_DIR)/../server

#
#  Compilation components
#
CC=     ${HOST_CC?${HOST_CC}:gcc}
CPP=    cc -ES
C2=	/lib/c2
LD=	ld
MD=	md
ENCODE=	uuencode
DECODE=	uudecode

KCC=	${CC}
#KCPP=   ${CPP}

#
#  Pre-processor environment
#
DEPENDS=  -MD
INCLUDES=  -I$(SERVER)
DEBUG=
DEFINES= -UCMUCS -D_KERNEL  -DMACH_IPC_COMPAT=0 $(DEBUG) $(VOLATILE) \
	-DTypeCheck=0 -DUFS=1 -DNFS=1 -DFULLSERVER=1
ALLOPTS= ${INCLUDES} ${IDENT} ${DEFINES}
LINTOPTS=${ALLOPTS} -Di860 -D_i860_ -D__i860__ -F -Dvolatile=

#
#  Common C-compilation flags
#
COPTS_P=${DEPENDS} ${ALLOPTS}
COPTS=	${COPTS_P}

#
# The architecture-independent value for OPTIMIZE_DEFAULT set just below
# may be overridden in the master Makeconf file on a per-architecture basis.
# For example, defining OPTIMIZE_I386 will cause Makefile.i386 to define
# OPTIMIZE to $(OPTIMIZE_I386).  Omitting a definition for OPTIMIZE_I386
# will cause Makefile.i386 to define OPTIMIZE to $(OPTIMIZE_DEFAULT).
#
OPTIMIZE_DEFAULT= -g
CFLAGS=	${OPTIMIZE} ${COPTS}

MACHINEDIR=$(SOURCE_DIR)/${target_cpu}

#
#  Common assembly flags
#
SFLAGS=	${DEPENDS} ${ALLOPTS} -DASSEMBLER


#
#  Path name of the version identification file.
#
FEATURES=$(MACHINEDIR)/FEATURES.h
VERSION_FILES= \
	$(SERVER)/conf/version.major \
	$(SERVER)/conf/version.minor \
	$(SERVER)/conf/version.variant \
	$(SERVER)/conf/version.build \
	$(SERVER)/conf/version.patch

#
#  LDOBJS is the set of object files which comprise the kernel.
#  It is used both in the dependency list for each *vmunix.swap
#  rule emitted by config and also in the .sys.swap rule
#  below which links the kernel from these objects.
#  
#  LDOBJS_PREFIX and LDOBJS_SUFFIX are defined in the machine
#  dependent Makefile (if necessary).
#
LDOBJS=${FIRST_BUILT} ${LDOBJS_PREFIX} ${OBJS} ${LDOBJS_SUFFIX}

# Must do this first.  Damned if I can figure out a better way to 
# do this now.
FIRST_BUILT= bsd_user_side.o

#
#  LDDEPS is the set of extra dependencies associated with each
#  *vmunix.swap rule (in addition to $LDOBJS and the swap*.o file).
#
#  LDDEPS_PREFIX is defined in the machine dependent Makefile
#  (if necessary).
#
LDDEPS=${LDDEPS_PREFIX} ${VERSION_FILES} \
	$(SERVER)/conf/version.banner \
	$(SERVER)/conf/version.mk \
	$(SERVER)/conf/version.norma_mk \
	$(SERVER)/conf/newvers.sh \
	$(SERVER)/conf/copyright 

#
#  PRELDDEPS is another set of extra dependencies associated with each
#  *vmunix.swap rule (in addition to $LDOBJS and the swap*.o file).
#  It is defined in the machine dependent Makefile (if necessary).
#
#  The generated rule looks like
#	vmunix.sys : ${PRELDDEPS} ${LDOBJS} ${LDDEPS}
#

#
#  SWAPDEPS is the set of extra dependencies associated with each
#  swap*.o rule emitted by config (in addition to the
#  ../${target_cpu}/swap*.c file).
#
#  SWAPDEPS_PREFIX is defined in the machine dependent Makefile
#  (if necessary).
#
SWAPDEPS=${SWAPDEPS_PREFIX} 

#
#  SYSDEPS is the set of extra dependencies associated with each
#  *vmunix rule (in addition to *vmunix.sys).
#
#  SYSDEPS_PREFIX is defined in the machine dependent Makefile
#  (if necessary).
#
SYSDEPS=${SYSDEPS_PREFIX}



#
#  Compilation rules to generate *vmunix from *vmunix.sys
#
SYS_RULE_1=@eval `awk 'NR==1{S=$$1;next;}\
END {\
  C = "ln $@.sys $@";\
  if (S != "") {\
    C = C "; ln $@ $@" S; \
    printf "rm -f $@%s; ", S; \
  }\
  printf "echo \"%s\"; %s\n", C, C; \
}' vers.suffix`
SYS_RULE_2=:
SYS_RULE_3=:
SYS_RULE_4=:

#
# Compilation rules to generate .o from .b
#
B_RULE_1A=rm -f $*.o; ${DECODE} 
B_RULE_1B=$*.b

#
# Compilation rules to generate .o from .o
#
O_RULE_1A=rm -f $*.o; cp 
O_RULE_1B=$*.o .

#
# Compilation rules to generate .o from .s
#
S_RULE_1A=${KCPP} ${SFLAGS} 
S_RULE_1B=$*.s >$*.i 
S_RULE_2=${AS} -o $*.o $*.i
S_RULE_3=rm -f $*.i

#
# Compilation rules to generate .o from .c for normal files
#
C_RULE_1A=${KCC} -c ${OPTIMIZE} ${COPTS} 
C_RULE_1B=$*.c
C_RULE_2=:
C_RULE_3=:
C_RULE_4=:

C_RULE_1A_DBG=${KCC} -c -g ${COPTS} 

#
# Compilation rules to generate .o from .c for driver files
#
C_RULE_1A_D=${C_RULE_1A}
C_RULE_1B_D=${C_RULE_1B}
C_RULE_2_D=${C_RULE_2}
C_RULE_3_D=${C_RULE_3}
C_RULE_4_D=${C_RULE_4}

#
# Compilation rules to generate .o from .c for profiling routine files
#
C_RULE_1A_P=${KCC} -c -S ${OPTIMIZE} ${COPTS_P} 
C_RULE_1B_P=${C_RULE_1B}
C_RULE_2_P=ex - $*.s < ${GPROF.EX}
C_RULE_3_P=${AS} -o $*.o $*.s
C_RULE_4_P=rm -f $*.s



gprof: kgmon_on all kgmon_off

kgmon_on:
	kgmon -r -b

kgmon_off:
	kgmon -h -p
	gprof /mach >GPROF


#
#  These macros are filled in by the config program depending on the
#  current configuration.  The MACHDEP macro is replaced by the
#  contents of the machine dependent makefile template and the others
#  are replaced by the corresponding symbol definitions for the
#  configuration.
#

%OBJS

%CFILES

%SFILES

%BFILES

%ORDERED

%MACHDEP


#
#  Default rule used to build a *vmunix.sys configuration from the
#  object list and a particular *vmunix.swap module.  The *vmunix.swap
#  module is a normal object file compiled from the appropriate swap*.c
#  file and then copied to the *vmunix.swap name to trigger the full
#  kernel link using this default rule.
#

.swap.sys:
	@/bin/sh $(SERVER)/conf/newvers.sh \
			 $(SERVER)/conf/copyright \
			 `cat ${VERSION_FILES}` \
			 "`cat $(SERVER)/conf/version.banner`" \
			 "`cat $(SERVER)/conf/version.mk`" \
			 "`cat $(SERVER)/conf/version.norma_mk`" \
			 vmunix
	@${KCC} -c vers.c
	@rm -f $* $*.sys
	@echo link-editing $*.sys
	@${LD} ${LDFLAGS} ${LDOBJS} vers.o $*.swap ${LIBS}
	@$(SIZE) a.out
	@chmod 755 a.out
	@mv a.out $*.sys



#
#  OBJSDEPS is the set of files (defined in the machine dependent
#  template if necessary) which all objects depend on (such as an
#  in-line assembler expansion filter
#

${OBJS}: ${OBJSDEPS}



#
#  This macro is replaced by three rules per configuration, plus a
#  final definition for the LOAD symbol consisting of all configuration
#  names and a dependency of "all" on this symbol (so that the
#  "default" rule above will build everything).  The three rules in
#  each configuration are:
#
#  - a *vmunix from *vmunix.sys dependency using the SYS_RULE_* rules,
#  - a *vmunix.swap from LDDEPS, swap*.o, and LDDEPS dependency that
#    simply copies the swap file to the target name, and
#  - a swap*.o from swap*.c and SWAPDEPS dependency using the C_RULE_* rules.
#

%LOAD



emulator_base: ${SOURCE_DIR}/emulator_base.c
	LPATH=${HLPATH} $(HOST_CC) $(CFLAGS) ${HCFLAGS} -o emulator_base \
		${SOURCE_DIR}/emulator_base.c -D$(TARGET_CPU)

emul_init.o: $(BSD_FILES)

vers.o: vers.c

vers.c : $(VERSION_FILES)
	@/bin/sh $(SERVER)/conf/newvers.sh \
			 $(SERVER)/conf/copyright \
			 `cat ${VERSION_FILES}` \
			 "`cat $(SERVER)/conf/version.banner`" \
			 "`cat $(SERVER)/conf/version.mk`" \
			 "`cat $(SERVER)/conf/version.norma_mk`" \
			 emulator

#
#  The sysent tables, mapping trap numbers to actions, are generated
#  automatically on both the emulator and the server side:
#
emul_sysent.c: ${SERVER}/conf/makesyscalls.sh ${SERVER}/conf/syscalls.master
	sh ${SERVER}/conf/makesyscalls.sh -e ${SERVER}/conf/syscalls.master

#
#  Mach IPC-based interfaces
#

MAKE_UXKERN = [ -d uxkern ] || mkdir uxkern

MIG = mig
MIGFLAGS = ${DEFINES} ${COPTS} -I. -I${SOURCE_DIR}

BSD_FILES =  uxkern/bsd_1.h uxkern/bsd_1_user.c

bsd_user_side.o: ${BSD_FILES}

$(BSD_FILES): uxkern/bsd_types_gen.h $(SERVER)/uxkern/bsd_1.defs
	-$(MAKE_UXKERN)
	$(MIG) -MD $(MIGFLAGS) -header uxkern/bsd_1.h -user uxkern/bsd_1_user.c -server /dev/null $(SERVER)/uxkern/bsd_1.defs

FSVR_FILES = uxkern/fsvr.h uxkern/fsvr_user.c

async_io.o: ${FSVR_FILES}

$(FSVR_FILES): uxkern/bsd_types_gen.h $(SERVER)/uxkern/fsvr.defs
	-$(MAKE_UXKERN)
	$(MIG) -MD $(MIGFLAGS) -header uxkern/fsvr.h -user uxkern/fsvr_user.c -server /dev/null $(SERVER)/uxkern/fsvr.defs

FSVR2_FILES = uxkern/fsvr2.h uxkern/fsvr2_user.c

fsvr2_user_side.o: ${FSVR2_FILES}

$(FSVR2_FILES): ${FSVR_FILES} uxkern/bsd_types_gen.h $(SERVER)/uxkern/fsvr2.defs
	-$(MAKE_UXKERN)
	$(MIG) -MD $(MIGFLAGS) -header uxkern/fsvr2.h -user uxkern/fsvr2_user.c -server /dev/null $(SERVER)/uxkern/fsvr2.defs

FSVR2_ASYNC_FILES = uxkern/fsvr2_user_send.c uxkern/fsvr2_user_receive.c

$(FSVR2_ASYNC_FILES): $(SERVER)/conf/mig_async.sh uxkern/fsvr2_user.c
	-$(MAKE_UXKERN)
	sh $(SERVER)/conf/mig_async.sh uxkern/fsvr2_user.c

fsvr2_user_receive.o: ${FSVR2_ASYNC_FILES}
fsvr2_user_send.o: ${FSVR2_ASYNC_FILES}

PFS2_FILES = uxkern/pfs2.h uxkern/pfs2_user.c

$(PFS2_FILES): uxkern/bsd_types_gen.h $(SERVER)/uxkern/pfs2.defs
	-$(MAKE_UXKERN)
	$(MIG) -MD $(MIGFLAGS) -header uxkern/pfs2.h -user uxkern/pfs2_user.c -server /dev/null $(SERVER)/uxkern/pfs2.defs

PFS2_ASYNC_FILES = uxkern/pfs2_user_send.c uxkern/pfs2_user_receive.c

$(PFS2_ASYNC_FILES): $(SERVER)/conf/pfs_async.sh uxkern/pfs2_user.c
	-$(MAKE_UXKERN)
	sh $(SERVER)/conf/pfs_async.sh uxkern/pfs2_user.c

pfs2_user_receive.o: ${PFS2_ASYNC_FILES}
pfs2_user_send.o: ${PFS2_ASYNC_FILES}

EMUL_CALL_FILES = uxkern/emul_call.h uxkern/emul_call_server.c uxkern/emul_call_user.c

emul_call_server.o: ${EMUL_CALL_FILES}
emul_call_user.o: ${EMUL_CALL_FILES}

$(EMUL_CALL_FILES): uxkern/bsd_types_gen.h $(SERVER)/uxkern/emul_call.defs
	-$(MAKE_UXKERN)
	$(MIG) -MD $(MIGFLAGS) -header uxkern/emul_call.h -user uxkern/emul_call_user.c -server uxkern/emul_call_server.c $(SERVER)/uxkern/emul_call.defs

EMUL_CALL_REPLY_FILES = uxkern/emul_call_reply.h uxkern/emul_call_reply_user.c

emul_call_reply_user.o: ${EMUL_CALL_REPLY_FILES}

$(EMUL_CALL_REPLY_FILES): uxkern/bsd_types_gen.h $(SERVER)/uxkern/emul_call_reply.defs
	-$(MAKE_UXKERN)
	$(MIG) -MD $(MIGFLAGS) -header uxkern/emul_call_reply.h -user uxkern/emul_call_reply_user.c -server /dev/null $(SERVER)/uxkern/emul_call_reply.defs

MAKE_NX = [ -d nx ] || mkdir nx


emul_machdep.o:nx/nx_svr.h

nx/nx_svr.h: uxkern/bsd_types_gen.h ${SERVER}/nx/nx_svr.defs
		-$(MAKE_NX)
		$(MIG) -MD $(MIGFLAGS) -header nx/nx_svr.h -user /dev/null -server /dev/null ${SERVER}/nx/nx_svr.defs

nx/nx_svr_user.c: uxkern/bsd_types_gen.h ${SERVER}/nx/nx_svr.defs
		-$(MAKE_NX)
		$(MIG) -MD $(MIGFLAGS) -header /dev/null -user nx/nx_svr_user.c -server /dev/null ${SERVER}/nx/nx_svr.defs

nx_svr_user.o: nx/nx_svr_user.c

# We have to tell Mig to generate a header file, even though we don't really
# want it, because the user file includes the header file from the current
# directory.
#

uxkern/bsd_types_gen.h : bsd_types_gen
	-$(MAKE_UXKERN)
	./bsd_types_gen > uxkern/bsd_types_gen.h

bsd_types_gen : bsd_types_gen.o
	LPATH=${HLPATH} ${HOST_CC} -o bsd_types_gen bsd_types_gen.o

bsd_types_gen.o : $(SERVER)/uxkern/bsd_types_gen.c
	${HOST_CC} -c -I${SOURCE_DIR} \
		-I${TARGET_CPU} -I${SOURCE_DIR}/${TARGET_CPU} -I../../server \
		${CFLAGS} ${HCFLAGS} $(SERVER)/uxkern/bsd_types_gen.c

clean:
	rm -rf emulator ${OBJS} uxkern migfiles *.[chd] Makedep

#
#  Run "lint" on the current build directory.  This will often be done
#  with a special configuration that defines the union of all options
#  used in all configurations so that all combinations are checked.
#  The LINTFILES variable allows lint to be easily run on an optional
#  sub-set of files specified on the make command line when this is
#  desired.
#
#  The 'lint' you run must understand ANSI C, else you're sunk.

#  Prepend SOURCE_DIR to each file either in the list of files given or in
#  the generated list of all C files except those in the object dir (./*):
LINTFILES=${LINTFILES?\
		${LINTFILES;.*;$(SOURCE_DIR)/&}:\
		${CFILES;^[^\.].*;$(SOURCE_DIR)/&}} 

lint:	ALWAYS ${LINTFILES}
	lint -hbxn -DGENERIC `cpath` ${LINTOPTS} ${LINTFILES}

ALWAYS:


-include Makedep
#
#  Mach IPC-based interfaces
#

%RULES


emulator: ${OBJS} emulator_base \
		$(SERVER)/conf/version.variant $(SERVER)/conf/version.build
# For some reason we are making an emulator directory in the $CONFIG dir
# in the obj tree.  This removes it so the emulator executable can be
# created. 
	@if [ -d emulator ] ; then rmdir emulator; else true; fi
	/bin/rm -f emulator
	$(LD) -o emulator -T `./emulator_base` ${LDFLAGS} ${OBJS} \
	        $(LIBS)
	md -u Makedep -d *.d


