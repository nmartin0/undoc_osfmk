###############################################################################
#BEGIN	Machine dependent Makefile fragment for the ipsc860
###############################################################################
C_RULE_2_P=true

#tmp

SYS_RULE_2=-@
SYS_RULE_3=-@
SYS_RULE_4=-@


#KCC=cc860
KCC=icc

# This is now set in the toplevel Makeconf file.
#KCPP=cc -ES -Ui386 -Di860
LD=ld860
AS=as860
AR=ar860
SIZE=size860

# The master Makeconf file may have defined OPTIMIZE_I860.  If so we
# set OPTIMIZE accordingly; if not we use the OPTIMIZE_DEFAULT value
# we get from the Makefile.template file.
#
OPTIMIZE=${OPTIMIZE_I860?$(OPTIMIZE_I860):$(OPTIMIZE_DEFAULT)}

MD=md

# Note that COMPILER_RT contains a hard-coded pathname.
# It is now defined in the master Makeconf file.
#
#LIBS_P=-lc_p
#LIBS=-lthreads -lmach_sa
LIBS=-lthreads -lmach_sa ${COMPILER_RT}
#LIBS=${MKLIB}/libthreads.a ${MKLIB}/libmach_sa.a ${COMPILER_RT}

LDFLAGS= -e __crt0_start -P 0x10000 -L${MKLIB}
#
#
#
###############################################################################
#END	Machine dependent Makefile fragment for the ipsc860
###############################################################################






