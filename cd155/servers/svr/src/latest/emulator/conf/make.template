if ( { \[ -z "@OBJECTDIR@" \] } ) then
    set dirs=(`echo ..:@VPATH@ | sed -e "s;:; ;"`)
else
    set dirs=(`echo ../@VPATH@ | sed -e "s;:; ;"`)
endif
unsetenv MAKEDIR MAKEPSD MAKECWD OBJECTDIR

if ($#dirs == 1 && $?USE_SOURCE_DIR) then
    setenv CPATH ":../../server:../../server/include:${dirs}"
    setenv VPATH ""
    set src="SOURCE_DIR=${dirs}"
else
    setenv CPATH "../../server:../../server/include"
    setenv VPATH ""
    set c=""
    foreach d ($dirs)
        setenv CPATH "${CPATH}:${d}"
        setenv VPATH "${VPATH}${c}${d}/conf"
        set c=":"
    end
    set src=""
endif

setenv CPATH "${CPATH}:${MKINC}"
if ( ${?LPATH} == 0 ) setenv LPATH
setenv LPATH "${MIGCOMDIR}":"${MKLIB}":"${LPATH}"

set prog=$0
set prog=$prog:t
set makeargs=(-c)
if ("$prog" == "pmake") set makeargs=""
set newprog=(`wh $prog | fgrep -v -x "./$prog" | fgrep -v -x "$prog" | head -1`)
exec $newprog $makeargs $src $*
