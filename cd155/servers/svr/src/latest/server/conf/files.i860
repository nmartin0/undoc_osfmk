#
# Machine-dependent files for out-of-kernel version
#
OPTIONS/syscalltrace		optional syscalltrace
OPTIONS/mach_rdb		optional mach_rdb
OPTIONS/stack_limit_check	optional stack_limit_check
OPTIONS/itrace			optional itrace
OPTIONS/idebug			optional idebug

netns/ns_cksum.c		optional ns
i860/in_cksum.c			optional inet
i860/bsd_machdep.c		standard
i860/mach_o_hdr.c		optional osf_mach_o
i860/conf.c			standard
i860/i860_exception.c		optional mach
i860/libc.c			standard
i860/slock.s			standard
i860/slock2.c			standard
i860/primitives.s		standard
i860/queue.c			standard
i860/user_bcopy.s		standard
i860/bcopy.s			standard
uxkern/raw_hippi.c		standard
# Added by us to allow a second server to run under another BSD server:
i860/second_syscalls.s		optional second_server
#
# NX
#
nx/nx.c				optional nx
nx/nx_mig.c			optional nx
nx/nx_svr_server.c		optional nx
nx/nx_acct.c			optional nx
# Needed during server boot to create node attributes.
# Not really message-passing related, but this seems like the "best" place:
nx/nx_create_attr.c		standard
#
# PFS
#
uxkern/pfs2_server_side.c	optional pfs
uxkern/pfs_server.c		optional pfs
pfs/pfs_vfsops.c		optional pfs
pfs/pfs_vnops.c			optional pfs
#
# SLL
#
sll/sll.c			optional sll
#
# Paragon HIPPI interface support
#
net/if_hippisubr.c		optional rfc_1323
uxkern/hippi_io.c		optional rfc_1323
#
# IPI-3 device support
#
i860/ipi_ops.c			standard
#
# PARACORE
#
paracore/allocinfo.c		optional paracore
paracore/core.c			optional paracore
paracore/dump.c			optional paracore
paracore/dvp_pvpcore.c		optional paracore
