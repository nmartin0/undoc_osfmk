###############################################################################
#BEGIN	Machine dependent Makefile fragment for the ipsc860
###############################################################################
C_RULE_2_P=true

#tmp

SYS_RULE_2=-@
SYS_RULE_3=-@
SYS_RULE_4=-@


#KCC=cc860
KCC=icc

# This is now set in the toplevel Makeconf file.
#KCPP=cc -ES -Ui386 -Di860
LD=ld860
AS=as860
AR=ar860
SIZE=size860
LINTOPTS=${ALLOPTS} -Di860 -D_i860_ -D__i860__ -F -Dvolatile=

# The master Makeconf file may have defined OPTIMIZE_I860.  If so we
# set OPTIMIZE accordingly; if not we use the OPTIMIZE_DEFAULT value
# we get from the Makefile.template file.
#
OPTIMIZE=${OPTIMIZE_I860?$(OPTIMIZE_I860):$(OPTIMIZE_DEFAULT)}

MD=md

# Note that COMPILER_RT contains a hard-coded pathname.
# It is now defined in the master Makeconf file.
#
#LIBS_P=-lc_p
#LIBS=-lthreads -lmach_sa
LIBS=-lthreads -lmach_sa ${COMPILER_RT}
#LIBS=${MKLIB}/libthreads.a ${MKLIB}/libmach_sa.a ${COMPILER_RT}

#LDFLAGS= -x -e start -L${MKLIB}
LDFLAGS= -k -e start $(DATA_START_I860) -L${MKLIB}
#
nx_svr_server.o: nx/nx_svr_server.c uxkern/bsd_types_gen.h

nx_mig.o:       nx/nx_user.c

nx.o:           nx/nx_user.h

MAKE_NX = [ -d nx ] || mkdir nx

NX_SVR_FILES = nx/nx_svr_server.c nx/nx_svr.h

$(NX_SVR_FILES): uxkern/bsd_types_gen.h $(SOURCE_DIR)/nx/nx_svr.defs
		-$(MAKE_NX)
		$(MIG) -MD $(MIGFLAGS) -header nx/nx_svr.h -user /dev/null -server nx/nx_svr_server.c $(SOURCE_DIR)/nx/nx_svr.defs

nx/nx_user.c: $(SOURCE_DIR)/nx/nx.defs
		-$(MAKE_NX)
		$(MIG) -MD $(MIGFLAGS) -header /dev/null -user nx/nx_user.c -server /dev/null $(SOURCE_DIR)/nx/nx.defs

nx/nx_user.h: $(SOURCE_DIR)/nx/nx.defs
		-$(MAKE_NX)
		$(MIG) -MD $(MIGFLAGS) -header nx/nx_user.h -user /dev/null -server /dev/null $(SOURCE_DIR)/nx/nx.defs

#
# PFS server.
#
pfs2_server.o: uxkern/pfs2_server.c uxkern/bsd_types_gen.h uxkern/pfs2.h

pfs2_user.o: uxkern/pfs2_user.c uxkern/bsd_types_gen.h uxkern/pfs2.h

pfs2_server_side.o: uxkern/bsd_types_gen.h uxkern/pfs2.h

PFS2_FILES = uxkern/pfs2_server.c uxkern/pfs2_user.c uxkern/pfs2.h

$(PFS2_FILES): uxkern/bsd_types_gen.h $(SOURCE_DIR)/uxkern/pfs2.defs
	-$(MAKE_UXKERN)
	$(MIG) -MD $(MIGFLAGS) -header uxkern/pfs2.h -user uxkern/pfs2_user.c -server uxkern/pfs2_server.c $(SOURCE_DIR)/uxkern/pfs2.defs


#
# crt0.o (start) comes from libmach_sa.a
#
#
###############################################################################
#END	Machine dependent Makefile fragment for the ipsc860
###############################################################################






