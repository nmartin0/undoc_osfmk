MAKE_MACH = [ -d mach ] || mkdir mach
MAKE_UXKERN = [ -d uxkern ] || mkdir uxkern
MAKE_BUILTIN = [ -d builtin ] || mkdir builtin
MAKE_LNSVR = [ -d lnsvr ] || mkdir lnsvr
MAKE_VPROC = [ -d vproc ] || mkdir vproc
