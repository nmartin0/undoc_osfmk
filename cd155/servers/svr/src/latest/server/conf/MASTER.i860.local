######################################################################
#
#  Master i860 configuration file (see the master machine independent
#  configuration file for a description of the file format) for local
#  site modification.
#
######################################################################
#  
#  CMU CS/RI Facilities Production Configurations:
#  --- ----- ---------- ---------- ---------------
#
#  MACH    = [ ANY L 16 ]
#
#  Mach Private Names
#  ---- ---------
#
#  SQT     = [ sqt ]
#
######################################################################
#

options		COMPAT		# <compat>

options		SEQUENT		# <sqt>

makevariables	"OPTIMIZE_I860"="-O4"   #<opt4>

makevariables	"OPTIMIZE_I860"="-g"   #<dashg>
