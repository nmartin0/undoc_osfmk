#
#	@(#)newvers.sh	7.1 (Berkeley) 6/5/86
#
# newvers.sh copyright major minor variant (build) patch banner
#

# Since we now have more than 9 parameters, the only way we can get the
# tenth one is with 'shift'.
#		Dave Leslie 1/28/93
if [ "$6" != "?" ]; then
        patch="$6"
fi
if [ "$4" != "?" ]; then
        variant="$4"
else
        variant=""
fi
copyright="$1"; shift
major="$1"; shift
minor="$1"; shift; shift
build="$1"; shift; shift
banner="$1"; shift 
mk="$1"; shift
norma_mk="$1"; shift
pgmname="$1"
mkidinfo -f $pgmname
relvers=`cat _cvs_id.c | sed -n -e 's/^.*"@/@/' -e 's/";$//p'`
rm -f _cvs_id.c
h=`hostname` t=`date` u=$USER
# use the BUILD env variable rather than $5 for build id (only don't - sp)
#build=${BUILD:-"b?"}
v="${major}.${minor}${patch+.${patch}}"
bui="${variant+${variant}${build+${build}}}"
if [ "X${variant}" = "X" ]; then
        b=""
else
        b="(${bui})"
fi
vers=`echo $relvers | awk '{print $3}'`

if [ -r vers.config ]; then
     CONFIG=`cat vers.config`
fi

if [ -z "$h" -o -z "$t" -o -z "${CONFIG}" ]; then
    exit 1
fi
(
  echo "#ifdef __STDC__" ;
  echo "#define CONST const" ;
  echo "#else" ;
  echo "#define CONST" ;
  echo "#endif" ;
  echo "CONST int  version_need_mk    = ${mk};" ;
  echo "CONST int  version_need_norma_mk = ${norma_mk};" ;
  echo "CONST int  version_major      = ${major};" ;
  echo "CONST int  version_minor      = ${minor};" ;
  echo "CONST char version_version[32]  = \"${vers}\";" ;
  echo "CONST char version_ident[128]  = \"${relvers}\";" ;
  echo "CONST char version_release[32]  = \"${v}\";" ;
  echo "CONST char version[] = \"Paragon OSF/1 Release ${v} ${banner} ${vers}; ${t};\\\\n    ${CONFIG}\\\\n\";" ;
  echo "CONST char copyright[] = \"\\" ;
  sed <$copyright -e '/^#/d' -e 's;[ 	]*$;;' -e '/^$/d' -e 's;$;\\n\\;' ;
  echo "\";";
) > vers.c
if [ -s vers.suffix -o ! -f vers.suffix ]; then
    echo ".${bui}.${CONFIG}" >vers.suffix
fi
exit 0

