/*
 * IPC interface for selected NX server functions.
 */
subsystem nx_svr	314159;

#include <mach/mach_types.defs>
#include <uxkern/bsd_types.defs>
#include <nx/nx_types.defs>

routine	NX__nx_init(
		vproc_port	: mach_port_t;
	out	interrupt	: boolean_t;
        in      nx_info		: NX_INIT_T;
	out	numnodes	: int;
	in	appl_info       : APPLINFO_T;
	in	selector_cnt	: int;
	in	selector	: MIG_BITMAP_T);


routine	NX_node_self(
		vproc_port	: mach_port_t;
	out	mynode          : int);


routine NX_attach_pgrp(
		vproc_port	: mach_port_t;
	out	interrupt	: boolean_t;
	in	pgrp            : pid_t);

routine NX_detach_pgrp(
		vproc_port	: mach_port_t;
	out	interrupt	: boolean_t;
	in	pgrp            : pid_t);

routine NX_join(
		vproc_port	: mach_port_t;
	out	interrupt	: boolean_t;
	in	pgrp            : pid_t;
	out     numnodes        : int);

routine NX_nx_pri(
		vproc_port	: mach_port_t;
	out	interrupt	: boolean_t;
	in	pid            : pid_t;
	in	pri            : int);


routine	NX_join_root_part(
		vproc_port	: mach_port_t;
	out	interrupt	: boolean_t);

routine NX_nx_part_attributes(
		vproc_port	: mach_port_t;
	out	interrupt	: boolean_t;
	in	inode		: ino_t;
	out	partinfo	: PARTREQ_T);

routine NX_nx_node_list(
		vproc_port	: mach_port_t;
	out	interrupt	: boolean_t;
	in	inode		: ino_t;
	out	node_list	: LP_MAP_T,dealloc);

routine NX_nx_part_bitmap(
		vproc_port	: mach_port_t;
	out	interrupt	: boolean_t;
	in	inode		: ino_t;
	out	bitmap		: MIG_BITMAP_T,dealloc);

routine NX_nx_matching_bitmap(
		vproc_port	: mach_port_t;
	out	interrupt	: boolean_t;
	out	bitmap		: MIG_BITMAP_T,dealloc;
	in	selector_buf	: MIG_BITMAP_T;
	in	exact		: int);

routine NX_nx_mkpart_rpc(
		vproc_port	: mach_port_t;
	out	interrupt	: boolean_t;
	in	buffer		: MIG_BITMAP_T;
	out	num_nodes	: int);

routine NX_nx_chpart_rpc(
		vproc_port	: mach_port_t;
	out	interrupt	: boolean_t;
	in	buffer		: string);

routine NX_nx_rmpart_rpc(
		vproc_port	: mach_port_t;
	out	interrupt	: boolean_t;
	in	pathname	: string;
	in	inode		: ino_t;
	in	flags		: int);

routine NX_nx_register_daemon(
		vproc_port	: mach_port_t;
	out	interrupt	: boolean_t;
	in	daemon_id	: int;
	in	sock_addr	: smd_iface_t);

routine NX_nx_mypart(
                vproc_port      : mach_port_t;
        out     interrupt       : boolean_t;
        out     rows            : int;
        out     cols            : int);

routine NX_nx_app_info(
		vproc_port	: mach_port_t;
	out	interrupt	: boolean_t;
	in	pgroup		: pid_t;
	out	app_info	: nx_app_info_t);

routine NX_nx_app_node_list(
		vproc_port	: mach_port_t;
	out	interrupt	: boolean_t;
	in	pgroup		: pid_t;
	out	node_list	: LP_MAP_T,dealloc);

routine NX_nx_free_node_list(
		vproc_port	: mach_port_t;
	out	interrupt	: boolean_t;
	in	inode		: ino_t;
	out	bitmap		: MIG_BITMAP_T,dealloc);

routine NX_nx_pspart_rpc(
		vproc_port	: mach_port_t;
	out	interrupt	: boolean_t;
	in	inode		: ino_t;
	out	buffer		: MIG_BITMAP_T,dealloc);

routine NX_nx_alloc_exit_rpc(
		vproc_port	: mach_port_t;
	out	interrupt	: boolean_t;
	in	pgroup		: pid_t);
	
