operation settimezone {
	parameter IN node_t node	/* destination node of op */
	parameter IN struct timezone tzp /* new timezone to set */
}
operation settimezone_multi ASYNC {
	parameter IN node_t node	/* destination node of op */
	parameter IN struct timezone tzp /* new timezone to set */
	parameter IN_RPC_VAR_ARRAY_OUT_OF_LINE long_node_array_t full_node_array
	parameter IN_RPC_VAR_ARRAY_LENGTH int full_array_count
	parameter IN int full_array_index
	parameter INOUT msg_handle_t *h /* message reference handle */
	escape SERVER_POST-OP
		/*
		 * This escape frees the out-of-line memory containing the
		 * node array in the settimezone_multi() pvpsop.
