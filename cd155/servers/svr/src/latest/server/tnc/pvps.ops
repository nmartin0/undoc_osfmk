			     (vm_address_t) full_node_array,
			     (unsigned int) (full_array_count*sizeof(node_t)));
	end_escape
}
operation remote_vproc_free {
	parameter IN node_t node	/* destination node of op */
	parameter IN struct vproc *vp	/* vproc to be freed */
}
operation ctty_getattr {
	parameter IN node_t node	/* destination node of op */
	parameter IN struct vproc *vs	/* session being queried */
	parameter OUT pid_t *pgid	/* foreground pgrp of session */
	parameter OUT dev_t *dev	/* major/minor of controlling tty */
}
operation release_ctty {
	parameter IN node_t node	/* destination node of op */
	parameter IN struct vproc *vs	/* session with controlling tty */
	parameter OUT pid_t *t_pgid	/* current foreground pgrp */
	escape SERVER_PRE-OP
		/*
		 * These escapes deal with the uarea setup.
		 */
		start_rpvpsop_dummy_setup();
	end_escape
	escape SERVER_POST-OP
		end_rpvpsop_dummy_setup();
	end_escape
}
operation get_vproc_port {
	parameter IN node_t node	/* destination node of op */
	parameter IN struct vproc *vp	/* vproc whose port is to be obtained */
	parameter OUT mach_port_move_send_t *vproc_port /* vproc port */
	escape SERVER_POST-OP
		/*
		 * This provides special-case code to deal with passing back
		 * a vproc port send right. We need to bump our reference
		 * (before the vproc is released) so that the extra right
		 * is moved back to the reply message.
		 */
		if (_error == ESUCCESS) {
			(void) mach_port_mod_refs(mach_task_self(),
						  *vproc_port,
						  MACH_PORT_RIGHT_SEND,
						  +1);
		} else
			*vproc_port = MACH_PORT_NULL;
	end_escape
	escape CLIENT_POST-RPC
		if (_rval == ESUCCESS && !MACH_PORT_VALID(*vproc_port)) {
			*vproc_port = MACH_PORT_NULL;
			_rval = ESRCH;	/* for MACH_PORT_DEAD & _NULL */
		}
	end_escape
}
operation reboot {
	parameter IN node_t node	/* destination node of op */
	parameter IN int flags		/* indicates whether panicking */
	parameter IN int options	/* options applying to reboot */
	escape SERVER_PRE-OP
		/*
		 * These escapes deal with the uarea setup.
		 */
		start_rpvpsop_dummy_setup();
	end_escape
	escape SERVER_POST-OP
		end_rpvpsop_dummy_setup();
	end_escape
}
operation boot NO_REPLY {
	parameter IN node_t node	/* destination node of op */
	parameter IN int flags		/* indicates whether panicking */
	parameter IN int options	/* options applying to reboot */
	escape SERVER_PRE-OP
		/*
		 * The boot() operation takes the master lock and since
		 * it doesn't return this lock is not released.
		 */
		unix_master();
	end_escape
}
operation remote_vproc_allocate {
	parameter IN node_t node	/* destination node of op */
	parameter IN pid_t pid		/* pid to be allocated */
}
#ifdef	NX
operation reset_boot_node_list {
	parameter IN node_t node	/* destination node of op */
	parameter IN_RPC_VAR_ARRAY_OUT_OF_LINE char_array nodelist
					/* new nodelist */
	parameter IN_RPC_VAR_ARRAY_LENGTH u_int nodelistlen /*nodelist length*/
}

operation table_set {
	parameter IN node_t node	/* destination node of op */
	parameter IN int id		/* id of action to take */
	parameter IN int index		/* index into table */
	parameter IN_RPC_VAR_ARRAY_OUT_OF_LINE char_array buffer
					/* address of buffer used */
	parameter IN_RPC_VAR_ARRAY_LENGTH u_int bufferlen /* buffer length */
	parameter IN int nel		/* numvber of elements in buffer */
	parameter IN u_int lel		/* length of each element in buffer */
	parameter OUT int *retval	/* returned value */
	/*
	 * These escapes deal with the special-case code for
	 * the out-of-line memory that is passed in and the uarea setup
	 * that is necessary for the table_set() pvpsop.
	 */
	escape SERVER_PRE-OP
		start_rpvpsop_dummy_setup();
		unix_master();
	end_escape
	escape SERVER_POST-OP
		unix_release();
		end_rpvpsop_dummy_setup();
		(void) vm_deallocate(mach_task_self(),
					(vm_address_t) buffer,
					(unsigned int) (-nel*lel));
	end_escape
}

#endif	/* NX */
operation rforkmulti ASYNC {
	parameter IN node_t node	/* destination node of op */
	parameter IN int forkfamily	/* forkfamily() or rforkmulti() */
	parameter IN_RPC_VAR_ARRAY multi_int_array_t np_array
	parameter IN_RPC_VAR_ARRAY_LENGTH u_int np_array_len
	parameter IN int np_idx
	parameter IN int base_idx
	parameter IN int proc_count
	parameter OUT_RPC_VAR_ARRAY multi_int_array_t rval_array
	parameter OUT_RPC_VAR_ARRAY_LENGTH u_int *rval_array_len
	parameter IN mach_port_copy_send_t pp_vproc_port
	parameter IN mach_port_copy_send_t pgrp_vproc_port
	parameter IN mach_port_copy_send_t rdir_port
	parameter IN mach_port_copy_send_t cdir_port
	parameter IN task_t pp_task
	parameter OUT_RPC_VAR_ARRAY multi_vproc_array_t ch_vproc_port_array
	parameter OUT_RPC_VAR_ARRAY_LENGTH u_int *ch_vproc_port_array_len
	parameter OUT_RPC_VAR_ARRAY multi_pid_array_t ch_pidp_array
	parameter OUT_RPC_VAR_ARRAY_LENGTH u_int *ch_pidp_array_len
	parameter IN_RPC_VAR_ARRAY multi_name_array_t fp_name
	parameter IN_RPC_VAR_ARRAY_LENGTH u_int fp_name_len
	parameter IN_RPC_VAR_ARRAY multi_port_array_t fp_right
	parameter IN_RPC_VAR_ARRAY_LENGTH u_int fp_right_len
	parameter IN_RPC_VAR_ARRAY thread_state_t ch_state
	parameter IN_RPC_VAR_ARRAY_LENGTH u_int ch_state_len
	parameter IN mach_port_name_t vproc_port_name
	parameter IN mach_port_name_t cred_port_name
	parameter IN rf_data_t rf_data
	parameter IN_RPC_VAR_ARRAY mmap_struct_array_t mmap_structs
	parameter IN_RPC_VAR_ARRAY_LENGTH u_int mmap_structs_len
	parameter IN_RPC_VAR_ARRAY mmap_port_array_t mmap_pagers
	parameter IN_RPC_VAR_ARRAY_LENGTH u_int mmap_pagers_len
#ifdef	BUG_FIX_PTS_#_10149
	parameter IN command_name_t command_name
	parameter IN logname_t logname
#ifdef	NX
	parameter IN APPLINFO_T info
	parameter IN_RPC_VAR_ARRAY_OUT_OF_LINE LP_MAP_T nodes
	parameter IN_RPC_VAR_ARRAY_LENGTH u_int nodescnt
#endif	/* NX */
#ifdef	PARACORE
	parameter IN mach_port_copy_send_t exec_rdir_port
	parameter IN mach_port_copy_send_t exec_cdir_port
	parameter IN_RPC_VAR_ARRAY path_name_t exec_prg_name
	parameter IN_RPC_VAR_ARRAY_LENGTH u_int exec_prg_name_len
#endif	/* PARACORE */
#else	/* BUG_FIX_PTS_#_10149 */
	parameter IN command_name_t c
	parameter IN logname_t l
#ifdef	NX
	parameter IN APPLINFO_T i
	parameter IN_RPC_VAR_ARRAY_OUT_OF_LINE LP_MAP_T n
	parameter IN_RPC_VAR_ARRAY_LENGTH u_int n_c
#endif	/* NX */
#ifdef	PARACORE
	parameter IN mach_port_copy_send_t x_r
	parameter IN mach_port_copy_send_t x_c
	parameter IN_RPC_VAR_ARRAY path_name_t p
	parameter IN_RPC_VAR_ARRAY_LENGTH u_int p_l
#endif	/* PARACORE */
#endif	/* BUG_FIX_PTS_#_10149 */
	parameter INOUT msg_handle_t *h /* message reference handle */
	/*
	 * The following escapes ensure that uarea/proc environment
	 * is fully initialized during the operation.
	 */
	escape SERVER_PRE-OP
		#include <sys/syscall.h>
		extern  mach_port_t	this_node_tnc_server_port;
		start_tncserver_op(this_node_tnc_server_port,
#ifdef CHKPNT
				   forkfamily? SYS_forkfamily : SYS_rforkmulti);
#else
				   SYS_rforkmulti);
#endif
	end_escape
	escape SERVER_POST-OP
		end_tncserver_op(_error);
	end_escape
}
operation rforkmulti_long ASYNC
	parameter IN node_t node	/* destination node of op */
	parameter IN int forkfamily	/* forkfamily() or rforkmulti() */
	parameter IN_RPC_VAR_ARRAY_OUT_OF_LINE long_multi_int_array_t np_array
	parameter IN_RPC_VAR_ARRAY_LENGTH int np_array_len
	parameter IN int np_idx
	parameter IN int base_idx
	parameter IN int proc__count
	parameter OUT_RPC_VAR_ARRAY_OUT_OF_LINE long_multi_int_array_t *rval_array
	parameter OUT_RPC_VAR_ARRAY_LENGTH u_int *rval_array_len
