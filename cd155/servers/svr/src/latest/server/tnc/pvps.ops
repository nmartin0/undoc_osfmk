	parameter IN rf_data_t rf_data
	parameter IN_RPC_VAR_ARRAY mmap_struct_array_t mmap_structs
	parameter IN_RPC_VAR_ARRAY_LENGTH u_int mmap_structs_len
	parameter IN_RPC_VAR_ARRAY mmap_port_array_t mmap_pagers
	parameter IN_RPC_VAR_ARRAY_LENGTH u_int mmap_pagers_len
#ifdef	BUG_FIX_PTS_#_10149
	parameter IN command_name_t command_name
	parameter IN logname_t logname
#ifdef	NX
	parameter IN APPLINFO_T info
	parameter IN_RPC_VAR_ARRAY_OUT_OF_LINE LP_MAP_T nodes
	parameter IN_RPC_VAR_ARRAY_LENGTH u_int nodescnt
