/*
 * This file defines the TNC private virtual process operations.
 * It is used as input to the tncgen script for automatic generation
 * of *_gen* source files.
 *
 * The format of each operation definition is (loosely):
 *	operation <op_name> [<op_attribute>]* {
 *		parameter <parm_attribute><parm_rpc> <parm_type> <parm_name>
 *		[parameter <parm_attribute><parm_rpc> <parm_type> <parm_name>]*
 *		[escape <escape_type>
 *			<escape_code>
 *		escape_end]*
 *	}
 * where:
 *	<op_name> ::= identifier
 *	<op_attribute> ::= ASYNC | NOREPLY
 *	<parm_attribute> ::= IN | OUT | INOUT
 *	<parm_rpc> ::= _RPC_VAR_ARRAY |_RPC_VAR_ARRAY_OUT_OF_LINE | 
 *		       _RPC_VAR_ARRAY_LENGTH
 *	<parm_name> ::= identifier
 *	<escape_type> ::= CLIENT_ENTRY | CLIENT_PRE-RPC | CLIENT_POST_RPC |
 *			  SERVER_PRE-OP | SERVER_POST-OP
 *	<escape_code> := <C-statement> 
 *
 * Operation attribute ASYNC requests generation of _SEND and _RECEIVE
 * variant support for an operation. Attribute NOREPLY indicates that
 * no reply message (and thus no return value) is expected.
 *
 * Parameter attributes IN, OUT and INOUT are self-explanatory.
 *
 * Parameter RPC attributes are concatenated to the parameter attribute.
 * _RPC_VAR_ARRAY signals a variable length in-line array for which the
 * following parameter must have attribute _RPC_VAR_ARRAY_LENGTH. This is
 * required to assist MIG interface definitions in which the length parameter
 * is implicit. _RPC_VAR_ARRAY_OUT_OF_LINE signals a variable array passed
 * out-of-line (i.e. in virtual memory seperate from the message body).
 *
 * Escapes allow special-purpose code to be inserted into key points of
 * RPC stubs. CLIENT_ENTRY is immediately on entry into a client RPC stub;
 * CLIENT_PRE-RPC is immediately before the RPC call is issued in the client
 * stub and CLIENT_POST-RPC is immediately on return from the RPC.
 * SERVER_PRE-OP is immediately before calling the (local) operation on
 * the server-side of the RPC and SERVER_POST-OP is immediately upon return
 * from the operation.
 *
 * This file is pre-processed by the C pre-processor as a preliminary step
 * in the generation process. Hence, C comments and conditional compilation
 * directives (including macros) may be used.
 */
operation reap {
	parameter IN struct vproc *v	/* vproc being waited for */
	parameter INOUT pid_t *pgid	/* conditional pgrp membership reqd */
	parameter IN int options	/* flags determining semantics */
	parameter OUT int *state	/* run stat of proc */
	parameter OUT int *wstat	/* wait status of exited vproc */
	parameter OUT struct rusage_dev *ru /* resource usage */
}
operation reap_multi ASYNC {
	parameter IN struct vproc *v	/* vproc being waited for */
	parameter IN struct vproc *ve	/* vproc of elder process */
	parameter IN pid_t pgid		/* conditional pgrp membership reqd */
	parameter IN int options	/* flags determining semantics */
	parameter OUT_RPC_VAR_ARRAY_OUT_OF_LINE long_reap_stat_array_t *state
					/* state of vprocs */
	parameter OUT_RPC_VAR_ARRAY_LENGTH u_int *state_len
	parameter OUT struct rusage_dev *ru /* resource usage */
	parameter IN int pid_idx	/* index of this pid in list */
	parameter IN_RPC_VAR_ARRAY_OUT_OF_LINE long_pid_array_t pid_list
					/* full list of pids being reaped */
	parameter IN_RPC_VAR_ARRAY_LENGTH u_int num_pids
					/* number of pids in list */
	parameter IN int base_idx
	parameter IN int proc_count
	parameter INOUT msg_handle_t *h	/* message reference handle */
	escape SERVER_POST-OP
		/*
		 * This frees the out-of-line memory containing the pid list
		 * after the operation is complete on the server-side.
		 */
		(void) vm_deallocate(mach_task_self(),
				     (vm_address_t) pid_list,
				     (unsigned int) (num_pids*sizeof(pid_t)));
	end_escape
}
operation add_child_to_parent {
	parameter IN struct vproc *pp	/* parent vproc containing list */
	parameter IN struct vproc *v	/* child vproc to be added */
	parameter IN int state		/* child state - zombie or stopped */
}
operation rmv_child_from_parent {
	parameter IN struct vproc *pp	/* parent vproc containing list */
	parameter IN struct vproc *v	/* child vproc to be removed */
}
operation reassign_child {
	parameter IN struct vproc *v	/* vproc of process being reassigned */
	parameter IN struct vproc *vfp	/* foster parent for process */
	parameter IN int flag		/* indicates if parent is exiting */
}
operation add_orphan_to_foster_list {
	parameter IN struct vproc *pfp	/* foster parent containing list */
	parameter IN struct vproc *ovp	/* orphan vproc */
}
operation rmv_orphan_from_foster_list {
	parameter IN struct vproc *fpp	/* foster parent containing list */
	parameter IN struct vproc *ovp	/* orphan vproc rusage is from */
	parameter IN struct rusage_dev *ru /* resource usage */
}
operation setsid {
	parameter IN struct vproc *v	/* vproc becoming session leader */
}
operation setpgid {
	parameter IN struct vproc *v	/* vproc of process to assign */
	parameter IN struct vproc *g	/* vproc of group to be assigned to */
	parameter IN pid_t pid		/* caller's pid */
	parameter IN pid_t sid		/* caller's sid */
}
operation add_pgrp_list {
	parameter IN struct vproc *g	/* vproc of pgrp leader */
	parameter IN struct vproc *v	/* vproc being added to pgrp */
	parameter INOUT int *seqno	/* pgrp signal sequence num */
}
operation rmv_pgrp_list {
	parameter IN struct vproc *g	/* vproc of pgrp leader */
	parameter IN struct vproc *v	/* vproc being removed from pgrp */
	parameter IN pid_t pp		/* v's parent if pp to be informed */
}
operation add_session_list {
	parameter IN struct vproc *s	/* vproc of session leader */
	parameter IN struct vproc *g	/* vproc being added to session */
}
operation rmv_session_list {
	parameter IN struct vproc *s	/* vproc of session leader */
	parameter IN struct vproc *g	/* vproc being removed from session */
}
operation adjust_job_control_count {
	parameter IN struct vproc *g	/* vproc pgrp leader being adjusted */
	parameter IN int cause		/* PV_ADD PV_SUBTRACT or PV_EXIT */
}
operation proc_nice {
	parameter IN struct vproc *v	/* vproc being queried */
	parameter INOUT int *nice	/* output param, nice value */
	parameter IN uid_t effuid	/* effective id of calling process */
	parameter IN uid_t realuid	/* real id of calling process */
	parameter IN int flag		/* VPROC_SET VPROC_GET, HAS_PRIV */
}
operation pgrp_nice {
	parameter IN struct vproc *g	/* vproc or pgrp leader vproc */
	parameter INOUT int *nice	/* output param, nice value */
	parameter IN uid_t effuid	/* effective id of calling process */
	parameter IN uid_t realuid	/* real id of calling process */
	parameter IN int flag		/* VPROC_SET or VPROC_GET */
}
operation sigproc {
	parameter IN struct vproc *v	/* vproc being signaled */
	parameter IN int signo		/* signal to post */
	parameter IN int signo2		/* second signal to post */
	parameter IN int arg		/* argument (for SIGMIGRATE) */
	parameter IN uid_t effuid	/* effective id of sending process */
	parameter IN uid_t realuid	/* real id of sending process */
	parameter IN pid_t pid		/* sender's pid id */
	parameter IN pid_t sid		/* sender's session id */
	parameter IN int flag		/* affects signaling action */
	escape CLIENT_ENTRY
		/* 
		 * If called with a flag bit indicating that the
		 * caller cannot block, we must defer the operation by
		 * asynchronously requesting it to be performed by the
		 * local server. Note we pass the target pid rather
		 * than vproc port or vproc address because the former
		 * may require a remote send right fetch and the
		 * latter is not guaranteed to remain valid until the
		 * server attempts to use it.
		 */
		if (flag&VPROC_CANT_BLOCK) {
			extern mach_port_t this_node_tnc_server_port;
			(void) cli_tnc_sigproc_async(this_node_tnc_server_port,
						     v->vp_pid, signo, arg,
						     effuid, realuid, pid, sid,
						     flag & ~VPROC_CANT_BLOCK);
			return(ESUCCESS); 
       		}
	end_escape
}
operation sigproc_multi ASYNC {
	parameter IN struct vproc *v	/* vproc being signaled */
	parameter IN int signo		/* signal to post */
	parameter IN int signo2		/* second signal to post */
	parameter IN int arg		/* argument (for SIGMIGRATE) */
	parameter IN uid_t effuid	/* effective id of sending process */
	parameter IN uid_t realuid	/* real id of sending process */
	parameter IN pid_t pid		/* sender's pid id */
	parameter IN pid_t sid		/* sender's session id */
	parameter IN int flag		/* affects signaling action */
	parameter IN int pid_idx	/* index of this pid in list */
	parameter IN_RPC_VAR_ARRAY_OUT_OF_LINE long_pid_array_t pid_list
					/* full list of pids being signaled */
	parameter IN_RPC_VAR_ARRAY_LENGTH int num_pids
					/* number of pids in list */
	parameter INOUT msg_handle_t *h /* message reference handle */
	escape SERVER_POST-OP
		/*
		 * This frees the out-of-line memory containing the pid list
		 * after the operation is complete on the server-side.
		 */
		(void) vm_deallocate(mach_task_self(),
				     (vm_address_t) pid_list,
				     (unsigned int) (num_pids*sizeof(pid_t)));
	end_escape
}
operation sigpgrp {
	parameter IN struct vproc *g	/* group vproc being signaled */
	parameter IN int signo		/* signal to post */
	parameter IN int arg		/* argument (for SIGMIGRATE) */
	parameter IN uid_t effuid	/* effective id of sending process */
	parameter IN uid_t realuid	/* real id of sending process */
	parameter IN pid_t pid		/* sender's pid id */
	parameter IN pid_t sid		/* sender's session id */
	parameter OUT int *nproc	/* number of processes signaled */
	parameter IN int flag		/* affects signaling action */
	escape CLIENT_ENTRY
		/*
		 * If called with a flag bit indicating that the
		 * caller cannot block, we must defer the operation by
		 * asynchronously requesting it to be performed by the
		 * local server. Note we pass the target pid rather
		 * than vproc port or vproc address because the former
		 * may require a remote send right fetch and the
		 * latter is not guaranteed to remain valid until the
		 * server attempts to use it.
		 */
		if (flag&VPROC_CANT_BLOCK) {
			extern mach_port_t this_node_tnc_server_port;
			(void) cli_tnc_sigpgrp_async(this_node_tnc_server_port,
       	                                	     g->vp_pid, signo, arg,
						     effuid, realuid, pid, sid,
						     flag & ~VPROC_CANT_BLOCK);
			return(ESUCCESS); 
		}
	end_escape
}
operation get_attr {
	parameter IN struct vproc *v	/* process being queried */
	parameter OUT pid_t *ppid	/* returns vp_ppid field */
	parameter OUT pid_t *pgrp	/* returns vp_pgrp field */
	parameter OUT pid_t *sid	/* returns vp_sid field */
	parameter OUT uid_t *uid	/* returns vp_uid field */
	parameter OUT uid_t *ruid	/* returns vp_ruid field */
	parameter OUT boolean_t *job_control /* returns if job control applies */
	parameter OUT boolean_t *has_sctty /* returns if session tty control */
	parameter IN boolean_t lock_flag /* obtain attr under lock control */
}
operation set_attr {
	parameter IN struct vproc *v	/* process whose parent is changing */
	parameter IN pid_t pp_pgrp	/* parent's new process group id */
	parameter IN pid_t pp_sid	/* parent's new session id */
}
operation report_state {
	parameter IN struct vproc *p	/* parent of vproc changing state */
	parameter IN struct vproc *v	/* vproc changing state */
	parameter IN int state		/* selects zombie/stop/unstop */
}
operation report_state_elder {
	parameter IN struct vproc *e	/* elder of vproc changing state */
	parameter IN struct vproc *v	/* vproc changing state */
	parameter IN int state		/* selects zombie/stop/unstop */
}
operation ctty_getattr {
	parameter IN struct vproc *s	/* session of process being queried */
	parameter OUT pid_t *t_pgid	/* foreground pgrp */
	parameter OUT dev_t *dev	/* controlling device */
	parameter OUT node_t *node	/* controlling terminal node */
}
operation set_ctty {
	parameter IN struct vproc *v	/* process setting ctty */
	parameter IN int cttynode	/* controlling tty node */
	parameter IN int flag		/* VPROC_SET or VPROC_CLEAR */
}
operation ptrace {
	parameter IN struct vproc *v	/* traced child process */
	parameter IN int req		/* trace request code */
	parameter IN vm_address_t addr	/* memory address */
	parameter IN int data		/* data to write */
	parameter OUT int *retval	/* returned data */
}
operation get_task_port {
	parameter IN struct vproc *v	/* vproc being queried */
	parameter IN uid_t effuid	/* effective id of calling process */
	parameter IN int flag		/* flag indicating privileges */
	parameter OUT mach_port_move_send_t *task_port /* task port for vproc */
}
operation terminal_sigpgrp {
	parameter IN struct vproc *v	/* vproc whose group being signaled */
	parameter IN int signo		/* signal to post */
}
operation table_get {
	parameter IN struct vproc *v	/* vproc being queried */
	parameter IN int id		/* id of action to take */
	parameter OUT_RPC_VAR_ARRAY_OUT_OF_LINE char_array *buffer
					/* address of address of buffer used */
	parameter INOUT_RPC_VAR_ARRAY_LENGTH u_int *bufferlen
					/* length of buffer */
	parameter IN u_int lel		/* length of each element in buffer */
	escape CLIENT_PRE-RPC
		/*
		 * Special case to deal with the out-of-line memory used.
		 */
		{
			char *uaddr;
			uaddr = *(buffer);
	end_escape
	escape CLIENT_POST-RPC
			if (_rval == ESUCCESS) { 
				_rval = copyout(*(buffer), uaddr, *(bufferlen));
				(void) vm_deallocate(mach_task_self(),
						     (vm_address_t) *(buffer),
						     *(bufferlen));
			}
			*(buffer) = uaddr;
		}
	end_escape
	escape SERVER_PRE-OP
		{
			kern_return_t ret;
			ret = vm_allocate(mach_task_self(),
					  (vm_address_t *) buffer,
					  (unsigned int) lel,
					  TRUE);
			if (ret != KERN_SUCCESS) {
				*buffer = NULL;
				*bufferlen = 0;
				*_rval = EAGAIN;
				return(KERN_SUCCESS);
			}
			unix_master();
	end_escape
	escape SERVER_POST-OP
			unix_release();
			if (_error != ESUCCESS) {
				(void) vm_deallocate(mach_task_self(),
						     (vm_address_t) *buffer,
						     (unsigned int) lel);
				*buffer = NULL;
				*bufferlen = 0;
			} else
				*bufferlen = lel;
		}
	end_escape
}
operation table_set {
	parameter IN struct vproc *v	/* vproc being queried */
	parameter IN int id		/* id of action to take */
	parameter IN_RPC_VAR_ARRAY_OUT_OF_LINE char_array buffer
					/* address of buffer used */
	parameter IN_RPC_VAR_ARRAY_LENGTH u_int bufferlen
					/* length of buffer */
	parameter IN u_int lel		/* length of each element in buffer */
	escape SERVER_PRE-OP
		{
			unix_master();
	end_escape
	escape SERVER_POST-OP
			unix_release();
			(void) vm_deallocate(mach_task_self(),
					     (vm_address_t) buffer,
					     (unsigned int) bufferlen);
		}
	end_escape
}
operation get_fork_signals {
	parameter IN struct vproc *v	/* vproc being queried (parent's) */
	parameter OUT u_int *sigset	/* recent pgrp sigs parent has rcvd */
	parameter OUT long *sigmigarg	/* extra arg for SIGMIGRATE */
	parameter OUT int *seqno	/* new seqno to go with new signals */
}
#ifdef	NX
operation nx_get_info {
	parameter IN struct vproc *v    /* target process */
	parameter OUT APPLINFO_T *applinfo /* Application info */
	parameter OUT_RPC_VAR_ARRAY_OUT_OF_LINE LP_MAP_T   *nodelist
					/* Partition node list */
	parameter OUT_RPC_VAR_ARRAY_LENGTH int    *nodelistcnt
					/* Size of partition node list */
	parameter IN int     flag
	parameter IN uid_t   euid
	parameter OUT int    *err
}
operation nx_get_flag {
	parameter IN struct vproc *v	/* vproc whose pvpflag we want */
	parameter OUT u_int *pvpflag	/* pvp_flags of the proc */
}
operation nx_get_p_flag {
	parameter IN struct vproc *v	/* vproc whose pvpflag we want */
	parameter OUT u_int *pflag	/* p_flag of the proc */
}
#endif	/* NX */

#ifdef PARACORE
operation pgrp_core {
	parameter IN struct vproc *pgrp	/* group leader vproc of application */
	parameter IN pid_t fault_pid	/* faulting process' pid */
	parameter IN mach_port_copy_send_t cred		/* faulting process' cred */
	parameter OUT int *action	/* specifies how to proceed */
	parameter OUT mach_port_copy_send_t *coredir	/* coredir vnode */
	parameter OUT mach_port_copy_send_t *rootdir	/* rootdir vnode */
	parameter OUT boolean_t	*ports_copied	/* for ports deallocation */
	parameter OUT boolean_t	*first_faulting	/* first faulting process */
	escape SERVER_POST-OP
		/*
		 * Deallocate the copied credential port.
		 */
		if ( cred != MACH_PORT_NULL ) {
			kern_return_t ret;
			
			ret = mach_port_deallocate(mach_task_self(),
				cred);
			if ( ret != KERN_SUCCESS ) {
				printf("pgrp_core: Could not deallocate credential port (error=0x%x)\n", ret);
			}
		}
		
		/* for ports deallocation */
		*ports_copied = TRUE;
	end_escape
}

operation pgrp_abort {
	parameter IN struct vproc *pgrp	/* group leader vproc of application */
	parameter IN pid_t pid		/* caller's pid */
	parameter IN boolean_t abort_self	/* abort caller also ? */
	parameter IN int action_others	/* desired action for other members */
	parameter IN mach_port_copy_send_t coredir	/* coredir vnode */
	parameter IN mach_port_copy_send_t rootdir	/* rootdir vnode */
}
	
operation proc_abort {
	parameter IN struct vproc *proc	/* vproc to abort */
	parameter IN int action		/* desired action */
	parameter IN mach_port_copy_send_t coredir	/* coredir vnode */
	parameter IN mach_port_copy_send_t rootdir	/* rootdir vnode */
	escape SERVER_PRE-OP
		{
			struct proc *p = PVP(PVP_DESTINATION)->pvp_pproc;
			/*
			 * Make sure the proc is still alive.
			 */
			if (pproc_hold(p, PVP_DESTINATION->vp_pid) == ESUCCESS) {
				/* 
				 * Mark ports as copied in utask
				 * for ports deallocation.
				 */
				p->p_utask.uu_ports_copied = TRUE;
				pproc_release(p, PVP_DESTINATION->vp_pid);
			}
		}
	end_escape
}

operation proc_abort_multi ASYNC {
	parameter IN struct vproc *v	/* vproc to abort */
	parameter IN int action		/* desired action */
	parameter IN mach_port_copy_send_t coredir	/* coredir vnode */
	parameter IN mach_port_copy_send_t rootdir	/* rootdir vnode */
	parameter IN int pid_idx	/* index of this pid in list */
	parameter IN_RPC_VAR_ARRAY_OUT_OF_LINE long_pid_array_t pid_list
					/* full list of pids being signaled */
	parameter IN_RPC_VAR_ARRAY_LENGTH int num_pids
					/* number of pids in list */
	parameter INOUT msg_handle_t *h /* message reference handle */
	escape SERVER_PRE-OP
		{
			struct proc *p = PVP(PVP_DESTINATION)->pvp_pproc;
			/*
			 * Make sure the proc is still alive.
			 */
			if (pproc_hold(p, PVP_DESTINATION->vp_pid) == ESUCCESS) {
				/* 
				 * Mark ports as copied in utask
				 * for ports deallocation.
				 */
				p->p_utask.uu_ports_copied = TRUE;
				pproc_release(p, PVP_DESTINATION->vp_pid);
			}
		}
	end_escape
	escape SERVER_POST-OP
		/*
		 * This frees the out-of-line memory containing the pid list
		 * after the operation is complete on the server-side.
		 */
		(void) vm_deallocate(mach_task_self(),
				     (vm_address_t) pid_list,
				     (unsigned int) (num_pids*sizeof(pid_t)));
	end_escape
}
#endif /* PARACORE */
