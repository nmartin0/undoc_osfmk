/*
 * Types for TNC server-to-server calls.
 */

#include <tnc/tnc_types_gen.h>

type	caddr_t		= int;
type	u_int		= int;
type	dev_t		= int;
type	uid_t		= int;

type	rval_t		= int;

type	rstat_t		= array[RSTAT_SIZE] of int;

type	command_t	= array[*:PATH_LENGTH] of char;
type	pid_array_t	= array[*:MAX_VPROC_LIST_SIZE] of pid_t;
type	vproc_array_t	= array[*:MAX_VPROC_LIST_SIZE] of mach_port_copy_send_t;
type	stat_array_t	= array[*:MAX_VPROC_LIST_SIZE] of int;
type	long_pid_array_t   = ^array[*] of pid_t;
type	long_vproc_array_t = ^array[*] of mach_port_copy_send_t;
type	long_stat_array_t  = ^array[*] of int;
type	long_reap_stat_array_t  = ^array[*] of rstat_t;

type	procset_t	= array[PROCSET_SIZE] of int;
type	rf_data_t	= array[RFORK_DATA_SIZE] of int;
type	mi_data_t	= array[MIGRATE_DATA_SIZE] of int;
type	re_data_t	= array[REXEC_DATA_SIZE] of int;
type	mmap_struct_t	= struct[MMAP_STRUCT_SIZE] of int;
type	command_name_t	= array[MAXCOMLEN_SIZE] of char;
type	logname_t	= array[MAXLOGNAME_SIZE] of char;

type	mmap_struct_array_t = array[*:TNC_MMAP_ARRAY_SIZE]
						of mmap_struct_t;
type	mmap_port_array_t   = array[*:TNC_MMAP_ARRAY_SIZE]
						of mach_port_move_send_t;

type	cred_cache_array_t = array[*:CREDENTIALS_CACHE_ARRAY_SIZE] of node_t;
type	long_cred_cache_array_t = ^array[*] of node_t;
type	long_node_array_t = ^array[*] of node_t;

type	blob_t		   = array [*:MAX_BLOB_SIZE] of char;
type	rright_array_t = array [*:RELOC_PORT_ARRAY_SIZE]
	       					of mach_port_move_receive_t;
type	sright_array_t = array [*:RELOC_PORT_ARRAY_SIZE]
	       					of mach_port_move_send_t;

type	msg_handle_t	= int;

import <tnc/tnc_types.h>;
