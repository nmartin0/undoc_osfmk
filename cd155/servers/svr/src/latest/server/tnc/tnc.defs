 * 
 * Revision 3.42  92/10/01  10:33:25  roman
 * Fix up types for clean compilation under gcc.
 * 
 * Revision 3.41  92/09/29  08:19:24  roman
 * Add new pvproc ops for adding and removing foster children.
 * Change name of set_state pvproc op to report_state.
 * Get rid of setpinit and killall pvproc ops.
 * Add terminal_sigpgrp pvproc op.
 * Parameter changes to ctty_getattr pvproc op.
 * Change many explicit RPCs to be private virtual process system
 * 	operations (pvpsops).
 * 
 * Revision 3.40  92/09/28  13:26:36  klh
 * Add creds port and FIFO fs vnode send-right arguments to remote_fifo_death().
 * (klh for mjl)
 * 
 * Revision 3.39  92/08/17  18:10:37  mjl
 * Add RPC for reporting FIFO storage site death to FIFO filesystem site.
 * 
 * Revision 3.38  92/08/08  01:46:18  jdh
 * mjl added support for relocating send rights as well as receive
 * rights -- jdh
 * 
 * Revision 3.37  92/07/09  11:33:46  roman
 * Add internode message to set up emulator exception addresses on
 * nodes other than the node that runs the init process.
 * 
 * Revision 3.36  92/07/08  09:10:49  roman
 * Fix prior RCS comment.
 * 
 * Revision 3.35  92/06/26  14:02:30  chrisp
 * [Bug #27] Job control handling fixed for migrated/rexec'd processes - pvproc
 * 	field pvp_jobc added to MIG.
 * [Bug #35] Zombie or stopped children assigned to a new parent must have
 * 	their correct state recorded in their vproc on the parent's node.
 * 
 * Revision 3.34  92/06/17  17:47:43  klh
 * 	Revision 3.33  92/06/11  16:09:32  mjl
 * 	Added tnc_relocate_inline() for pipe/FIFO/socket relocation.
 * 
 * Revision 3.33  92/06/17  09:18:21  roman
 * [Bug 0026] New vproc op VPOP_GET_TASK_PORT() added to get task_by_pid() 
 *	system call working.
 * [Bug 0026] Add remote operation to get pid_by_task() system call working.
 * 
 * Revision 3.32  92/06/05  15:40:08  roman
 * Fix code for mmap'ed files following v0.89 integration.
 * 
 * Revision 3.31  92/05/07  10:48:17  chrisp
 * [Bug #10] Add optional second signal number to PVPOP_SIGPROC().
 * 
 * Revision 3.30  92/05/06  13:34:44  chrisp
 * [Bug #9] Transfer pvproc field pvp_cttynode on rexec()/migrate().
 * 
 * Revision 3.29  92/04/30  10:50:31  chrisp
 * [Bug #3] PVPOP_REAP() now takes an additional parameter requiring a reaped
 * 	process belong to a specified pgid (if not WAIT_ANY); error ESRCH
 * 	is returned if this is not the case and the process is not reaped.
 * 	This avoids VPOP_WAIT() using PVPOP_GETATTR() for each child's pgid.
 * 
 * Revision 3.28  92/04/22  13:47:29  chrisp
 * Delete session vproc port parameter for rfork() no longer required by
 * 	alteration of session vproc existence rules.
 * 
 * Revision 3.27  92/04/20  15:16:35  chrisp
 * Change MOVE_SEND to COPY_SEND for returned remote_port parameter of
 * 	tnc_get_vproc_port to correct the stealing of the remote servers
 * 	send right for the requested vproc.
 * 
 * Revision 3.26  92/04/02  17:04:08  klh
 * 	Fix log messages
 * 
 * Revision 3.25  92/04/01  16:20:52  roman
 * Minor formatting fixes.
 *
 * Revision 3.24  92/03/27  11:34:04  roman
 * Changes to incorporate OSF/1 AD v0.8.5.1 handling of credentials and
 *	root and current working directories.
 *
 * Revision 3.23  92/03/18  14:09:18  roman
 * Change RCS log comments to match rest of files.
 *
 * Revision 3.22  92/03/12  15:44:32  roman
 * Change all passing of ports to use explicit COPY_SENDs, rather
 * 	than allowing implicit Mach COPY_SENDs.
 * Change serveral MOVE_SENDs of vproc ports to be COPY_SENDs, to track
 * 	the new assumption that a vproc send right is always present
 * 	on a node.
 * Add new pvproc op set_attr.
 * Delete pvproc op resign_pgrp.
 * Simpleroutines tnc_sigproc_async and tnc_sigpgrp_async added to defer remote
 * 	signalling to be performed asynchronously by the local tnc server.
 * 
 * Revision 3.21  92/03/03  16:27:49  chrisp
 * Add ADD_CHILD_TO_PARENT.
 * Add tnc_set_ctty() and tnc_ctty_getattr.
 * Change parameters for ctty operations.
 * 
 * Revision 3.20  92/02/26  08:18:19  roman
 * Add new routine get_tnc_port() for getting a "special" TNC port that
 * has been set up on another node.
 * 
 * Revision 3.19  92/02/14  09:01:32  roman
 * Add additional output parameter of error status, so that error status can
 * 	be returned, yet output parameters can still be used.
 * 
 * Revision 3.18  92/01/30  16:31:26  roman
 * Change root and current directory ports to MOVE_SEND for rexecve
 * server-to-server communication.
 * 
 * Revision 3.17  92/01/30  14:19:48  chrisp
 * Add ptrace.
 * 
 * Revision 3.16  92/01/28  16:26:27  roman
 * Add current directory and root directory ports to rexecve() interface.
 * 
 * Revision 3.15  92/01/15  16:52:12  roman
 * Get rid of extraneous rval parameter. The return value of each routine
 * is sufficient.
 * 
 * Revision 3.14  92/01/15  10:33:21  chrisp
 * Define tnc_remote_vproc_free to enable an origin node vproc to be
 * freed upon remote destruction.
 * 
 * Revision 3.13  92/01/10  15:14:01  yazz
 * Credentials (.74 version) merge.  Some passed Snd rts are being created
 * via MAKE_SEND instead of MOVE_SEND, reducing the work of the task who
 * had responsibility for explicitly creating the extra Snd rt (and for
 * deallocating it on error).  Some port names, instead of actual ports,
 * are being passed when possible, for greater efficiency.
 * 
 * Revision 3.12  92/01/07  18:27:10  roman
 * Add declarations of mmap structures that are now passed from server to
 * server during rfork/rexec/migrate.
 * 
 * Revision 3.11  92/01/03  11:15:32  chrisp
 * Added kill3 arg for remote signalling.
 * 
 * Revision 3.10  91/12/24  10:37:00  roman
 * Change rfork interface to pass back vproc port using MOVE_SEND rather than
 * COPY_SEND.
 * 
 * Revision 3.9  91/12/20  16:51:49  chrisp
 * SETPGID becomes a PVPOP. PVPROC_FLAG goes. Orphan pgrp handling revamped.
 * 
 * Revision 3.8  91/12/19  11:11:28  chrisp
 * Add child zombie and stopped status for migrate and rexec.
 * 
 * Revision 3.7  91/12/16  09:32:47  roman
 * Chnages to get rexec to work for the first time.
 * 
 * Revision 3.6  91/12/13  11:06:50  roman
 * Add MiG interfaces to support rfork/rexec/migrate.
 * 
 * Revision 3.5  91/12/04  08:07:26  chrisp
 * Add set_ctty and ctty_getattr.
 * 
 * Revision 3.4  91/11/26  11:59:57  chrisp
 * setsid added as a pvpop.
 * 
 * 
 * Revision 3.3  91/11/22  10:27:38  chrisp
 * set_stop_state becomes report_state with 3 params.
 * 
 * Revision 3.2  91/10/30  14:18:12  roman
 * Add rval parameter to routines that accidently left them off.
 * 
 * Revision 3.1  91/10/25  10:45:52  roman
 * Added MiG definitions for remote pvproc operations.
 * 
 * Revision 3.0  91/10/21  13:18:48  roman
 * TNC Mach IPC messages. Initial submission.
 *
 */

subsystem tnc 199000;

UserPrefix cli_;
ServerPrefix svr_;

#include <mach/mach_types.defs>
#include <uxkern/bsd_types.defs>
#include <tnc/tnc_types.defs>
#include <uxkern/fsvr_types.defs>
#ifdef NX
/*
 * Receive timeout if the remote node doesn't respond .
 */
waittime rpc_waittime;

#include <nx/nx_types.defs>
#endif /* NX */

simpleroutine tnc_sigproc_async(
		server_port	: mach_port_t;
	in	target_pid	: pid_t;
	in	signo		: int;
	in	arg		: int;
	in	effuid		: uid_t;
	in	realuid		: uid_t;
	in	pid		: pid_t;
	in	sid		: pid_t;
	in	flag		: int);

simpleroutine tnc_sigpgrp_async(
		server_port	: mach_port_t;
	in	target_pid	: pid_t;
	in	signo		: int;
	in	arg		: int;
	in	effuid		: uid_t;
	in	realuid		: uid_t;
	in	pid		: pid_t;
	in	sid		: pid_t;
	in	flag		: int);

/*
 * Include generated RPC declarations for pvproc and pvps ops.
 */
#include <tnc/tnc_gen.defs>

/*
 * Server to server remote tasking calls.
 */

routine rfork(
		server_port	: mach_port_t;
	out	rval		: int;
	in	pp_vproc_port	: mach_port_t = MACH_MSG_TYPE_COPY_SEND;
	in	pgrp_vproc_port	: mach_port_t = MACH_MSG_TYPE_COPY_SEND;
	in	root_port	: mach_port_t = MACH_MSG_TYPE_MOVE_SEND;
	in	cwd_port	: mach_port_t = MACH_MSG_TYPE_MOVE_SEND;
	in	pp_task		: task_t;
	out	ch_task		: task_t = MACH_MSG_TYPE_MOVE_SEND;
	out	ch_thread	: thread_t = MACH_MSG_TYPE_MOVE_SEND;
	out	ch_vproc_port	: mach_port_t = MACH_MSG_TYPE_COPY_SEND;
	out	ch_pidp		: pid_t;
	in	ch_state	: thread_state_t;
	in	vproc_port_name	: mach_port_t = MACH_MSG_TYPE_PORT_NAME;
	in	cred_port_name	: mach_port_t = MACH_MSG_TYPE_PORT_NAME;
	in	rf_data		: rf_data_t;	
	in	mmap_structs	: mmap_struct_array_t;
	in	mmap_pagers	: mmap_port_array_t;
	in	command_name	: command_name_t;
	in	logname		: logname_t
#ifdef NX
;       in      applinfo        : APPLINFO_T;
        in      nodelist        : LP_MAP_T
#endif /* NX */
#ifdef PARACORE
;	in	exec_root_port	: mach_port_t = MACH_MSG_TYPE_MOVE_SEND;
	in	exec_cwd_port	: mach_port_t = MACH_MSG_TYPE_MOVE_SEND;
        in      exec_prg_name   : path_name_t
#endif /* PARACORE */
	);	

routine migrate(
		server_port	: mach_port_t;
	out	rval		: int;
	in	cur_pid		: pid_t;
	in	is_pgrpleader	: int;
	in	cur_vproc_port	: mach_port_t = MACH_MSG_TYPE_MOVE_RECEIVE;
	in	vproc_port_name	: mach_port_t = MACH_MSG_TYPE_PORT_NAME;
	in	cur_proc_port	: mach_port_t = MACH_MSG_TYPE_MOVE_RECEIVE;
	in	cur_cred_port	: mach_port_t = MACH_MSG_TYPE_MOVE_RECEIVE;
	in	cred_port_name	: mach_port_t = MACH_MSG_TYPE_PORT_NAME;
	in	cred_cache	: cred_cache_array_t;
	in	pp_vproc_port	: mach_port_t = MACH_MSG_TYPE_COPY_SEND;
	in	fpp_vproc_port	: mach_port_t = MACH_MSG_TYPE_COPY_SEND;
	in	pgrp_vproc_port	: mach_port_t = MACH_MSG_TYPE_COPY_SEND;
	in	sess_vproc_port	: mach_port_t = MACH_MSG_TYPE_COPY_SEND;
	in	child_pid	: pid_array_t;
	in	child_port	: vproc_array_t;
	in	child_stat	: stat_array_t;
	in	foster_child_pid : pid_array_t;
	in	foster_child_port : vproc_array_t;
	in	pgrp_member_pid	: pid_array_t;
	in	pgrp_member_port: vproc_array_t;
	in	sess_member_pid	: pid_array_t;
	in	sess_member_port: vproc_array_t;
	in	pgrp_jobc	: int;
	in	cttynode	: node_t;
	in	root_port	: mach_port_t = MACH_MSG_TYPE_MOVE_SEND;
	in	cwd_port	: mach_port_t = MACH_MSG_TYPE_MOVE_SEND;
	in	old_task	: task_t;
	in	old_task_name	: task_t = MACH_MSG_TYPE_PORT_NAME;
	in	cur_state	: thread_state_t;
	in	mi_data		: mi_data_t;
	in	mmap_structs	: mmap_struct_array_t;
	in	mmap_pagers	: mmap_port_array_t;
	in	command_name	: command_name_t;
	in	logname		: logname_t;
	out	ret_vproc_port	: mach_port_t = MACH_MSG_TYPE_MOVE_RECEIVE;
	out	ret_cred_port	: mach_port_t = MACH_MSG_TYPE_MOVE_RECEIVE;
	out	ret_proc_port	: mach_port_t = MACH_MSG_TYPE_MOVE_RECEIVE
#ifdef NX
;       in      applinfo        : APPLINFO_T;
        in      nodelist        : LP_MAP_T
#endif /* NX */
#ifdef PARACORE
;	in	exec_root_port	: mach_port_t = MACH_MSG_TYPE_MOVE_SEND;
	in	exec_cwd_port	: mach_port_t = MACH_MSG_TYPE_MOVE_SEND;
        in      exec_prg_name   : path_name_t
#endif /* PARACORE */
	);

routine migrate_long(
		server_port	: mach_port_t;
	out	rval		: int;
	in	cur_pid		: pid_t;
	in	is_pgrpleader	: int;
	in	cur_vproc_port	: mach_port_t = MACH_MSG_TYPE_MOVE_RECEIVE;
	in	vproc_port_name	: mach_port_t = MACH_MSG_TYPE_PORT_NAME;
	in	cur_proc_port	: mach_port_t = MACH_MSG_TYPE_MOVE_RECEIVE;
	in	cur_cred_port	: mach_port_t = MACH_MSG_TYPE_MOVE_RECEIVE;
	in	cred_port_name	: mach_port_t = MACH_MSG_TYPE_PORT_NAME;
	in	cred_cache	: long_cred_cache_array_t;
	in	pp_vproc_port	: mach_port_t = MACH_MSG_TYPE_COPY_SEND;
	in	fpp_vproc_port	: mach_port_t = MACH_MSG_TYPE_COPY_SEND;
	in	pgrp_vproc_port	: mach_port_t = MACH_MSG_TYPE_COPY_SEND;
	in	sess_vproc_port	: mach_port_t = MACH_MSG_TYPE_COPY_SEND;
	in	child_pid	: long_pid_array_t;
	in	child_port	: long_vproc_array_t;
	in	child_stat	: long_stat_array_t;
	in	foster_child_pid : long_pid_array_t;
	in	foster_child_port : long_vproc_array_t;
	in	pgrp_member_pid	: long_pid_array_t;
	in	pgrp_member_port: long_vproc_array_t;
	in	sess_member_pid	: long_pid_array_t;
	in	sess_member_port: long_vproc_array_t;
	in	pgrp_jobc	: int;
	in	cttynode	: node_t;
	in	root_port	: mach_port_t = MACH_MSG_TYPE_MOVE_SEND;
	in	cwd_port	: mach_port_t = MACH_MSG_TYPE_MOVE_SEND;
	in	old_task	: task_t;
	in	old_task_name	: task_t = MACH_MSG_TYPE_PORT_NAME;
	in	cur_state	: thread_state_t;
	in	mi_data		: mi_data_t;
	in	mmap_structs	: mmap_struct_array_t;
	in	mmap_pagers	: mmap_port_array_t;
	in	command_name	: command_name_t;
	in	logname		: logname_t;
	out	ret_vproc_port	: mach_port_t = MACH_MSG_TYPE_MOVE_RECEIVE;
	out	ret_cred_port	: mach_port_t = MACH_MSG_TYPE_MOVE_RECEIVE;
	out	ret_proc_port	: mach_port_t = MACH_MSG_TYPE_MOVE_RECEIVE
#ifdef NX
;       in      applinfo        : APPLINFO_T;
        in      nodelist        : LP_MAP_T
#endif /* NX */
#ifdef PARACORE
;	in	exec_root_port	: mach_port_t = MACH_MSG_TYPE_MOVE_SEND;
	in	exec_cwd_port	: mach_port_t = MACH_MSG_TYPE_MOVE_SEND;
        in      exec_prg_name   : path_name_t
#endif /* PARACORE */
	);

routine rexecve(
		server_port	: mach_port_t;
	out	rval		: int;
	in	fname		: path_name_t;
	in	arg_addr	: int;
	in	arg_size	: int;
	in	arg_count	: int;
	in	env_count	: int;
	in	char_count	: int;
	in	cur_pid		: pid_t;
	in	is_pgrpleader	: int;
	in	cur_vproc_port	: mach_port_t = MACH_MSG_TYPE_MOVE_RECEIVE;
	in	vproc_port_name	: mach_port_t = MACH_MSG_TYPE_PORT_NAME;
	in	cur_proc_port	: mach_port_t = MACH_MSG_TYPE_MOVE_RECEIVE;
	in	cur_cred_port	: mach_port_t = MACH_MSG_TYPE_MOVE_RECEIVE;
	in	cred_port_name	: mach_port_t = MACH_MSG_TYPE_PORT_NAME;
	in	cred_cache	: cred_cache_array_t;
	in	pp_vproc_port	: mach_port_t = MACH_MSG_TYPE_COPY_SEND;
	in	fpp_vproc_port	: mach_port_t = MACH_MSG_TYPE_COPY_SEND;
	in	pgrp_vproc_port	: mach_port_t = MACH_MSG_TYPE_COPY_SEND;
	in	sess_vproc_port	: mach_port_t = MACH_MSG_TYPE_COPY_SEND;
	in	child_pid	: pid_array_t;
	in	child_port	: vproc_array_t;
	in	child_stat	: stat_array_t;
	in	foster_child_pid : pid_array_t;
	in	foster_child_port : vproc_array_t;
	in	pgrp_member_pid	: pid_array_t;
	in	pgrp_member_port: vproc_array_t;
	in	sess_member_pid	: pid_array_t;
	in	sess_member_port: vproc_array_t;
	in	pgrp_jobc	: int;
	in	cttynode	: node_t;
	in	root_port	: mach_port_t = MACH_MSG_TYPE_MOVE_SEND;
	in	cwd_port	: mach_port_t = MACH_MSG_TYPE_MOVE_SEND;
	in	old_task	: task_t;
	in	old_task_name	: task_t = MACH_MSG_TYPE_PORT_NAME;
	in	cur_state	: thread_state_t;
	in	re_data		: re_data_t;
	in	mmap_structs	: mmap_struct_array_t;
	in	mmap_pagers	: mmap_port_array_t;
	in	logname		: logname_t;
	out	ret_vproc_port	: mach_port_t = MACH_MSG_TYPE_MOVE_RECEIVE;
	out	ret_cred_port	: mach_port_t = MACH_MSG_TYPE_MOVE_RECEIVE;
	out	ret_proc_port	: mach_port_t = MACH_MSG_TYPE_MOVE_RECEIVE
#ifdef NX
;       in      applinfo        : APPLINFO_T;
        in      nodelist        : LP_MAP_T
#endif /* NX */
	);

