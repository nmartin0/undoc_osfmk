	in	mmap_structs	: mmap_struct_array_t;
	in	mmap_pagers	: mmap_port_array_t;
	in	logname		: logname_t;
	out	ret_vproc_port	: mach_port_t = MACH_MSG_TYPE_MOVE_RECEIVE;
