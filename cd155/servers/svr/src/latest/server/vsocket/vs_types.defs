/*
 * Types for MI server-to-server calls.
 */

#include "vsocket/vs_types_gen.h"
import <vsocket/vs_types.h>;

/* From vs_types.h ... */
type	server_list_t	= array [*:MAX_SERVERS]		of mach_port_t;
type	sockaddr_t	= array [*:SOCKADDRSIZE]	of char;
type	sockaddr_in_t	= array [SOCKADDR_INSIZE]	of char;
type	vs_optstring_t	= array [*:VS_MAXOPTLEN]	of char;
type	ioctl_data_t	= array [*:VS_MAXIOCLEN]	of char;
type	node_list_t 	= array [*:MAX_SERVERS]		of node_t;
type	port_list_t	= array [*:MAX_SERVERS]		of mach_port_t;

type	chouse_key_p_t	= array [CHSKEYSIZE]	of char;
type	ifreq_p_t	= array [IFREQSIZE]	of char;
type	iface_info_p_t	= array [IFINFOSIZE]	of char;
