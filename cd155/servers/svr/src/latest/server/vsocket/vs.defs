subsystem nsrv 199200;

ServerPrefix nsrv_;

#include <mach/mach_types.defs>
#include <uxkern/bsd_types.defs>
#include <vsocket/vs_types.defs>

/* skip the first five since they are in mi.defs */
skip;

skip;

skip;

skip;

skip;

/*
 *  Clearinghouse RPC definitions
 */

routine	if_addr_update(
		server_port		: mach_port_t;
	in	key			: chouse_key_p_t;
	in	iface_flags		: int;
	in	command			: int;
	in	request			: ifreq_p_t;
	in	netserv_port		: mach_port_t;
	out	iface_info		: iface_info_p_t;
	out	rval			: int);

routine	if_confirm_update(
		server_port		: mach_port_t;
	in	key			: chouse_key_p_t;
	in	command			: int;
	in	request			: ifreq_p_t;
	out	rval			: int);

routine	if_addr_reset(
		server_port		: mach_port_t;
	in	key			: chouse_key_p_t;
	in	iface_info		: iface_info_p_t;
	out	rval			: int);

routine if_lookup(
		server_port		: mach_port_t;
	in	node			: node_t;
	in	family			: int;
	in	address			: sockarg_t;
	out	hosts			: server_list_t;
	out	rval			: int);

routine if_list(
		server_port		: mach_port_t;
	in	node			: node_t;
	in	nel			: int;
	out	numns			: int;
	out	rel			: int;
	out	ret_nodes		: node_list_t;
	out	ret_ports		: port_list_t;
	out	rval			: int);

routine if_get_nearest_server(
		server_port		: mach_port_t;
	in	family			: int;
	in	node			: node_t;
	out	server_node		: node_t;
	out	nsrv_port		: mach_port_t =
						MACH_MSG_TYPE_COPY_SEND);
routine if_get_server_by_route(
		server_port		: mach_port_t;
	in	node			: node_t;
	in	address			: sockarg_t;
	out	ret_node		: node_t;
	out	ret_port		: mach_port_t =
						MACH_MSG_TYPE_COPY_SEND);

routine if_assign_port_number(
		server_port		: mach_port_t;
	in	domain			: int;
	in	protocol		: short;
	out	port			: short;
	out	rval			: int);

/*
 *  Network virtual socket RPC definitions
 */

routine	r_vs_socreate (
		server_port		: mach_port_t;
	in	cred_port		: mach_port_t;
	in	callback_port		: mach_port_t;
	in	transid			: transaction_id_t;
	in	dom			: int;
	out	socket_port		: mach_port_t;
	in	sock_type		: int;
	in	protocol		: int;
	out	socket_addr		: int;
	out	rval			: int);

routine r_vs_soclose (
		server_port		: mach_port_t;
	in	cred_port		: mach_port_t;
	in	transid			: transaction_id_t;
	out	rval			: int);

routine r_vs_soconnect(
		server_port		: mach_port_t;
	in	cred_port		: mach_port_t;
	in	transid			: transaction_id_t;
	in	address			: sockarg_t;
	out	state			: int;
	out	rval			: int);

routine r_vs_sosetopt(
		server_port		: mach_port_t;
	in	cred_port		: mach_port_t;
	in	transid			: transaction_id_t;
	in	level			: int;
	in	name			: int;
	in	value			: vs_optstring_t;
	out	rval			: int);
		
routine r_vs_sobind(
		server_port		: mach_port_t;
	in	cred_port		: mach_port_t;
	in	transid			: transaction_id_t;
	in	address			: sockarg_t;
	out	rval			: int);

routine r_vs_sosend_short(
		server_port		: mach_port_t;
	in	cred_port		: mach_port_t;
	in	transid			: transaction_id_t;
	in	vssend_flag		: int;
	in	address			: sockarg_t;
	in	flags			: int;
	in	data			: small_char_array;
	out	sent			: int;
	out	rval			: int);

routine r_vs_sosend_long(
		server_port		: mach_port_t;
	in	cred_port		: mach_port_t;
	in	transid			: transaction_id_t;
	in	vssend_flag		: int;
	in	address			: sockarg_t;
	in	flags			: int;
	in	data			: char_array;
	out	sent			: int;
	out	rval			: int);

routine r_vs_sogetopt(
		server_port		: mach_port_t;
	in	cred_port		: mach_port_t;
	in	transid			: transaction_id_t;
	in	level			: int;
	in	optname			: int;
	out	mtype			: int;
	out	addr			: small_char_array;
	out	rval			: int );

routine r_vs_sorecv(
		server_port		: mach_port_t;
	in	cred_port		: mach_port_t;
	in	transid			: transaction_id_t;
	in	len			: int;
	out	address			: sockarg_t;
	inout	flags			: int;
	out	data			: char_array, dealloc;
	out	rval			: int);

routine r_vs_solisten(
		server_piort		: mach_port_t;
	in	cred_port		: mach_port_t;
	in	transid			: transaction_id_t;
	in	backlog			: int;
	out	accpet_ok		: boolean_t;
	out	rval			: int);

routine r_vs_sodequeue(
		server_port		: mach_port_t;
	in	cred_port		: mach_port_t;
	in	callback_port		: mach_port_t;
	out	sock_port		: mach_port_t;
	in	transid			: transaction_id_t;
	out	address			: sockarg_t;
	in	compat_43		: int;
	out	rval			: int);

routine r_vs_ioctl(
		server_port		: mach_port_t;
	in	cred_port		: mach_port_t;
	in	transid			: transaction_id_t;
	in	cmd			: int;
	in	in_data			: ioctl_data_t;
	out	out_data		: ioctl_data_t;
	out	rval			: int);

routine r_vs_global_ioctl(
		server_port		: mach_port_t;
	in	cred_port		: mach_port_t;
	in	transid			: transaction_id_t;
	in	cmd			: int;
	in	len			: int;
	out	data			: char_array, dealloc;
	out	rval			: int);

routine r_vs_sogetaddr(
		server_port		: mach_port_t;
	in	cred_port		: mach_port_t;
	in	transid			: transaction_id_t;
	in	which			: int;
	in	compat_43		: int;
	out	address			: sockarg_t;
	out	rval			: int);

simpleroutine r_m_vs_wakeup (
		server_port		: mach_port_t;
	in	target_socket		: mach_port_t 
						= MACH_MSG_TYPE_PORT_NAME;
	in	index			: int;
	in	cmd			: int;
	in	state			: int;
	in	soerror			: int;
	in	qlen			: int;
	in	isreadable		: int);

simpleroutine r_vs_getstate_delay(
		server_port		: mach_port_t;
	in	cred_port		: mach_port_t;
	in	target_port		: mach_port_t 
						= MACH_MSG_TYPE_PORT_NAME;
	in	index			: int;
	in	state			: int;
	in	soerror			: int;
	in	qlen			: int);

routine r_vs_soshutdown(
		server_port		: mach_port_t;
	in	how			: int );

simpleroutine r_vs_soreadable(
		server_port		: mach_port_t;
	in	cred_port		: mach_port_t;
	in	target_port		: mach_port_t 
						= MACH_MSG_TYPE_PORT_NAME;
	in	index			: int);
	
routine r_vs_soreserve(
		server_port		: mach_port_t;
	in	sendcc			: int;
	in	recvcc			: int;
	out	result			: int);

routine r_vs_select_dequeue_getstate(
		server_port		: mach_port_t;
	in	cred_port		: mach_port_t;

	/* select dequeue related parameters */
	in	sel_id			: int;
	in	sel_flags		: int;
	in	index			: int;

	/* getstate related parameters */
	out	state			: int;
	out	soerror			: int;
	out	qlen			: int;
	out	isreadable		: int);

routine r_vs_select_check(
		server_port		: mach_port_t;
	in	cred_port		: mach_port_t;
	in	transid			: transaction_id_t;
	in	events			: short;
	inout	revents			: short;
	out	state			: int;
	out	soerror			: int;
	out	qlen			: int;
	out	isreadable		: int);

routine r_vs_select_enqueue(
		server_port		: mach_port_t;
	in	cred_port		: mach_port_t;
	in	file_port		: mach_port_t
						= MACH_MSG_TYPE_MOVE_SEND;
	in	sel_id			: int;
	in	transid			: transaction_id_t;
	in	index			: int;
	in	events			: int;
	in	again			: boolean_t;
	out	ret_file_port		: mach_port_t
						= MACH_MSG_TYPE_MOVE_SEND);

simpleroutine r_vs_scrub_remote_selects(
		socket_port		: mach_port_t;
	in	cred_port		: mach_port_t;
	in	dead_delay_port_name	: mach_port_t
						= MACH_MSG_TYPE_PORT_NAME);
