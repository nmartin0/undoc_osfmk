/*
 * Types for MI server-to-server calls.
 */

#include "vsocket/mi_types_gen.h"
import <vsocket/mi_types.h>;

type	mi_pkt_data_t	= array[*:MI_PKT_SIZE] of char;
type	ifname_t	= array [IFNAMSIZ] of char;
type	node_t		= int;




