subsystem mi 199200;

UserPrefix r_;
ServerPrefix S_;

#include <mach/mach_types.defs>
#include <uxkern/bsd_types.defs>
#include <vsocket/mi_types.defs>
#include <vsocket/vs_types.defs>

routine mi_advertise_iface(
		server_port	: mach_port_t;
	in	iface_id	: int;
	in	netserv_node	: node_t;
	in	netserv_port	: mach_port_t;
	in	command		: int;
	in	request		: ifreq_p_t;
	in	iface_info	: iface_info_p_t;
	out	rval		: int);

routine mi_create_link(
		server_port	: mach_port_t;
	in	client_node	: node_t;
	in	control_port	: mach_port_t;
	in	data_port	: mach_port_t;
	out	remote_ctrlport	: mach_port_t;
	out	remote_dataport	: mach_port_t;
	out	rval		: int);

simpleroutine mi_pkt(
		server_port	: mach_port_t;
	in	data		: mi_pkt_data_t);

