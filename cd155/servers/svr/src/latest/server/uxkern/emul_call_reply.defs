/*
 * Async reply interface for selected emulator calls
 */
subsystem emul_reply 	105100;		/* matches reply in emul_call.defs */

UserPrefix	uemul_;
ServerPrefix	semul_;

#include <mach/mach_types.defs>
#include <uxkern/bsd_types.defs>

type reply_port_t = polymorphic | MACH_MSG_TYPE_PORT_SEND_ONCE
	ctype: mach_port_t;


skip; /* forward_signal */

skip; /* token_revoke */

simpleroutine release_state_reply(
		reply_port		: reply_port_t;
	in	return_code		: kern_return_t);

skip; /* at_barrier */

