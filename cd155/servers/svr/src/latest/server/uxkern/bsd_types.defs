/*
 * Types for BSD kernel interface.
 */

#include <mach/std_types.defs>
#include <mach/mach_types.defs>
#include <uxkern/bsd_types_gen.h>

type	small_char_array= array[*:SMALL_ARRAY_LIMIT] of char;
type	char_array	= ^array[] of char;
type	path_name_t	= array[*:PATH_LENGTH] of char;
type	timeval_t	= struct[2] of int;
type	timeval_2_t	= array[2] of timeval_t;
type	timeval_3_t	= array[3] of timeval_t;
type    stat_t          = struct[STAT_SIZE] of int;
type	sockarg_t	= array[*:128] of char;
type	fd_set		= struct[FD_SET_LIMIT] of int;
type	entry_array	= array[*:16] of vm_address_t;
type	gidset_t	= array[GROUPS_LIMIT] of int;
type	rlimit_t	= array[2] of int;
type	sigvec_t	= struct[3] of int;
type	sigaction_t	= struct[3] of int;
type	sigstack_t	= struct[2] of int;
type	timezone_t	= struct[2] of int;
type	itimerval_t	= struct[4] of int;
type	hostname_t	= (MACH_MSG_TYPE_STRING_C, 8*HOST_NAME_LIMIT);
type	domainname_t	= (MACH_MSG_TYPE_STRING_C, 8*DOMAIN_NAME_LIMIT);
type	cfname_t	= (MACH_MSG_TYPE_STRING_C, 8*64);
type	cred_t		= struct[CRED_SIZE] of int;
type	rusage_t	= struct[RUSAGE_SIZE] of int;
type	rlimit_array_t	= array[RLIMIT_TOTAL_ARRAY_SIZE] of int;
type	rusage_dev_t	= array[RUSAGE_DEV_SIZE] of int;
type	pid_t		= int;

type	auxv_type_t	= struct[2] of int;
type	auxv_mig_t	= array[*:10] of auxv_type_t;
type	auxv_strings_t	= array[*:4096] of char;

type	transaction_id_t = int;
type    devstat_t       = struct[5] of int;
type    acct_t          = struct[10] of int;
#ifdef	PFS
type    pfs_stat_t		= struct[5] of int;
type	esize_t			= struct[2] of int;
#endif

#ifdef	TNC

/* types used for rforkmulti() system call */
type	node_t		     = int;
type	multi_int_array_t    = array[*:MAX_MULTI_LIST_SIZE] of int;
type	multi_pid_array_t    = array[*:MAX_MULTI_LIST_SIZE] of pid_t;
type	multi_node_array_t   = array[*:MAX_MULTI_LIST_SIZE] of node_t;
type	multi_name_array_t   = array[*:MAX_MULTI_LIST_SIZE] 
						of mach_port_name_t;
type	multi_port_array_t   = array[*:MAX_MULTI_LIST_SIZE] 
						of mach_port_copy_send_t;
type	multi_vproc_array_t  = array[*:MAX_MULTI_LIST_SIZE] 
						of mach_port_move_send_t;

type	long_multi_int_array_t    = ^array[*] of int;
type	long_multi_pid_array_t    = ^array[*] of pid_t;
type	long_multi_node_array_t   = ^array[*] of node_t;
type	long_multi_name_array_t   = ^array[*] of mach_port_name_t;
type	long_multi_port_array_t   = ^array[*] of mach_port_copy_send_t;
type	long_multi_vproc_array_t  = ^array[*] of mach_port_move_send_t;

#ifdef  CHKPNT
type	chkpnt_file_state_t	  = ^array[*] of char;

#endif  CHKPNT
#endif	/* TNC */

/*
 * Types for System V IPC under TNC.
 */
type	long			   = int;	/* "long" not on std list */
type	key_t			   = long;

import <uxkern/bsd_types.h>;
