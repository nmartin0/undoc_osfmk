#include <mach/std_types.defs>
#include <mach/mach_types.defs>
#include <uxkern/bsd_types_gen.h>

type	fhandle_t	= struct[FHANDLE_SIZE] of char;
type	statfs_t	= struct[STATFS_SIZE] of char;
type	vattr_t		= struct[VATTR_SIZE] of char;

type	nfs_args_t	= struct[NFS_ARGS_SIZE] of char;
type	sockaddr_in_t	= struct[SOCKADDR_IN_SIZE] of char;
type	nfsv2fh_t	= struct[NFSV2FH_SIZE] of char;;

type	off_t		= unsigned;
type	size_t		= unsigned;
type	iomode_t	= unsigned;

import <uxkern/fsvr_types.h>;
