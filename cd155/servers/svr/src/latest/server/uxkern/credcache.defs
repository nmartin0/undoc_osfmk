#include <mach/mach_types.defs>
#include <uxkern/bsd_types.defs>

uimport <uxkern/server_mach_msg.h>;

subsystem	credcache		104000;

serverprefix	cc_;

routine cache_getrusage(
		filesever_port	: mach_port_t;
	in	cport		: mach_port_t;
	in	pid		: int;
	out	blkin		: int;
	out	blkout		: int;
	in	deallocate	: int);

routine cache_update(
		filesever_port	: mach_port_t;
	in	cport		: mach_port_t;
	in	pid		: int;
	in	rcred		: cred_t;
	in	cmask		: int;
	in	sid		: int;
	in	pgid		: int;
	in	flimcur		: int;
	in	flimmax		: int;
	in	ruid		: int;
	in	rgid		: int;
	in	task		: mach_port_t = MACH_MSG_TYPE_COPY_SEND);
