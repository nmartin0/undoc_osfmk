/*
 * MiG interface definitions for fast path IO.
 */

subsystem fsvr2 12000;

#include <mach/mach_types.defs>
#include <uxkern/bsd_types.defs>
#include <uxkern/fsvr_types.defs>
#if     !defined(_EMULATOR)
#include <fullserver.h>
#endif

uimport <uxkern/server_mach_msg.h>;

ServerPrefix	S_ ;

#if	FULLSERVER

routine fsvr_read_at_offset(
		fl_port		: mach_port_t;
	in	creds_port	: mach_port_t;
	inout	response_id	: unsigned;
	in	offset		: off_t;
	in	length		: size_t;
	out	data		: char_array, dealloc);

routine fsvr_write_at_offset(
		fl_port		: mach_port_t;
	in	creds_port	: mach_port_t;
	inout	response_id	: unsigned;
	in	offset		: off_t;
	in	data		: char_array;
	out	amount		: size_t);

#else	/* FULLSERVER */
skip;
skip;
#endif	FULLSERVER
