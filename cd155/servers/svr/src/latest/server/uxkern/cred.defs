#include <mach/mach_types.defs>
#include <uxkern/bsd_types.defs>

uimport <uxkern/server_mach_msg.h>;

subsystem	cred		103000;

serverprefix	cm_;

routine cred_info_request(
		cred_port	: mach_port_t;
	in	node		: int;
	out	cred		: cred_t;
	out	cmask		: int;
	out	pid		: int;
	out	sid		: int;
	out	pgid		: int;
	out	task		: task_t = MACH_MSG_TYPE_COPY_SEND;
	out	flimcur		: int;
	out	flimmax		: int;
	out	ruid		: int;
	out	rgid		: int);

