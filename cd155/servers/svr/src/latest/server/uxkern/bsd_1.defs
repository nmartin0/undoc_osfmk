/*
 * IPC interface for selected UX server functions.
 */
subsystem bsd_1		101000;

#include <mach/mach_types.defs>
#include <uxkern/bsd_types.defs>

/*
 * Calls that need the current thread
 */
routine bsd_execve(
		proc_port	: mach_port_t;
	out	interrupt	: boolean_t;
	in	fname		: path_name_t;
	out	cfname		: cfname_t;
	out	cfarg		: cfname_t;
	out	entry		: entry_array;
	out	auxv_structs	: auxv_mig_t;
	out	auxv_strings	: auxv_strings_t;
	out	traced		: boolean_t);

routine bsd_exec_args_set(
		proc_port	: mach_port_t;
	out	interrupt	: boolean_t;
	in	argp		: int;
	in	arg_size	: int;
	in	envp		: int;
	in	env_size	: int);

routine bsd_fork(
		vproc_port	: mach_port_t;
	out	interrupt	: boolean_t;
	in	new_node	: int;
	in	new_state	: thread_state_t;
	out	new_task	: task_t = MACH_MSG_TYPE_MOVE_SEND;
	out	new_thread	: thread_t = MACH_MSG_TYPE_MOVE_SEND;
	out	new_vproc	: mach_port_t = MACH_MSG_TYPE_COPY_SEND;
	out	new_cred	: mach_port_t;
#if ! defined(SLL) && ! defined(SLLCOMPAT)
	out	child_pid	: int);
#else /* ! SLL && ! SLLCOMPAT */
	out	child_pid	: int;
	in	vproc_port_name	: mach_port_t = MACH_MSG_TYPE_PORT_NAME;
	in	cred_port_name	: mach_port_t = MACH_MSG_TYPE_PORT_NAME;
	in	force_local	: boolean_t;
	out	was_rfork	: boolean_t);
#endif /* ! SLL && ! SLLCOMPAT */

routine bsd_take_signal(
		proc_port	: mach_port_t;
	out	interrupt	: boolean_t;
	out	old_mask	: int;
	out	old_onstack	: int;
	out	sig		: int;
	out	code		: int;
	out	handler		: int;
	out	new_sp		: int);

routine bsd_sigreturn(
		proc_port	: mach_port_t;
	out	interrupt	: boolean_t;
	in	old_on_stack	: int;
	in	old_sigmask	: int);

routine	bsd_getrusage(
		proc_port	: mach_port_t;
	out	interrupt	: boolean_t;
	in	which		: int;
	out	rusage		: rusage_t);

routine bsd_mmap(
                proc_port       : mach_port_t;
        in      file_port       : mach_port_t;
        in      addr            : int;
        in      len             : int;
        in      prot            : int;
        in      flags           : int;
        in      off             : int;
        out     rval            : int;
        out     interrupt       : boolean_t);

#ifdef	COMPAT_43
routine	bsd_osend_short(
		file_port	: mach_port_t;
	in	cred_port	: mach_port_t;
	in	transaction_id	: transaction_id_t;
	in	flags		: int;
	in	data		: small_char_array;
	out	amount_written	: int);

routine	bsd_osend_long(
		file_port	: mach_port_t;
	in	cred_port	: mach_port_t;
	in	transaction_id	: transaction_id_t;
	in	flags		: int;
	in	data		: char_array;
	out	amount_written	: int);
#endif	/* COMPAT_43 */

routine	bsd_sendto_short(
		file_port	: mach_port_t;
	in	cred_port	: mach_port_t;
	in	transaction_id	: transaction_id_t;
	in	flags		: int;
	in	to		: sockarg_t;
	in	data		: small_char_array;
	out	amount_written	: int);

routine	bsd_sendto_long(
		file_port	: mach_port_t;
	in	cred_port	: mach_port_t;
	in	transaction_id	: transaction_id_t;
	in	flags		: int;
	in	to		: sockarg_t;
	in	data		: char_array;
	out	amount_written	: int);

/* These routines are only used #if PROFILING, but since the emulator doesn't
   know about the server's configuration we have to include them always and
   define dummies when they are not used.  */
routine	bsd_profil_set(
		proc_port	: mach_port_t;
	out	interrupt	: boolean_t;
	in	buff		: int;
	in   	bufsiz		: int;
	in	offset		: int;
	in	scale		: int);

routine	bsd_profil_get(
		proc_port	: mach_port_t;
	out	interrupt	: boolean_t;
	out	uaddr		: int;
	out 	out_addr	: char_array, dealloc);
/* End of #if PROFILING routines. */

/*
 * Glue between MACH and U*X
 */
routine	bsd_task_by_pid(
		proc_port	: mach_port_t;
	out	interrupt	: boolean_t;
	in	pid		: int;
	out	task		: task_t = MACH_MSG_TYPE_PORT_SEND);

routine	bsd_pid_by_task(
		proc_port	: mach_port_t;
	out	interrupt	: boolean_t;
	in	task		: task_t;
	out	pid		: int;
	out	command		: path_name_t;
	out	rval		: int);

routine bsd_get_bootstrap_process_ports(
		proc_port	: mach_port_t;
	out	vproc_port	: mach_port_t = MACH_MSG_TYPE_COPY_SEND;
	out	cred_port	: mach_port_t);

routine bsd_get_bootstrap_directories(
		proc_port	: mach_port_t;
	out	rootdir_port	: mach_port_t = MACH_MSG_TYPE_COPY_SEND;
	out	currentdir_port	: mach_port_t = MACH_MSG_TYPE_COPY_SEND);

routine bsd_setports(
		proc_port	: mach_port_t;
	in	cwd_port	: mach_port_t;
	in	root_port	: mach_port_t;
	out	interrupt	: boolean_t);

/*
 * More IO
 */
#ifdef	COMPAT_43
routine	bsd_orecv_short(
		file_port	: mach_port_t;
	in	cred_port	: mach_port_t;
	in	transaction_id	: transaction_id_t;
	in	flags		: int;
	in	len		: int;
	out	data		: small_char_array);

routine	bsd_orecv_long(
		file_port	: mach_port_t;
	in	cred_port	: mach_port_t;
	in	transaction_id	: transaction_id_t;
	in	flags		: int;
	in	len		: int;
	out	data		: char_array, dealloc);
#endif	/* COMPAT_43 */

#ifdef	COMPAT_43
routine	bsd_orecvfrom_short(
		file_port	: mach_port_t;
	in	cred_port	: mach_port_t;
	in	transaction_id	: transaction_id_t;
	in	flags		: int;
	in	len		: int;
	out	from_addr	: sockarg_t;
	out	data		: small_char_array);

routine	bsd_orecvfrom_long(
		file_port	: mach_port_t;
	in	cred_port	: mach_port_t;
	in	transaction_id	: transaction_id_t;
	in	flags		: int;
	in	len		: int;
	out	from_addr	: sockarg_t;
	out	data		: char_array, dealloc);
#endif	/* COMPAT_43 */


routine	bsd_recvfrom_short(
		file_port	: mach_port_t;
	in	cred_port	: mach_port_t;
	in	transaction_id	: transaction_id_t;
