routine bsd_rfork(
		vproc_port	: mach_port_t;
	out	interrupt	: boolean_t;
	in	new_node	: int;
	in	new_state	: thread_state_t;
	in	vproc_port_name	: mach_port_t = MACH_MSG_TYPE_PORT_NAME;
	in	cred_port_name	: mach_port_t = MACH_MSG_TYPE_PORT_NAME;
	out	new_task	: task_t = MACH_MSG_TYPE_MOVE_SEND;
	out	new_thread	: thread_t = MACH_MSG_TYPE_MOVE_SEND;
	out	child_pid	: int);

routine bsd_migrate(
		vproc_port	: mach_port_t;
	out	interrupt	: boolean_t;
	in	new_node	: int;
	in	new_state	: thread_state_t;
	in	vproc_port_name	: mach_port_t = MACH_MSG_TYPE_PORT_NAME;
	in	cred_port_name	: mach_port_t = MACH_MSG_TYPE_PORT_NAME;
	in	orig_task_name	: task_t = MACH_MSG_TYPE_PORT_NAME);

routine bsd_rexecve(
		vproc_port	: mach_port_t;
	out	interrupt	: boolean_t;
	in	fname		: path_name_t;
	in	new_node	: int;
	in	new_state	: thread_state_t;
	in	vproc_port_name	: mach_port_t = MACH_MSG_TYPE_PORT_NAME;
	in	cred_port_name	: mach_port_t = MACH_MSG_TYPE_PORT_NAME;
	in	orig_task_name	: task_t = MACH_MSG_TYPE_PORT_NAME;
	in	arg_addr	: int;
	in	arg_size	: int;
	in	arg_count	: int;
	in	env_count	: int;
	in 	char_count	: int);

routine bsd_rexecve_arrival(
		proc_port	: mach_port_t;
	out	interrupt	: boolean_t;
	out	fname		: path_name_t;
	out	arg_addr	: vm_address_t;
	out	arg_size	: vm_size_t;
	out	arg_count	: int;
	out	env_count	: int;
	out 	char_count	: int;
	out	cfname		: cfname_t;
	out	cfarg		: cfname_t;
	out	entry		: entry_array;
	out	auxv_structs	: auxv_mig_t;
	out	auxv_strings	: auxv_strings_t;
	out	traced		: boolean_t);

