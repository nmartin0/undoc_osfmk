	out	rval_array	: multi_int_array_t;
	out	ch_pid_array	: multi_pid_array_t;
	in	fp_name_array	: multi_name_array_t;
	in	fp_right_array	: multi_port_array_t;
	in	ch_state	: thread_state_t;
