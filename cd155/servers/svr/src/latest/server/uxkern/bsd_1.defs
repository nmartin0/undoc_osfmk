	in	fp_name_array	: long_multi_name_array_t;
	in	fp_right_array	: long_multi_port_array_t;
	in	ch_state	: thread_state_t;
	in	vproc_port_name	: mach_port_t = MACH_MSG_TYPE_PORT_NAME;
	in	cred_port_name	: mach_port_t = MACH_MSG_TYPE_PORT_NAME);

