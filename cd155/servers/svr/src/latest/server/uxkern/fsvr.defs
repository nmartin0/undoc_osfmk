		cwd_port	: mach_port_t;
	in	creds_port	: mach_port_t;
	in	transaction_id	: transaction_id_t;
	in	root_port	: mach_port_t;
	in	path_name	: path_name_t;
	in	mode		: int;
	in	crt_mode	: int;
	in	flags		: int;
	in	revoke_port	: mach_port_send_t;
	out	fl_port		: mach_port_t = MACH_MSG_TYPE_MOVE_SEND;
#ifdef PFS
	inout	iomode		: iomode_t;
#else
	out	iomode		: iomode_t;
#endif /* PFS */
	out	token		: mach_port_t = MACH_MSG_TYPE_MOVE_SEND;
	out	offset		: int;
	out	length		: int;
	out	mem_obj		: mach_port_t = MACH_MSG_TYPE_MOVE_SEND);

