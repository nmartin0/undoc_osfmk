subsystem fsvr 11000;

#if	!defined(_EMULATOR)
#include <remote_proc.h>
#include <fullserver.h>
#include <ufs.h>
#include <nfs.h>
#endif
#include <mach/mach_types.defs>
#include <uxkern/bsd_types.defs>
#include <uxkern/fsvr_types.defs>

uimport <uxkern/server_mach_msg.h>;

ServerPrefix	S_ ;

/*
 * The message prototypes are divided into four (4) classes:
 *	1) Single pathname system call messages,
 *	2) Dual pathname system call messages,
 *	3) Calls which do not take a pathname (e.g. read),
 *	and
 *	4) Support messages that do not directly correspond to
 *		a system call.
 *
 * For pathname operations, the length of the pathname is passed as a
 *	parameter immediately after the pointer to the character array.
 *	This parameter is generated by MiG and is, therefore, not
 *	declared in any of the RPC declarations here.
 *
 * The message sequence number is passed as part of the message header; any
 *	function needing it will have to fetch it from there.
 *
 * Standard args to each call:
 *	creds_port	----	credentials reference (setup by task mgr.)
 *	transaction_id	----	per-task transaction id for interruptibility.
 *
 * Other ports used:
 *	cwd_port	----	current working directory port.
 *	root_port	----	root directory port.
 *	fl_port		----	file structure port used to work with an open
 *					file.
 *	vn_port		----	vnode port.
 *	mnt_port	----	mount structure port.
 * 	dev_port	----	special file vnode port for device pathname
 *					translation.
 *	fsvr_port	----	fileservice port.
 */

skip;				/* Reserve id #0 */

#if	FULLSERVER
/* SINGLE PATHNAME OPS */
routine fsvr_access(
		cwd_port	: mach_port_t;
	in	creds_port	: mach_port_t;
	in	transaction_id	: transaction_id_t;
	in	root_port	: mach_port_t;
	in	path_name	: path_name_t;
#ifdef	PFS
	in	mode		: int;
	out	iomode		: iomode_t);
#else
	in	mode		: int);
#endif

routine fsvr_chdir(
		cwd_port	: mach_port_t;
	in	root_port	: mach_port_t;
	in	creds_port	: mach_port_t;
	in	transaction_id	: transaction_id_t;
	in	path_name	: path_name_t;
	out	vn_port		: mach_port_t = MACH_MSG_TYPE_MOVE_SEND);

routine fsvr_chmod(
		cwd_port	: mach_port_t;
	in	creds_port	: mach_port_t;
	in	transaction_id	: transaction_id_t;
	in	root_port	: mach_port_t;
	in	path_name	: path_name_t;
#ifdef	PFS
	in	mode		: int;
	out	iomode		: iomode_t);
#else	
	in	mode		: int);
#endif

routine fsvr_chown(
		cwd_port	: mach_port_t;
	in	creds_port	: mach_port_t;
	in	transaction_id	: transaction_id_t;
	in	root_port	: mach_port_t;
	in	path_name	: path_name_t;
	in	uid		: int;
#ifdef	PFS
	in	gid		: int;
	out	iomode		: iomode_t);
#else
	in	gid		: int);
#endif

routine fsvr_chroot(
		cwd_port	: mach_port_t;
	in	root_port	: mach_port_t;
	in	creds_port	: mach_port_t;
	in	transaction_id	: transaction_id_t;
	in	path_name	: path_name_t;
	out	vn_port		: mach_port_t = MACH_MSG_TYPE_MOVE_SEND);

routine fsvr_getfh(
		cwd_port	: mach_port_t;
	in	creds_port	: mach_port_t;
	in	transaction_id	: transaction_id_t;
	in	root_port	: mach_port_t;
	in	path_name	: path_name_t;
	out	fhandleb	: fhandle_t);

routine fsvr_open(
		cwd_port	: mach_port_t;
	in	creds_port	: mach_port_t;
	in	transaction_id	: transaction_id_t;
	in	root_port	: mach_port_t;
	in	path_name	: path_name_t;
	in	mode		: int;
	in	crt_mode	: int;
	out	fl_port		: mach_port_t = MACH_MSG_TYPE_MOVE_SEND;
#ifdef	PFS
	inout	iomode		: iomode_t);
#else
	out	iomode		: iomode_t);
#endif

routine fsvr_mknod(
		cwd_port	: mach_port_t;
	in	creds_port	: mach_port_t;
	in	transaction_id	: transaction_id_t;
	in	root_port	: mach_port_t;
	in	path_name	: path_name_t;
	in	mode		: int;
	in	dev		: int);

routine fsvr_readlink(
		cwd_port	: mach_port_t;
	in	creds_port	: mach_port_t;
	in	transaction_id	: transaction_id_t;
	in	root_port	: mach_port_t;
	in	path_name	: path_name_t;
	in	count		: int;
	out	buf		: small_char_array);


routine fsvr_rmknod(
		cwd_port	: mach_port_t;
	in	creds_port	: mach_port_t;
	in	transaction_id	: transaction_id_t;
	in	root_port	: mach_port_t;
	in	path_name	: path_name_t;
	in	mode		: int;
	in	dev		: int;
	in	node		: int);

routine fsvr_stat(				/* stat/lstat */
		cwd_port	: mach_port_t;
	in	creds_port	: mach_port_t;
	in	transaction_id	: transaction_id_t;
	in	root_port	: mach_port_t;
	in	path_name	: path_name_t;
	in	follow		: boolean_t;
#ifdef	PFS
	out	stat		: stat_t;
	out	iomode		: iomode_t);
#else
	out	stat		: stat_t);
#endif

routine fsvr_statfs(
		cwd_port	: mach_port_t;
	in	creds_port	: mach_port_t;
	in	transaction_id	: transaction_id_t;
	in	root_port	: mach_port_t;
	in	path_name	: path_name_t;
	out	statfsb		: statfs_t);

routine fsvr_devstat(
		cwd_port	: mach_port_t;
	in	creds_port	: mach_port_t;
	in	transaction_id	: transaction_id_t;
	in	root_port	: mach_port_t;
	in	path_name	: path_name_t;
	out	devsb		: devstat_t);

routine fsvr_truncate(
		cwd_port	: mach_port_t;
	in	creds_port	: mach_port_t;
	in	transaction_id	: transaction_id_t;
	in	root_port	: mach_port_t;
	in	path_name	: path_name_t;
#ifdef	PFS
	in	length		: size_t;
	out	iomode		: iomode_t);
#else
	in	length		: size_t);
#endif

routine fsvr_unmount(
		cwd_port	: mach_port_t;
	in	creds_port	: mach_port_t;
	in	transaction_id	: transaction_id_t;
	in	root_port	: mach_port_t;
	in	path_name	: path_name_t;
	in	flags		: int);

routine fsvr_utimes(
		cwd_port	: mach_port_t;
	in	creds_port	: mach_port_t;
	in	transaction_id	: transaction_id_t;
	in	root_port	: mach_port_t;
	in	path_name	: path_name_t;
	in	times		: timeval_2_t;
#ifdef	PFS
	in	current_time	: boolean_t;
	out	iomode		: iomode_t);
#else
	in	current_time	: boolean_t);
#endif

/* DUAL PATHNAME OPS */
routine fsvr_link(
		from_cwd_port	: mach_port_t;
	in	creds_port	: mach_port_t;
	in	transaction_id	: transaction_id_t;
	in	root_port	: mach_port_t;
	in	from_path_name	: path_name_t;
	in	to_cwd_port	: mach_port_t;
	in	to_path_name	: path_name_t);

