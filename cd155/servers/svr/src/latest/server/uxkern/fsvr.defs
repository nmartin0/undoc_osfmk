	in	pathname	: path_name_t;
	in	flags		: int;
	in	args		: nfs_args_t;
	in	addr		: sockaddr_in_t;
	in	fh		: nfsv2fh_t;
	in	hostname	: path_name_t;
	out	rmt_mnt_port	: mach_port_t = MACH_MSG_TYPE_MOVE_SEND);

routine fsvr_nfssvc(
                file_port       : mach_port_t;
        in      creds_port      : mach_port_t;
        in      transaction_id  : transaction_id_t;
        in      mask            : int;
        in      match           : int;
        out     rval            : int);
#else

skip;
skip;

#endif /* NFS */



