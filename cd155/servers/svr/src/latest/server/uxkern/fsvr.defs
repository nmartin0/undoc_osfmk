routine fsvr_ufs_mountfs(
		fl_port		: mach_port_t;
	in	creds_port	: mach_port_t;
	in	transaction_id	: transaction_id_t;
	in	mnt_port	: mach_port_t = MACH_MSG_TYPE_MOVE_SEND;
	in	dir		: path_name_t;
	in	spec		: path_name_t;
	in	flag		: int;
	out	rmt_mnt_port	: mach_port_t = MACH_MSG_TYPE_MOVE_SEND);
#else
skip;
#endif	/* UFS */

