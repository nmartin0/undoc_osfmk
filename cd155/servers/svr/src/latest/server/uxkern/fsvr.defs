/*
 * Operations for Unix domain sockets
 */
routine	fsvr_uds_bindconn(
	    	file_port	: mach_port_t;
	in	cwd_port	: mach_port_t;
	in  	creds_port	: mach_port_t;
	in	transaction_id	: transaction_id_t;
	in	root_port	: mach_port_t;
	in	syscall		: int;		/* SYS_bind, SYS_connect */
	in	name		: sockarg_t);

routine	fsvr_uds_sendto_short(
		file_port	: mach_port_t;
	in	cwd_port	: mach_port_t;
	in	cred_port	: mach_port_t;
	in	transaction_id	: transaction_id_t;
	in	root_port	: mach_port_t;
	in	flags		: int;
	in	to		: sockarg_t;
	in	data		: small_char_array;
	out	amount_written	: int);

routine	fsvr_uds_sendto_long(
		file_port	: mach_port_t;
	in	cwd_port	: mach_port_t;
	in	cred_port	: mach_port_t;
	in	transaction_id	: transaction_id_t;
	in	root_port	: mach_port_t;
	in	flags		: int;
	in	to		: sockarg_t;
	in	data		: char_array;
	out	amount_written	: int);

routine	fsvr_uds_sendmsg(
		file_port	: mach_port_t;
	in	cwd_port	: mach_port_t;
	in	cred_port	: mach_port_t;
	in	transaction_id	: transaction_id_t;
	in	root_port	: mach_port_t;
	in	syscall		: int;		/* SYS_sendmsg, SYS_osendmsg */
	in	flags		: int;
	in	name		: sockarg_t;
	/* msg is really a pointer; copyin'd in socket code */
	in	msg		: int;
	out	amount_written	: int);

/*
 * Interfaces for mapped files.
 */
routine	fsvr_token_acquire(
		file_port	: mach_port_t;
	in	cred_port	: mach_port_t;
	in	flags		: int;
	in	revoke_port	: mach_port_t = MACH_MSG_TYPE_MAKE_SEND;
	out	token		: mach_port_t = MACH_MSG_TYPE_MOVE_SEND;
	out	offset		: int;
	out	length		: int);

routine	fsvr_token_acquire_with_mo(
