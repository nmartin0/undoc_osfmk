/*
 * IPC interface for selected emulator calls
 */
subsystem emul 		105000;

UserPrefix	uemul_;
ServerPrefix	semul_;

#include <mach/mach_types.defs>
#include <uxkern/bsd_types.defs>

type reply_port_t = MACH_MSG_TYPE_MAKE_SEND_ONCE | polymorphic
	ctype: mach_port_t;


simpleroutine forward_signal(
        	callback_port	: mach_port_t;
	in	intr		: boolean_t);

simpleroutine token_revoke(
                revoke_port  	: mach_port_t;
        in      token_port      : mach_port_t = MACH_MSG_TYPE_MOVE_SEND);

routine release_state(
		callback_port	: mach_port_t;
	sreplyport reply_port	: reply_port_t;
	in	intr		: boolean_t;
	in	is_exit		: boolean_t);

#ifdef PFS
routine token_acquire(
                revoke_port     : mach_port_t;
	in 	fdte_ref	: int;
	in	node		: int;
	out	offset		: esize_t;
	out	length		: esize_t);

simpleroutine token_release(
		revoke_port	: mach_port_t;
	in	fdte_ref	: int;
	in	node		: int;
	in	accessed	: int;
	in	modified	: int;
	in	offset		: esize_t;
	in	length		: esize_t);
#endif

#ifdef _EMULATOR
/*
 * This is emulator-to-emulator only
 */
routine at_barrier(
		callback_port	: mach_port_t = MACH_MSG_TYPE_MAKE_SEND;
	in	last_thread	: thread_t = MACH_MSG_TYPE_PORT_NAME);
#else
skip;
#endif
