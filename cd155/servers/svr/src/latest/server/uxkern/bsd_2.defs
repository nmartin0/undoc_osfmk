/*
 * IPC interface for UX server functions.
 * The UX server is both the client and server for these functions.
 */

subsystem bsd_2 102000;

UserPrefix ubsd_;
ServerPrefix sbsd_;

#include <mach/mach_types.defs>
#include <uxkern/bsd_types.defs>

simpleroutine side_thread_server(
		proc_port	: mach_port_t;
	in	side_func	: vm_address_t;
	in	intarg1		: int);


/* Needed to wake up a receiving server thread without causing it to do
 * anything.  See ux_server_thread_blocking().
 */
simpleroutine no_op_msg(
		proc_port	: mach_port_t);

simpleroutine sel_poll_reply(
		file_port	: mach_port_t;
	in	file_port_send	: mach_port_t = MACH_MSG_TYPE_MOVE_SEND;
	in	cred_port	: mach_port_t = MACH_MSG_TYPE_MOVE_SEND;
#ifdef TNC
	in	delay_port	: mach_port_t = MACH_MSG_TYPE_PORT_NAME;
	in	sel_id		: int;
	in	reply_node	: int;
#else
	in	delay_port	: mach_port_t = MACH_MSG_TYPE_MOVE_SEND_ONCE;
#endif
	in	selindex	: short;
	in	seleventbits	: short);

routine remote_print(
		print_port	: mach_port_t;
	in	action		: int;
	in	pid		: pid_t;
	in	sid		: pid_t;
	in	level		: int;
	in	buf		: small_char_array);

routine acct_off(
		acct_port	: mach_port_t;
	out	nacct_port	: mach_port_t = MACH_MSG_TYPE_MOVE_RECEIVE);

routine	acct_write(
		acct_port	: mach_port_t;
	in	acctbuf		: acct_t);

routine	acct_on(
		acct_port	: mach_port_t;
	in	acctsp		: mach_port_t = MACH_MSG_TYPE_MAKE_SEND);
