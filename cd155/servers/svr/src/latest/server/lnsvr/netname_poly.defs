/*
 * File:   netname_poly.defs
 * Author: Durriya Netterwala : Open Software Foundation - Research Institute
 * Date:   Jan 92
 *
 * Mig definitions for netname_check_in that allows copy of send rights
 * - This file may look very starnge and indeed it is. The whole idea is to 
 *   just allow the user side stub of netname_check_in pass an extra argument
 *   indicating whether you want 'port_id' port passed as 
 *   MACH_MSG_TYPE_COPY_SEND or MACH_MSG_TYPE_MAKE_SEND
 */

subsystem netname 1040;

#include <mach/std_types.defs>

type netname_name_t	= (MACH_MSG_TYPE_STRING,8*80);

routine netname_check_in_poly(
	server_port	: mach_port_t;
	port_name	: netname_name_t;
	signature	: mach_port_send_t;
	port_id		: mach_port_send_t);


routine netname_check_out_poly(
	server_port	: mach_port_t;
	port_name	: netname_name_t;
	signature	: mach_port_send_t);

