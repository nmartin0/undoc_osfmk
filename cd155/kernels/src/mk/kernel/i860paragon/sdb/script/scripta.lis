 313                             
 314                             ; schedular:  checks request queue for work to do
 315                             ; Usage:
 316                             ;      jmp schedular
 317                             ;
 318                             ; Input:
 319                             ;      None, except globals in cntrlr_q
 320                             ;
 321                             ; Output:
 322                             ;      None, except side effects
 323                             ;
 324                             ; Uses:
 325                             ;      everything
 326                             ;
 327                             ; Desc:
 328                             ;      Checks current element of cntrlr_q which is pointed to by CNTRLR_Q_P.
 329                             ;      If entry is empty, the queue must be empty.  The host is notified
 330                             ;      and we go to sleep until something happens.
 331                             ;
 332                             ;      If the next cntrlr_q entry is valid, schedular copies request
 333                             ;      and scatter-gather pointers from host to SIOP local ram.  CNTRLR_Q_P is
 334                             ;      incremented regarding cntrlr_q as an N-entry circular buffer.
 335                             ;      Doing the increment only after successfully selecting a target
 336                             ;      allows reselections to preempt without forgetting to try to start
 337                             ;      the i/o later.
 338                             ;
 339                             ; Data:
 340                             ;      cntrlr_q:
 341                             ;              uchar   queue_tag;      // target_id & queue_tag are arranged
 342                             ;              uchar   target_id;      // for 720 easy access
 343                             ;              ushort  filler;
 344                             ;              struct {
 345                             ;                      void *source;
 346                             ;                      void *dest;
 347                             ;                      long count;
 348                             ;              } req_tbl, scat_gath [N];
 349                             
 350                             
 351                             
 352 000000BC:                   schedular:
 353 000000BC: 721A0000 00000000        move    ctest2 to sfbr                  ; clear sigp
 354                             
 355 000000C4: C0000004 00000000 00000000       move    memory 4, cntrlr_q_p, pass(REG_BASE+0x34)       ; scratchA = &next entry
 356 000000D0: 7E340400 00000000        move    scratcha0 + OFFSETOF_REQ_TBL to scratcha0
 357 000000D8: 7F350000 00000000        move    scratcha1 + 0 to scratcha1 with carry
 358 000000E0: 7F360000 00000000        move    scratcha2 + 0 to scratcha2 with carry
 359 000000E8: 7F370000 00000000        move    scratcha3 + 0 to scratcha3 with carry ; A = &cntrl_q [X].req_tbl
 360                             
 361                             ; If source address is nonzero, there is work to do.  Try to copy entry
 362                             ; from host memory to local memory.  If it is empty (zero source),
 363                             ; copy_entry returns with carry set.
 364                             
 365 000000F0: 88880000 000009C4        call    rel (copy_entry)
 366 000000F8: 80A80000 0000022C        jump    rel (sched_empty), if carry     ; if zero, nothing to do
 367                             
 368                             ; Here if a valid entry; the sched_ready code expects the DSA to point to
 369                             ; the first destination address.  This (non-modular) fetch from COPY_BUF
 370                             ; (set as a side effect of copy_entry) is quite expedient.  :-)
 371                             
 372 00000100: C0000004 0000001C 00000000       move    memory 4, copy_buf+4, pass(REG_BASE+0x10)       ; set DSA to request_tbl
 373                             
 374                             ; Copy the subsequent entries (scatter/gather tables) until a zero entry.
 375                             ; The pseudo code is approximately:
 376                             ;      do {
 377                             ;              scratchA += 12;
 378                             ;              copy (*(scratchA+0) to *(scratchA+4), length *(scratchA+8));
 379                             ;      } while (*(scratchA+0) != 0)
 380                             
 381 0000010C:                   sched_loop:
 382 0000010C: 7E340C00 00000000        move    scratcha0 + SIZEOF_STRUCT_SDC to scratcha0
 383 00000114: 7F350000 00000000        move    scratcha1 + 0 to scratcha1 with carry
 384 0000011C: 7F360000 00000000        move    scratcha2 + 0 to scratcha2 with carry
 385 00000124: 7F370000 00000000        move    scratcha3 + 0 to scratcha3 with carry
 386 0000012C: 88880000 00000988        call    rel (copy_entry)                ; copy scat_gath entry
 387 00000134: 80A00000 FFFFFFD0        jump    rel (sched_loop), if not carry
 388                             
 389                             
 390                             ; sched_ready:  Determine whether to select with ATN or not.  Decided by
 391                             ; whether or not msg_out is present.  This is probably directly related to
 392                             ; the target being SCSI-1 or SCSI-2, but maybe not.  msg_out phase is
 393                             ; apparently entered if the target receives the ATN signal.
 394                             ;
 395                             ; Though DSA points to the request, the 720 doesn't have a memory to memory
 396                             ; move which makes use of DSA.  So indirection is done via runtime patching.
 397                             ;
 398                             ; Pseudo code for the next 5 instructions:
 399                             ;      scratcha = *(dsa+4)
 400                             ; where "4" is "offsetof_msg_out_len"
 401                             
 402 0000013C: C0000004 00000000 00000000       move    memory 4, pass(REG_BASE+0x10), pass(REG_BASE+0x34)
 403 00000148: 7E340800 00000000        move    scratcha0 + OFFSETOF_MSG_OUT_LEN to scratcha0
 404 00000150: 7F350000 00000000        move    scratcha1 + 0 to scratcha1 with carry
 405 00000158: 7F360000 00000000        move    scratcha2 + 0 to scratcha2 with carry
 406 00000160: 7F370000 00000000        move    scratcha3 + 0 to scratcha3 with carry
 407                             
 408 00000168: C0000004 00000000 00000178       move    memory 4, pass(REG_BASE+0x34), sch_0+4  ; patch source addr
 409 00000174: C0000004 00000000 00000000 sch_0:        move    memory 4, PATCH, pass(REG_BASE+0x34)    ; move *(dsa+4) to scratcha
 410                             
 411 00000180: C0000004 00000000 00000000       move    memory 4, pass(REG_BASE+0x10), pass(REQ_TBL_PTR)        ; save i/o request pointer
 412                             
 413                             ; pseudo code for the next 5 instructions:
 414                             ;      if (scratcha0)
 415                             ;              select target with    atn
 416                             ;      else    select target without atn
 417                             
 418 0000018C: 72340000 00000000        move    scratcha0 to sfbr
 419 00000194: 808C0000 00000020        jump    rel (sel_no_atn), if 0          ; jump if no msg_out
 420                             
 421                             ; Both these "select" instructions implicitly set the SXFER and SCNTL3
 422                             ; from DSA+0.
 423                             
 424 0000019C: 47000000 000001AC        select  ATN from 0, rel (got_reselected)
 425 000001A4: 868B0000 00000030        jump    rel (selected) when msg_out
 426 000001AC: 78350600 00000000        move    ERROR_WRONG_PHASE to scratcha1  ; jump if not expected phase
 427 000001B4: 80880000 000002A8        jump    rel (bad_error)
 428                             
 429 000001BC:                   sel_no_atn:
 430 000001BC: 46000000 0000018C        select  from 0, rel (got_reselected)
 431 000001C4: 828B0000 00000010        jump    rel (selected) when cmd
 432 000001CC: 78350600 00000000        move    ERROR_WRONG_PHASE to scratcha1  ; jump if not expected phase
 433 000001D4: 80880000 00000288        jump    rel (bad_error)
 434                             
 435                             ; Successfully selected scsi target.  (If we didn't, we were reselected by
 436                             ; some target and jumped to "got_reselected".)
 437                             
 438 000001DC:                   selected:
 439 000001DC: 98080000 C0DE012F        int     ASSERT_SELECT_TBL_PTR
 440 000001E4: 78071000 00000000        move    LED_GREEN to gpreg
 441                             
 442                             
 443                             ; ---- Begin section that could be moved to disconnect handler ----
 444                             ; Save request pointer for possible later reselection.
 445                             ; pseudo code:
 446                             ;
 447                             ;      reselect_tbl [target_id << 8 + queue_tag] = cntrlr_q [X].req_tbl.dest
 448                             ;
 449                             ; written directly for the 720 environment:
 450                             ;      *(reselect_tbl + ((ushort) *cntrlr_q_p << 2)) = *(cntrlr_q_p+8)
 451                             
 452                             ; evaluate right address
