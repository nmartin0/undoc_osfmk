 305 00000088: 7837DE00 00000000         move    0xde to scratcha3
 306 00000090: 7836AD00 00000000         move    0xad to scratcha2
 307 00000098: 7835BE00 00000000         move    0xbe to scratcha1
 308 000000A0: 7834EF00 00000000         move    0xef to scratcha0
 309 000000A8: C0000004 00000000 00000030         move    memory 4, pass(REG_BASE+0x34), data_analyzer_trig
