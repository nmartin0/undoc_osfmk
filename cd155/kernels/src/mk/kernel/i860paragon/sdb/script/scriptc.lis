1368 00000E60: 80840000 00000094        jump    rel (cmp9), if not 0
1369                             
1370 00000E68: 725C0000 00000000        move    scratchb0 to sfbr
1371 00000E70: 6A5D0000 00000000        move    sfbr      to scratchb1
1372 00000E78: C0000001 00000000 00000E85       move    memory 1, pass(REG_BASE+0x5c+1), cmp0+1
