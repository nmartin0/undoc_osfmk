 416                             
 417                             ; sched_ready:  Determine whether to select with ATN or not.  Decided by
 418                             ; whether or not msg_out is present.  This is probably directly related to
 419                             ; the target being SCSI-1 or SCSI-2, but maybe not.  msg_out phase is
 420                             ; apparently entered if the target receives the ATN signal.
 421                             ;
 422                             ; Though DSA points to the request, the 720 doesn't have a memory to memory
 423                             ; move which makes use of DSA.  So indirection is done via runtime patching.
 424                             ;
 425                             ; Pseudo code for the next 5 instructions:
 426                             ;      scratcha = *(dsa+4)
 427                             ; where "4" is "offsetof_msg_out_len"
 428                             
 429 000001D4: C0000004 00000000 00000000       move    memory 4, pass(REG_BASE+0x10), pass(REG_BASE+0x34)
 430 000001E0: 7E340800 00000000        move    scratcha0 + OFFSETOF_MSG_OUT_LEN to scratcha0
 431 000001E8: 7F350000 00000000        move    scratcha1 + 0 to scratcha1 with carry
 432 000001F0: 7F360000 00000000        move    scratcha2 + 0 to scratcha2 with carry
 433 000001F8: 7F370000 00000000        move    scratcha3 + 0 to scratcha3 with carry
 434                             
 435 00000200: C0000004 00000000 00000210       move    memory 4, pass(REG_BASE+0x34), sch_0+4  ; patch source addr
 436 0000020C: C0000004 00000000 00000000 sch_0:        move    memory 4, PATCH, pass(REG_BASE+0x34)    ; move *(dsa+4) to scratcha
 437                             
 438 00000218: C0000004 00000000 00000000       move    memory 4, pass(REG_BASE+0x10), pass(REQ_TBL_PTR)        ; save i/o request pointer
 439                             
 440                             ; pseudo code for the next 5 instructions:
 441                             ;      if (scratcha0)
 442                             ;              select target with    atn
 443                             ;      else    select target without atn
