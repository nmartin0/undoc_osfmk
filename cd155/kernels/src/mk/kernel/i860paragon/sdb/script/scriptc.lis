 754 0000071C:                   data_in_loop:
 755                             ; Advance current scat-gath ptr to next entry.  This scheme keeps DSA
 756                             ; always pointing to the current entry if a phase mismatch occurs.
 757                             ;
 758                             ; Also a copy of the current descriptor is used in case a phase mismatch
 759                             ; causes us to update the entry to continue from the right place, but not
 760                             ; update the original scat-gath entry unless a save data pointers message
 761                             ; arrives.
 762                             
 763                             ; If a phase mismatch occurs, the 720 is halted and interrupts the host--all
 764                             ; beyond our control (and against our desires).  This happens when a target
 765                             ; disconnects mid transfer (changes to msg_in phase to send a disconnnect
 766                             ; message, maybe because it wants to seek a different track, or, for a raid
 767                             ; controller, talk to a different drive).
 768                             ;
 769                             ; To gracefully recover, the host checks for a phase mismatch interrupt,
 770                             ; executes the phase_mismatch C code (below) and sets us (the 720) running.
 771                             ; If we had our druthers, the "chmov" instruction would accept an alternate
 772                             ; label to jump to for a phase change, analogous to a "select" or "reselect"
 773                             ; instruction.
 774                             
 775 0000071C: 11000000 00000000        chmov   from dsa_dummy, when data_in    ; "dsa_dummy" == 0
 776                             ; i.e. chmov   from 0,         when data_in
