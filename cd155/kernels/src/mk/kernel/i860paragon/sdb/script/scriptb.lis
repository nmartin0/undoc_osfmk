1382 00000F84: C0000001 00000000 00000FBD       move    memory 1, pass(REG_BASE+0x5c+1), add2+1         ; 16-23 patch
1383                             
1384 00000F90: 725F0000 00000000        move    scratchb3 to sfbr                       ; move B3 to B1
1385 00000F98: 6A5D0000 00000000        move    sfbr    to scratchb1
1386 00000FA0: C0000001 00000000 00000FC5       move    memory 1, pass(REG_BASE+0x5c+1), add3+1         ; 24-31 patch
