 203                             
 204                             ; Following are offsets used by modules that test the integrity of data in
 205                             ; CLRAM, DPRAM, or the node memory. These modules can be used even when
 206                             ; debugging is turned off in the host. They check the integrity of data and
 207                             ; INT the host if data are inconsistent. The host then stops the other SIOP
 208                             ; which did not INT and then hits a panic or an assert itself
 209                             ; This way all three uPs (two 53C720s and one 80860) stop and the logic
 210                             ; analyzer does not catch any unnecessary data on the local bus
 211                             absolute OFFSETOF_PTR_MSG_OUT   = 12    ; relative to start of request table
 212                             absolute OFFSETOF_BYTES_MSG_OUT = 16    ; relative to start of request table
 213                             
 214                             ; This TABLE directive must match the host "request_table" structure in
 215                             ; ...Kernel/src/mk/kernel/scsi/adapters/scsi_53C720.h
 216                             
 217                             ;  dsa_dummy = 1{??},
 218                             ;  dsa_sxfer_value = 1{??},
 219                             ;  dsa_dest_id_val = 1{??},
 220                             ;  dsa_scntrl3_val = 1{??},
 221                             
 222                             TABLE dsa_relative_table       \
 223 00000000:                     dsa_dummy = {0, 0, 0, 0},    \
 224 00000008:                     dsa_msg_out_len = {0, 0, 0, 0},      \ ;dsa_msg_out_ptr = {0, 0, 0, 0},
 225 00000010:                     dsa_msg_out_buf = {0, 0, 0, 0,  0, 0, 0, 0}, \
 226 00000018:                     dsa_cmd_len = {0, 0, 0, 0},          \ ;dsa_cmd_ptr = {0, 0, 0, 0},
 227 00000020:                     dsa_cmd_buf = 12{0},         \
 228 00000028:                     dsa_sg_ptr = 4{0}                    ; offset not used
