 776 000007B4:                   data_in_loop:
 777                             ; Advance current scat-gath ptr to next entry.  This scheme keeps DSA
 778                             ; always pointing to the current entry if a phase mismatch occurs.
 779                             ;
 780                             ; Also a copy of the current descriptor is used in case a phase mismatch
 781                             ; causes us to update the entry to continue from the right place, but not
 782                             ; update the original scat-gath entry unless a save data pointers message
 783                             ; arrives.
 784                             
 785                             ; If a phase mismatch occurs, the 720 is halted and interrupts the host--all
 786                             ; beyond our control (and against our desires).  This happens when a target
 787                             ; disconnects mid transfer (changes to msg_in phase to send a disconnnect
 788                             ; message, maybe because it wants to seek a different track, or, for a raid
 789                             ; controller, talk to a different drive).
 790                             ;
 791                             ; To gracefully recover, the host checks for a phase mismatch interrupt,
 792                             ; executes the phase_mismatch C code (below) and sets us (the 720) running.
 793                             ; If we had our druthers, the "chmov" instruction would accept an alternate
 794                             ; label to jump to for a phase change, analogous to a "select" or "reselect"
 795                             ; instruction.
 796                             
 797 000007B4: 11000000 00000000        chmov   from dsa_dummy, when data_in    ; "dsa_dummy" == 0
 798                             ; i.e. chmov   from 0,         when data_in
 799                             
 800                             
 801 000007BC: 7E100800 00000000        move    dsa0+SIZEOF_SG_ENTRY to dsa0    ; dsa += 8;
 802 000007C4: 7F110000 00000000        move    dsa1+0 to dsa1 with carry
 803 000007CC: 7F120000 00000000        move    dsa2+0 to dsa2 with carry
 804 000007D4: 7F130000 00000000        move    dsa3+0 to dsa3 with carry
 805                             
 806                             ; If an i/o request specifies an odd number of bytes and it is a 16-bit scsi
 807                             ; device, getting the last byte to the target is a problem.  The 720 will not
 808                             ; send the last byte unless it is paired up with another to fill the 16-bit
 809                             ; pathway.  If a solution is implemented, it will be done by the host when it
 810                             ; creates the last scatter gather entry in the list.  The command should
 811                             ; contain the actual byte count (an odd value, otherwise it's no problem) but
 812                             ; the last scatter gather entry should have one added to it so an even number
 813                             ; of bytes are "sent" to the target.  The target will dutifully ignore the
 814                             ; extra eight bits since it knows they aren't part of the command.  Failure
 815                             ; to pad with an extra byte would make the 720 hang waiting for the target to
 816                             ; phase change while the target is waiting for the last byte.
