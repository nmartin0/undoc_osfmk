 317                             
 318                             ; schedular:  checks request queue for work to do
 319                             ; Usage:
 320                             ;      jmp schedular
 321                             ;
 322                             ; Input:
 323                             ;      None, except globals in cntrlr_q
 324                             ;
 325                             ; Output:
 326                             ;      None, except side effects
 327                             ;
 328                             ; Uses:
 329                             ;      everything
 330                             ;
 331                             ; Desc:
 332                             ;      Checks current element of cntrlr_q which is pointed to by CNTRLR_Q_P.
 333                             ;      If entry is empty, the queue must be empty.  The host is notified
 334                             ;      and we go to sleep until something happens.
 335                             ;
 336                             ;      If the next cntrlr_q entry is valid, schedular copies request
 337                             ;      and scatter-gather pointers from host to SIOP local ram.  CNTRLR_Q_P is
 338                             ;      incremented regarding cntrlr_q as an N-entry circular buffer.
 339                             ;      Doing the increment only after successfully selecting a target
 340                             ;      allows reselections to preempt without forgetting to try to start
 341                             ;      the i/o later.
 342                             ;
 343                             ; Data:
 344                             ;      cntrlr_q:
 345                             ;              uchar   queue_tag;      // target_id & queue_tag are arranged
 346                             ;              uchar   target_id;      // for 720 easy access
 347                             ;              ushort  filler;
 348                             ;              struct {
 349                             ;                      void *source;
 350                             ;                      void *dest;
 351                             ;                      long count;
 352                             ;              } req_tbl, scat_gath [N];
 353                             
 354                             
 355                             
 356 000000C4:                   schedular:
 357 000000C4: 98080000 C0DE0067        int     DEBUG_SCHEDULAR_ENTRY
 358 000000CC: 721A0000 00000000        move    ctest2 to sfbr                  ; clear sigp
 359                             
 360 000000D4: C0000004 00000000 00000000       move    memory 4, cntrlr_q_p, pass(REG_BASE+0x34)       ; scratchA = &next entry
 361 000000E0: 7E340400 00000000        move    scratcha0 + OFFSETOF_REQ_TBL to scratcha0
 362 000000E8: 7F350000 00000000        move    scratcha1 + 0 to scratcha1 with carry
 363 000000F0: 7F360000 00000000        move    scratcha2 + 0 to scratcha2 with carry
 364 000000F8: 7F370000 00000000        move    scratcha3 + 0 to scratcha3 with carry ; A = &cntrl_q [X].req_tbl
 365                             
 366                             ; If source address is nonzero, there is work to do.  Try to copy entry
 367                             ; from host memory to local memory.  If it is empty (zero source),
 368                             ; copy_entry returns with carry set.
 369                             
 370 00000100: 88880000 00000CA4        call    rel (copy_entry)
 371 00000108: 80A80000 000003A4        jump    rel (sched_empty), if carry     ; if zero, nothing to do
 372                             
 373                             ; Here if a valid entry; the sched_ready code expects the DSA to point to
 374                             ; the first destination address.  This (non-modular) fetch from COPY_BUF
 375                             ; (set as a side effect of copy_entry) is quite expedient.  :-)
 376                             
 377 00000110: C0000004 0000001C 00000000       move    memory 4, copy_buf+4, pass(REG_BASE+0x10)       ; set DSA to request_tbl
 378                             
 379                             ; Copy the subsequent entries (scatter/gather tables) until a zero entry.
 380                             ; The pseudo code is approximately:
 381                             ;      do {
 382                             ;              scratchA += 12;
 383                             ;              copy (*(scratchA+0) to *(scratchA+4), length *(scratchA+8));
 384                             ;      } while (*(scratchA+0) != 0)
 385                             
 386 0000011C:                   sched_loop:
 387 0000011C: 7E340C00 00000000        move    scratcha0 + SIZEOF_STRUCT_SDC to scratcha0
 388 00000124: 7F350000 00000000        move    scratcha1 + 0 to scratcha1 with carry
 389 0000012C: 7F360000 00000000        move    scratcha2 + 0 to scratcha2 with carry
 390 00000134: 7F370000 00000000        move    scratcha3 + 0 to scratcha3 with carry
 391 0000013C: 88880000 00000C68        call    rel (copy_entry)                ; copy scat_gath entry
 392 00000144: 80A00000 FFFFFFD0        jump    rel (sched_loop), if not carry
 393                             
