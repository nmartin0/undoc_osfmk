 417                             
 418                             ; sched_ready:  Determine whether to select with ATN or not.  Decided by
 419                             ; whether or not msg_out is present.  This is probably directly related to
 420                             ; the target being SCSI-1 or SCSI-2, but maybe not.  msg_out phase is
 421                             ; apparently entered if the target receives the ATN signal.
 422                             ;
 423                             ; Though DSA points to the request, the 720 doesn't have a memory to memory
 424                             ; move which makes use of DSA.  So indirection is done via runtime patching.
 425                             ;
 426                             ; Pseudo code for the next 5 instructions:
 427                             ;      scratcha = *(dsa+4)
 428                             ; where "4" is "offsetof_msg_out_len"
 429                             
 430 000001E4: 98080000 C0DE0068        int     DEBUG_SCHEDULE_READY
 431 000001EC: C0000004 00000000 00000000       move    memory 4, pass(REG_BASE+0x10), pass(REG_BASE+0x34)
 432 000001F8: 7E340800 00000000        move    scratcha0 + OFFSETOF_MSG_OUT_LEN to scratcha0
 433 00000200: 7F350000 00000000        move    scratcha1 + 0 to scratcha1 with carry
 434 00000208: 7F360000 00000000        move    scratcha2 + 0 to scratcha2 with carry
 435 00000210: 7F370000 00000000        move    scratcha3 + 0 to scratcha3 with carry
 436                             
 437 00000218: C0000004 00000000 00000228       move    memory 4, pass(REG_BASE+0x34), sch_0+4  ; patch source addr
