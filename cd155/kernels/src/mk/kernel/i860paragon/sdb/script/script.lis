 434                             ; ---- Begin section that could be moved to disconnect handler ----
 435                             ; Save request pointer for possible later reselection.
 436                             ; pseudo code:
 437                             ;
 438                             ;      reselect_tbl [target_id << 8 + queue_tag] = cntrlr_q [X].req_tbl.dest
 439                             ;
 440                             ; written directly for the 720 environment:
 441                             ;      *(reselect_tbl + ((ushort) *cntrlr_q_p << 2)) = *(cntrlr_q_p+8)
 442                             
