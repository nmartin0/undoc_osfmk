 199                             
 200                             ; Following are offsets used by modules that test the integrity of data in
 201                             ; CLRAM, DPRAM, or the node memory. These modules can be used even when
 202                             ; debugging is turned off in the host. They check the integrity of data and
 203                             ; INT the host if data are inconsistent. The host then stops the other SIOP
 204                             ; which did not INT and then hits a panic or an assert itself
 205                             ; This way all three uPs (two 53C720s and one 80860) stop and the logic
 206                             ; analyzer does not catch any unnecessary data on the local bus
 207                             absolute OFFSETOF_PTR_MSG_OUT   = 12    ; relative to start of request table
 208                             absolute OFFSETOF_BYTES_MSG_OUT = 16    ; relative to start of request table
 209                             
 210                             ; This TABLE directive must match the host "request_table" structure in
 211                             ; ...Kernel/src/mk/kernel/scsi/adapters/scsi_53C720.h
 212                             
 213                             ;  dsa_dummy = 1{??},
 214                             ;  dsa_sxfer_value = 1{??},
 215                             ;  dsa_dest_id_val = 1{??},
 216                             ;  dsa_scntrl3_val = 1{??},
 217                             
 218                             TABLE dsa_relative_table       \
 219 00000000:                     dsa_dummy = {0, 0, 0, 0},    \
 220 00000008:                     dsa_msg_out_len = {0, 0, 0, 0},      \ ;dsa_msg_out_ptr = {0, 0, 0, 0},
 221 00000010:                     dsa_msg_out_buf = {0, 0, 0, 0,  0, 0, 0, 0}, \
 222 00000018:                     dsa_cmd_len = {0, 0, 0, 0},          \ ;dsa_cmd_ptr = {0, 0, 0, 0},
 223 00000020:                     dsa_cmd_buf = 12{0},         \
 224 00000028:                     dsa_sg_ptr = 4{0}                    ; offset not used
