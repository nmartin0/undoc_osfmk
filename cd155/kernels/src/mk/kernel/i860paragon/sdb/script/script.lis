 444 000001B8: C0000004 00000000 00000000       move    memory 4, cntrlr_q_p, pass(REG_BASE+0x34)
 445 000001C4: 7E340800 00000000        move    scratcha0 + OFFSETOF_REQ_DEST to scratcha0
 446 000001CC: 7F350000 00000000        move    scratcha1 + 0 to scratcha1 with carry
 447 000001D4: 7F360000 00000000        move    scratcha2 + 0 to scratcha2 with carry
 448 000001DC: 7F370000 00000000        move    scratcha3 + 0 to scratcha3 with carry
 449                             
 450 000001E4: C0000004 00000000 00000220       move    memory 4, pass(REG_BASE+0x34), sch_3+4  ; patch source address
 451                             
