 305                             
 306                             ; schedular:  checks request queue for work to do
 307                             ; Usage:
 308                             ;      jmp schedular
 309                             ;
 310                             ; Input:
 311                             ;      None, except globals in cntrlr_q
 312                             ;
 313                             ; Output:
 314                             ;      None, except side effects
 315                             ;
 316                             ; Uses:
 317                             ;      everything
 318                             ;
 319                             ; Desc:
 320                             ;      Checks current element of cntrlr_q which is pointed to by CNTRLR_Q_P.
 321                             ;      If entry is empty, the queue must be empty.  The host is notified
 322                             ;      and we go to sleep until something happens.
 323                             ;
 324                             ;      If the next cntrlr_q entry is valid, schedular copies request
 325                             ;      and scatter-gather pointers from host to SIOP local ram.  CNTRLR_Q_P is
 326                             ;      incremented regarding cntrlr_q as an N-entry circular buffer.
 327                             ;      Doing the increment only after successfully selecting a target
 328                             ;      allows reselections to preempt without forgetting to try to start
 329                             ;      the i/o later.
 330                             ;
 331                             ; Data:
 332                             ;      cntrlr_q:
 333                             ;              uchar   queue_tag;      // target_id & queue_tag are arranged
 334                             ;              uchar   target_id;      // for 720 easy access
 335                             ;              ushort  filler;
 336                             ;              struct {
 337                             ;                      void *source;
 338                             ;                      void *dest;
 339                             ;                      long count;
 340                             ;              } req_tbl, scat_gath [N];
 341                             
 342                             
 343                             
 344 00000090:                   schedular:
 345 00000090: 721A0000 00000000        move    ctest2 to sfbr                  ; clear sigp
 346                             
 347 00000098: C0000004 00000000 00000000       move    memory 4, cntrlr_q_p, pass(REG_BASE+0x34)       ; scratchA = &next entry
 348 000000A4: 7E340400 00000000        move    scratcha0 + OFFSETOF_REQ_TBL to scratcha0
 349 000000AC: 7F350000 00000000        move    scratcha1 + 0 to scratcha1 with carry
 350 000000B4: 7F360000 00000000        move    scratcha2 + 0 to scratcha2 with carry
 351 000000BC: 7F370000 00000000        move    scratcha3 + 0 to scratcha3 with carry ; A = &cntrl_q [X].req_tbl
 352                             
 353                             ; If source address is nonzero, there is work to do.  Try to copy entry
 354                             ; from host memory to local memory.  If it is empty (zero source),
 355                             ; copy_entry returns with carry set.
 356                             
 357 000000C4: 88880000 000009AC        call    rel (copy_entry)
 358 000000CC: 80A80000 00000224        jump    rel (sched_empty), if carry     ; if zero, nothing to do
 359                             
 360                             ; Here if a valid entry; the sched_ready code expects the DSA to point to
 361                             ; the first destination address.  This (non-modular) fetch from COPY_BUF
 362                             ; (set as a side effect of copy_entry) is quite expedient.  :-)
 363                             
 364 000000D4: C0000004 0000001C 00000000       move    memory 4, copy_buf+4, pass(REG_BASE+0x10)       ; set DSA to request_tbl
 365                             
 366                             ; Copy the subsequent entries (scatter/gather tables) until a zero entry.
 367                             ; The pseudo code is approximately:
 368                             ;      do {
 369                             ;              scratchA += 12;
 370                             ;              copy (*(scratchA+0) to *(scratchA+4), length *(scratchA+8));
 371                             ;      } while (*(scratchA+0) != 0)
 372                             
 373 000000E0:                   sched_loop:
 374 000000E0: 7E340C00 00000000        move    scratcha0 + SIZEOF_STRUCT_SDC to scratcha0
 375 000000E8: 7F350000 00000000        move    scratcha1 + 0 to scratcha1 with carry
 376 000000F0: 7F360000 00000000        move    scratcha2 + 0 to scratcha2 with carry
 377 000000F8: 7F370000 00000000        move    scratcha3 + 0 to scratcha3 with carry
 378 00000100: 88880000 00000970        call    rel (copy_entry)                ; copy scat_gath entry
 379 00000108: 80A00000 FFFFFFD0        jump    rel (sched_loop), if not carry
 380                             
 381                             
 382                             ; sched_ready:  Determine whether to select with ATN or not.  Decided by
 383                             ; whether or not msg_out is present.  This is probably directly related to
 384                             ; the target being SCSI-1 or SCSI-2, but maybe not.  msg_out phase is
 385                             ; apparently entered if the target receives the ATN signal.
 386                             ;
 387                             ; Though DSA points to the request, the 720 doesn't have a memory to memory
 388                             ; move which makes use of DSA.  So indirection is done via runtime patching.
 389                             ;
 390                             ; Pseudo code for the next 5 instructions:
 391                             ;      scratcha = *(dsa+4)
 392                             ; where "4" is "offsetof_msg_out_len"
 393                             
 394 00000110: C0000004 00000000 00000000       move    memory 4, pass(REG_BASE+0x10), pass(REG_BASE+0x34)
 395 0000011C: 7E340800 00000000        move    scratcha0 + OFFSETOF_MSG_OUT_LEN to scratcha0
 396 00000124: 7F350000 00000000        move    scratcha1 + 0 to scratcha1 with carry
 397 0000012C: 7F360000 00000000        move    scratcha2 + 0 to scratcha2 with carry
 398 00000134: 7F370000 00000000        move    scratcha3 + 0 to scratcha3 with carry
 399                             
 400 0000013C: C0000004 00000000 0000014C       move    memory 4, pass(REG_BASE+0x34), sch_0+4  ; patch source addr
 401 00000148: C0000004 00000000 00000000 sch_0:        move    memory 4, PATCH, pass(REG_BASE+0x34)    ; move *(dsa+4) to scratcha
 402                             
 403 00000154: C0000004 00000000 00000000       move    memory 4, pass(REG_BASE+0x10), pass(REQ_TBL_PTR)        ; save i/o request pointer
 404                             
 405                             ; pseudo code for the next 5 instructions:
 406                             ;      if (scratcha0)
 407                             ;              select target with    atn
 408                             ;      else    select target without atn
 409                             
 410 00000160: 72340000 00000000        move    scratcha0 to sfbr
 411 00000168: 808C0000 00000020        jump    rel (sel_no_atn), if 0          ; jump if no msg_out
 412                             
 413                             ; Both these "select" instructions implicitly set the SXFER and SCNTL3
 414                             ; from DSA+0.
 415                             
 416 00000170: 47000000 000001A4        select  ATN from 0, rel (got_reselected)
 417 00000178: 868B0000 00000030        jump    rel (selected) when msg_out
 418 00000180: 78350600 00000000        move    ERROR_WRONG_PHASE to scratcha1  ; jump if not expected phase
 419 00000188: 80880000 00000298        jump    rel (bad_error)
 420                             
 421 00000190:                   sel_no_atn:
 422 00000190: 46000000 00000184        select  from 0, rel (got_reselected)
 423 00000198: 828B0000 00000010        jump    rel (selected) when cmd
 424 000001A0: 78350600 00000000        move    ERROR_WRONG_PHASE to scratcha1  ; jump if not expected phase
 425 000001A8: 80880000 00000278        jump    rel (bad_error)
 426                             
 427                             ; Successfully selected scsi target.  (If we didn't, we were reselected by
 428                             ; some target and jumped to "got_reselected".)
 429                             
 430 000001B0:                   selected:
 431 000001B0: 78071000 00000000        move    LED_GREEN to gpreg
