 297 00000070:                   init:
 298                             
 299                             ; init .word initialized pointers
 300 00000070: C0000004 00000050 00000000       move    memory 4, bss1+4, cntrlr_q_p
 301 0000007C: C0000004 0000005C 00000008       move    memory 4, bss2+4, req_done_ptr
 302                             
 303 00000088: 80880000 00000000        jump    rel (schedular)         ; starting point is with nothing to do
