###############################################################################
#BEGIN	Machine dependent Makefile fragment for the i386
###############################################################################

VOLATILE=

#tmp

SYS_RULE_2=-@
SYS_RULE_3=-@
SYS_RULE_4=-@
MD=md

#LIBS_P=-lc_p

LDOBJS_PREFIX= ${ORDERED}
#
# Rules to build mach_i386.defs.
#
MACH_I386_FILES = mach/mach_i386_server.c

$(MACH_I386_FILES): $(MIGDEPS) $(SOURCE_DIR)/mach/i386/mach_i386.defs
	-$(MAKE_MACH)
	$(MIG) -MD $(MIGKSFLAGS) \
	    -header /dev/null \
	    -user   /dev/null \
	    -server mach/mach_i386_server.c \
		$(SOURCE_DIR)/mach/i386/mach_i386.defs

ioconf.c:
	@echo The hack below should get fixed sometime.
	cp /dev/null ioconf.c

#
# Things dependent on assym.s:
#
cswitch.o:	assym.s
interrupt.o:	assym.s
locore.o:	assym.s
start.o:	assym.s

#
# Rules to build bin/makeboot for the Sequent.  They are invoked only
# if the configuration puts makeboot in SYSDEPS.
#
# the cd command may not work if shadowing is in use!
#

../bin/makeboot: ../bin ../src ../src/makeboot
	@echo "[ generating $@ ]"
	cd $(SOURCE_DIR)/src/makeboot && \
		CPATH=/usr/include ${MAKE} DDIR=../../bin makeboot.install

../bin ../src ../src/makeboot:
	mkdir $@

#
# Rule to build slave_boot_code.c for the Corollary. 
# It is invoked only
# if the configuration puts ./slave_boot_code.c in SYSDEPS.
#
# the cd command may not work if shadowing is in use!
#


slave_boot_code.c: \
	$(SOURCE_DIR)/i386at/mp/boot/asm.s \
	$(SOURCE_DIR)/i386at/mp/boot/table.c \
	$(SOURCE_DIR)/i386at/mp/boot/start.s \
	$(SOURCE_DIR)/i386at/mp/boot/btoi.c
	cd $(SOURCE_DIR)/i386at/mp/boot && ${MAKE}
	rm -f $@; ln -s ../i386at/mp/boot/$@ $@

../i386at/boot/boot:\
	$(SOURCE_DIR)/i386at/boot/asm.s \
	$(SOURCE_DIR)/i386at/boot/bios.s \
	$(SOURCE_DIR)/i386at/boot/boot.c \
	$(SOURCE_DIR)/i386at/boot/boot.h \
	$(SOURCE_DIR)/i386at/boot/boot2.s \
	$(SOURCE_DIR)/i386at/boot/disk.c \
	$(SOURCE_DIR)/i386at/boot/io.c \
	$(SOURCE_DIR)/i386at/boot/start.s \
	$(SOURCE_DIR)/i386at/boot/sys.c \
	$(SOURCE_DIR)/i386at/boot/table.c 
	cd $(SOURCE_DIR)/i386at/boot && ${MAKE}

###############################################################################
#END	Machine dependent Makefile fragment for the i386
###############################################################################
