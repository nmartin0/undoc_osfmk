# Added ghlang support. dfc 9/20/90
# Added HCC for those portions of code that must be run on host. dfc 90/19/90
# Modified assembler invocation.  wlb dfc 90/09/13
# Copied from MASTER.i386 by Don Cameron 90/09/07
#
#
#  Master I860 configuration file (see the master machine independent
#  configuration file for a description of the file format).
#
#	
#	#####################################################################
#	
#	  I860 (PSEUDO-)DEVICES (select any combination)
#	
#	  CPU TYPE (select exactly one)
#	  Paragon	Intel Paragon XP/S
#	  iPSC		Intel iPSC/860 hypercube
#	  OKI		Oki i860 Station
#	
#	#####################################################################
#
#	I860 Devices
#
#	for an iPSC/860:
#
#		usm
#		dcm
#
#	for an Oki i860 Station:
#
#		rtc	real-time clock
#		wd	SCSI disk
#		fd	Floppy disk
#		zs	Zilog serial ports
#		ie	i82586 LAN controller
#		kd	Keyboard and display
#
#	#####################################################################
#	
#	  Standard Configurations:
#	  -------- ---------------
#	  PARAGON = [ paragon paragon_mio pgi md hippi newfpe mcmsg_eng console_logging sdb ]
#	  PARAGON_LITE = [ paragon paragon_mio_lite pgi newfpe mcmsg_eng console_logging sdb_lite ]
#
#	  DOT = [ STD NORMA PARAGON ]
#	  DOT2 = [ DOT multi2 host hw_foot ]
#	  DOT3 = [ DOT multi3 host hw_foot ]
#
#	  MCMSG = [ STD DIPC PARAGON mcmsg nx puma urdma ]
#	  MCMSG_LITE = [ STD_LITE DIPC PARAGON_LITE mcmsg nx debug ufs_pager ]
#
#	  SMP = [ MCMSG multi3 host hw_foot ]
#	  ASMP = [ MCMSG multi3 host hw_foot asmp ]
#
#	  iPSC 	= [ ipsc usm dcm pgi oldfpe ]
#	  OSF860 = [ STD NORMA ipsc usm pgi mcmsg assert oldfpe ]
#
#	#####################################################################
#

conftype	"i860"		# <paragon,ipsc>

platform	"PARAGON860"	# <paragon>
platform	"iPSC860"	# <ipsc>

options		"PARAGON860"	# <paragon>
options		"iPSC860"	# <ipsc>

options		"i860XP"	# <paragon>
options		NOCACHE		# <nocache>
options		DB_MACHINE_COMMANDS	# <paragon,ipsc>
options		"MCMSG"		# <mcmsg>
options		"NX"		# <nx>
options		"PUMA"		# <puma>
options		"URDMA"		# <urdma>
options		"VC"		# <vc>
options		"REG"		# <reg>
options		"VCF"		# <vcf>
options		"MSGTRACE"	# <msgtrace>
options		"BUMPERS"	# <!nicb>
options		"BIGPKTS"	# <nicb,bigpkts>
options		"MCMSG_ENG"	# <mcmsg_eng>

options 	MACH_LOAD	# 

options		OLDFPE		# <oldfpe>
options		NEWFPE		# <newfpe>
options		CTRAP_HISTORY	# <assert>
options		TIME_TRACE	# <time_trace>
options		ASMP		# <asmp>
options		CONSOLE_LOGGING	# <console_logging>

config		mach_kernel	swap generic

#
# Generic devices
#
pseudo-device	bm		0	# <paragon>
pseudo-device	constty		1	# <paragon>

#
# Generic compiler settings
#
makevariables	VOLATILE=				# <pgi,gcc>
makevariables	CDEBUGFLAGS=				# <assert>

#
# Compiler settings for PGI
#
options		PGI					# <pgi>
makevariables	"KCC"="cc860"				# <pgi>
makevariables	"LIBS"="-lic"				# <pgi>

#
# Compiler settings for GCC
#
# Due to a botch in compiling libgcc.a, we still need -lic
# to resolve ___mth_i_imod() and ___mth_i_uimod() from PGI's
# runtime library.  Additionally, .div(), .udiv(), and abort()
# are needed to resolve all external references.
#
options		GCC					# <gcc>
makevariables	"KCC"="gcc860"				# <gcc>
makevariables	"LIBS"="-lgcc -lic"			# <gcc>

#
# Compiler settings for Greenhills
#
makevariables	KCC="cc860"	# <greenh>

#
# Base kernel text address
#
#	(if ld860 were a *real* linker, the START_DATA
#	 nonsense wouldn't be needed)
#
makevariables	"START_TEXT"="0xF0080000"	# <paragon>
makevariables	"START_DATA"="0xF0161000"	# <paragon>
makevariables	"START_TEXT"="0xF8000000"	# <ipsc>
makevariables	"START_DATA"="0xF80C8000"	# <ipsc>

#
#  Devices common to a Paragon w/ MIO or w/ SCSI-16 Daughter Boards
#
#	scsi needs to be 2 for both channels on the SCSI-16 daughter board
#
pseudo-device	scsi	2	# <paragon_mio,sdb>

#
#  Devices for a Paragon w/ MIO
#
pseudo-device	mio	1	# <paragon_mio,paragon_mio_lite>
device		com0		# <paragon_mio,paragon_mio_lite>
device		mioe0		# <paragon_mio>
device		asc0		# <paragon_mio>
device		md0		# <md>
device		rpm0		# <paragon>

#
#  Devices for a Paragon w/ SCSI-16 Daughter Board
#
pseudo-device	sdb	1	# <sdb,sdb_lite>
device		sdbs0		# <sdb,sdb_lite>
device		sdbe0		# <sdb>
device		siop0		# <sdb>
device		siop1		# <sdb>

#
#  Devices for a Paragon w/ HIPPI
#
device          hippi0          # <hippi>
device          hdc0            # <hippi>
pseudo-device   ipi     1       # <hippi>

#
#  Devices for an iPSC/860
#
device		usm0		# <ipsc>
device		dcm0		# <dcm>

