###############################################################################
#BEGIN	Machine dependent Makefile fragment for the i860
###############################################################################

# This is now set in the toplevel Makeconf.
#KCPP=	/lib/cpp -E -MD -Di860 -Ui386 -U__i386__

AS=	as860
AR=	ar860
LD=	ld860
SIZE=	size860
RANLIB=	ranlib860

#
# device drivers do NOT get optimized
#
C_RULE_1A_D=${KCC} -c $(CLINENO) $(CMACHFLAGS) $(COPTS)

# the line below is from the old Greenhills support.
#RUNTIME=/usr/i860/lib/i860rt.o /usr/i860/lib/ieee_div.o
LDFLAGS= -e pstart -Mx -T ${START_TEXT} -P 0x1000 -p >ld.map

# We pick up libic from the value of LIBS now, so we don't need this.
#LDOBJS_SUFFIX=${RUNTIME}

LDOBJS=${LDOBJS_PREFIX} ${OBJS} ${LDOBJS_SUFFIX} ${LIBMIG_OBJS} dummy.o

dummy.o: dummy.c libmig.a
	$(KCC) -c dummy.c

dummy.c:
	echo "static dummy() {}" >dummy.c

SYS_RULE_2=-@
SYS_RULE_3=-@
SYS_RULE_4=-@
MD=md

#LIBS_P=-lc_p
#LIBS=-lic

LDOBJS_PREFIX= ${ORDERED} locore.o
LOCORE_DEPS=	assym.s $(SOURCE_DIR)/machine/start.s
LOCORE_HEADS=

locore.s: ${LOCORE_DEPS}
	cat ${LOCORE_DEPS} >locore.tmp
	mv locore.tmp locore.s
	@echo The hack below should get fixed sometime.
	cp /dev/null ioconf.c

locore.o: assym.s locore.s ${LOCORE_HEADS}
	${S_RULE_1A} -DLOCORE -I../machine ${S_RULE_1B}; \
	${S_RULE_2}; \
	${S_RULE_3}

mach/mcmsg_info_server.c: $(MIGDEPS) \
	$(SOURCE_DIR)/i860paragon/mcmsg/mcmsg_info.defs
	-$(MAKE_MACH)
	$(MIG) -MD $(MIGKSFLAGS) \
	-header mach/mcmsg_info.h \
	-server mach/mcmsg_info_server.c \
	-user /dev/null \
	$(SOURCE_DIR)/i860paragon/mcmsg/mcmsg_info.defs

###############################################################################
#END	Machine dependent Makefile fragment for the i860
###############################################################################
