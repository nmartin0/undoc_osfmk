######################################################################
#BEGIN	Machine dependent Makefile fragment for the Omron Luna 88k
######################################################################

VOLATILE = 
CC=	gcc -traditional -Dvolatile=__volatile__ -I.. -DBYTE_MSF=1 
CPP=	${CC} -E
AS=	as
LD=	ld

LDFLAGS=-N -e start -T 20000 -X

LIBS_P=
LIBS=-lc

LDOBJS_PREFIX=locore.o eh.o locore_asm_routines.o locore_c_routines.o luna_fp.o

#LDOBJS_PREFIX=locore.o eh.o locore_asm_routines.o locore_c_routines.o debug_msg.o vsnprintf.o luna_fp.o

LDOBJS_SUFFIX=
LDDEPS_PREFIX=
SWAPDEPS_PREFIX=
OBJSDEPS=

LOCORE88K=$(SOURCE_DIR)/luna88k/locore

$(LOCORE88K)/locore.h: assym.s

locore.o: $(LOCORE88K)/locore.c $(LOCORE88K)/locore.h
	$(CC) $(COPTS) -DNEWLINE='&' -E $(LOCORE88K)/locore.c \
		| tr '&' '\012' > locore.s
	$(CC) $(COPTS) -c locore.s
	/bin/rm -f locore.s

locore_asm_routines.o: $(LOCORE88K)/locore_asm_routines.c $(LOCORE88K)/locore.h
	$(CC) $(COPTS) -DNEWLINE='&' -E $(LOCORE88K)/locore_asm_routines.c \
		| tr '&' '\012' > locore_asm_routines.s
	$(CC) $(COPTS) -c locore_asm_routines.s
	/bin/rm -f locore_asm_routines.s

eh.o: $(LOCORE88K)/eh.c $(LOCORE88K)/locore.h
	$(CC) $(COPTS) -DNEWLINE='&' -E $(LOCORE88K)/eh.c \
		| tr '&' '\012' > eh.s
	$(CC) $(COPTS) -c eh.s
	/bin/rm -f eh.s

luna_fp.o: $(SOURCE_DIR)/luna88k/luna_fp.c
	$(CC) $(COPTS) -E $(SOURCE_DIR)/luna88k/luna_fp.c > luna_fp.s
	$(CC) $(COPTS) -c luna_fp.s
	/bin/rm -f luna_fp.s

locore_c_routines.o: $(LOCORE88K)/locore_c_routines.c $(LOCORE88K)/locore.h
	${CC} -O2 -c ${COPTS} $(LOCORE88K)/locore_c_routines.c

######################################################################
#END	Machine dependent Makefile fragment for the LUNA-88K
######################################################################

