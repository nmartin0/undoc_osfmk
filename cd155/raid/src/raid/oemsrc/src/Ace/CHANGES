1830 #ifdef PARAGON860
1831 	rel = 299;
1832 #else
1833 
1834 	/* determine the release number */
1835 	for (i = 0; i < 256; i++)
1836 		rbuf[i] = 0x00;   /* initialize the buffer */
1837 
1838 	if ((fd = open ("/etc/.relid", O_RDONLY)) == -1) {
1839 		ace_error(NON_SPECIFIC_ERROR, BAD_RELID_OPEN);	/* could not read  */
1840 		          				  	/* the .relid file */
1841 	}		
1842 	read (fd, rbuf, 128);
1843 
1844 	ucp = (char *) strtok (rbuf, " ");		/* tokenize the buffer*/
1845 	while (ucp != NULL) {				/* search for RELEASE */
1846 		if (strncmp (ucp, "RELEASE", 7) == 0)
1847 			break;
1848 		ucp = (char *) strtok (NULL, " ");
1849 	}	
1850 	
1851 	ucp = (char *) strtok (NULL, " ");		/* hopefully the next */
1852 	rel = (( ucp[0] - 0x30) * 1000 ) +		/* token will be the  */
1853 	      (( ucp[1] - 0x30) * 100 ) +		/* number we want */
1854 	      (( ucp[2] - 0x30) * 10 ) +
1855 	      (( ucp[3] - 0x30 ));
1856 
1857 	close ( fd );
1858 
1859 	if ((rel <= 100) || (rel >= 300)) {
1860 		NULL;					    /*uh-oh we didn't */
1861 		ace_error(NON_SPECIFIC_ERROR, BAD_OS_REV_LEVEL);/*get back rel 1  */
1862 		         			            /*or rel 2        */
1863 	}
1864 #endif
