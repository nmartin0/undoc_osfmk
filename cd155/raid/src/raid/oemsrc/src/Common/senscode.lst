# senscode.lst - File which contains Additional Sense Code (ASC),
#		 Additional Sense Code Qualifier (ASCQ), "most probable
#		 sense key" (MPSK), and description information from the
#		 ADP-92 Small Disk Array Software functional specification.
#
#		This file is parsed by the senscode.sh script (which uses
#		the senscode.awk program) to produce C source code lines
#		which can be incorporated into the 'stat_tbl.c' file.
#
#	NOTE: The really important messages for the Disk Array Utilities
#	are those with ASC code = 3F and with ASCQ codes in the range
#	80-FF (the vendor unique range).  These are the codes that the
#	disk array controller returns for AEN request sense.  Since the
#	array monitor daemon (amd) is the only program which regularly
#	performs AEN request sense, these messages are the ones that will
#	appear on the V.4 system console (and in the amd log file).
#
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=
#
#	Here is the format of the valid lines in this file (those not
#	beginning with a '# '):
#
# ASC ASCQ MPSK   Description
# --- ---- ------ -------------------------------------------------------------
# xx  xx   x,x,x  DESCRIPTION
# handler_function_name
#	<open line>
#
#  DO NOT CHANGE THE FOLLOWING LINE (it begins with "#-- ", a magic token)
#-- ---- -----	---------------------------------------------------------------
00  00   0	NO ADDITIONAL SENSE INFORMATION
print_FRU

00  06   0	I/O PROCESS TERMINATED
print_FRU

01  00   1,4	NO INDEX/SECTOR SIGNAL
print_FRU

02  00   1,4	NO SEEK COMPLETE
print_FRU

03  00   1,4	PERIPHERAL DEVICE WRITE FAULT
print_FRU

04  00   1,2	LOGICAL UNIT NOT READY, CAUSE NOT REPORTABLE
print_FRU

04  01   1,2	LOGICAL UNIT IS IN PROCESS OF BECOMING READY
print_FRU

04  02   1,2	LOGICAL UNIT NOT READY, INITIALIZING COMMAND REQUIRED
		Start unit command required
print_FRU

04  03   1,2	LOGICAL UNIT NOT READY, MANUAL INTERVENTION REQUIRED
print_FRU

04  04   1,2	LOGICAL UNIT NOT READY, FORMAT IN PROGRESS
print_FRU

04  80   2	LOGICAL UNIT NOT READY, ROM INSTALLED DOES NOT SUPPORT
		REDUNDANT CONTROLLER CONFIGURATION
print_FRU

05  00   1,2	LOGICAL UNIT DOES NOT RESPOND TO SELECTION
print_FRU

06  00   1,3,4	NO REFERENCE POSITION FOUND
print_FRU

07  00   1,4	MULTIPLE PERIPHERAL DEVICES SELECTED
print_FRU

08  00   1,4	LOGICAL UNIT COMMUNICATION FAILURE
print_FRU

08  01   1,4	LOGICAL UNIT COMMUNICATION TIME-OUT
print_FRU

08  02   1,4	LOGICAL UNIT COMMUNICATION PARITY ERROR
print_FRU

09  00   1,4	TRACK FOLLOWING ERROR
print_FRU

0A  00   1,6	ERROR LOG OVERFLOW
print_FRU

0C  01   1	WRITE ERROR RECOVERED WITH AUTO REALLOCATION
print_FRU

0C  02   1,3,4	WRITE ERROR - AUTO REALLOCATION FAILED
print_FRU

10  00   1,3,4	ID CRC OR ECC ERROR
print_FRU

11  00   1,3,4	UNRECOVERED READ ERROR
		The description of this error as being unrecovered may be
		misleading since a drive reported unrecovered read error
		can be recovered by the array using parity.  The sense key
		for this case will be RECOVERED and the recovery actions
		field in the sense will indicate that parity was used.
print_FRU

11  01   1,3,4	READ RETRIES EXHAUSTED
print_FRU

11  02   1,3,4	ERROR TOO LONG TO CORRECT
print_FRU

11  04   1,3,4	UNRECOVERED READ ERROR - AUTO REALLOCATE FAILED
print_FRU

11  0A   1,4	MISCORRECTED ERROR
print_FRU

11  0B   1,3	UNRECOVERED READ ERROR - RECOMMEND REASSIGNMENT
print_FRU

11  0C   1,3	UNRECOVERED READ ERROR - RECOMMEND REWRITE THE DATA
print_FRU

