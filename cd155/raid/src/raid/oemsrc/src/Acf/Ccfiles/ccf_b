#
# Description:	This script sets up the following DAC parameters:
#
##	Read Retry Count				    1
##	Write Retry Count				    1
##	Automatic Write Reallocation			   on		
##	Automatic Read Reallocation			   on
##	Recovered Error Reporting			   on
##	Logical Block Size				 2048
##	RAID Level					    3
##	Segment Size					    1
##	Segment Zero Size				    0
##	Auto Drive Reconstruct				  off
##	Writable in Degraded Mode			  off
##	Array Assurance Diagnostics			  off
##	Reconstruction Frequency			    1
##	Reconstruction Amount				  256		
#
# ******************************************************************************
# ***				  PROCEDURES				    ***
# ******************************************************************************
#
acf -u -z$1 -Ux >/dev/null 2>&1
acf -u -z$1 -b2048 -db1p0,b2p0,b3p0,b4p0,b5p0 -r3 -S1 -Z0 -F1 -a256
status=$?
if [ $status != 0 ]; then 
	exit $status
fi
acf -e -z$1 -r1 -w1
status=$?
if [ $status != 0 ]; then 
	exit $status
fi
acf -f -z$1
exit $status
