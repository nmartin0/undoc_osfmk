#CC		= /bin/cc
CC		= icc -I../../../../include -I../../include \
			-I../../../include -DPARAGON860 -DASCII 
			# -DDEBUG_ON
AR		= ar860
LD		= ld860
CFLAGS =
#DEFS		= -DNO_IO -DIO_TEST -DRDAC_TESTWARE

ACF		= acf
# (name of acf program is system-dependent)

SWITCHES	= -g
LIBRARIES	= ../../lib/Uv4/libio.a

COMPILE.c= $(CC) $(CFLAGS) $(CPPFLAGS)  -c
.c.o:
	$(COMPILE.c)  $<


